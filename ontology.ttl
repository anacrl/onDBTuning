#################################################################
#    Classes
#################################################################

###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao
:Acao rdf:type owl:Class ;
      rdfs:subClassOf :OntologiaTarefa .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#AccessStructure
:AccessStructure rdf:type owl:Class ;
                 rdfs:subClassOf :AtomicObject ;
                 owl:disjointUnionOf ( :HypotheticalAccessStructure
                                       :RealAccessStructure
                                     ) .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Algorithm
:Algorithm rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#AtomicExpression
:AtomicExpression rdf:type owl:Class ;
                  rdfs:subClassOf :Predicate .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#AtomicObject
:AtomicObject rdf:type owl:Class ;
              rdfs:subClassOf :DBObject .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#AtomicStatement
:AtomicStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#BPlusTreeSpecification
:BPlusTreeSpecification rdf:type owl:Class ;
                        rdfs:subClassOf :DataStructureSpecification .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#BitmapSpecification
:BitmapSpecification rdf:type owl:Class ;
                     rdfs:subClassOf :DataStructureSpecification .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#BufferArea
:BufferArea rdf:type owl:Class ;
            rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                            :AtomicObject .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Clause
:Clause rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Column
:Column rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                        :AtomicObject ,
                        :ExpressionObject .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#ColumnScopeClause
:ColumnScopeClause rdf:type owl:Class ;
                   rdfs:subClassOf :Clause .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#ComparisonOperator
:ComparisonOperator rdf:type owl:Class ;
                    rdfs:subClassOf :ExpressionObject ,
                                    :Token .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CompositeExpression
:CompositeExpression rdf:type owl:Class ;
                     rdfs:subClassOf :Predicate .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CompositeObject
:CompositeObject rdf:type owl:Class ;
                 rdfs:subClassOf :DBObject .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CompositeStatement
:CompositeStatement rdf:type owl:Class ;
                    rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#ComputationalAgent
:ComputationalAgent rdf:type owl:Class ;
                    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Conceito
:Conceito rdf:type owl:Class ;
          rdfs:subClassOf :OntologiaTarefa .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CreateHypotheticalIndexStatement
:CreateHypotheticalIndexStatement rdf:type owl:Class ;
                                  rdfs:subClassOf :TuningAssistStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CreateHypotheticalMaterializedViewStatement
:CreateHypotheticalMaterializedViewStatement rdf:type owl:Class ;
                                             rdfs:subClassOf :TuningAssistStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CreateIndexStatement
:CreateIndexStatement rdf:type owl:Class ;
                      rdfs:subClassOf :CreateStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CreateMaterializedViewStatement
:CreateMaterializedViewStatement rdf:type owl:Class ;
                                 rdfs:subClassOf :CreateStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#CreateStatement
:CreateStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DDLStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DBClientApplication
:DBClientApplication rdf:type owl:Class ;
                     rdfs:subClassOf :ComputationalAgent ,
                                     :DatabaseUser .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DBMS
:DBMS rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DBMSSpecificClause
:DBMSSpecificClause rdf:type owl:Class ;
                    rdfs:subClassOf :Clause .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DBObject
:DBObject rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ;
          owl:disjointUnionOf ( :AtomicObject
                                :CompositeObject
                              ) .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DBObjectSpecification
:DBObjectSpecification rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DDLStatement
:DDLStatement rdf:type owl:Class ;
              rdfs:subClassOf :SQLStatement ;
              owl:disjointWith :DMLStatement ,
                               :TuningAssistStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DDLStatementExecution
:DDLStatementExecution rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatement
:DMLStatement rdf:type owl:Class ;
              rdfs:subClassOf :SQLStatement ;
              owl:disjointUnionOf ( :AtomicStatement
                                    :CompositeStatement
                                  ) .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementExecution
:DMLStatementExecution rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementExecutionPlan
:DMLStatementExecutionPlan rdf:type owl:Class ;
                           rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementSubmission
:DMLStatementSubmission rdf:type owl:Class ;
                        rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DataStructure
:DataStructure rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DataStructureSpecification
:DataStructureSpecification rdf:type owl:Class ;
                            rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Database
:Database rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DatabaseUser
:DatabaseUser rdf:type owl:Class ;
              rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DeleteFromClause
:DeleteFromClause rdf:type owl:Class ;
                  rdfs:subClassOf :TableScopeClause .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#DeleteStatement
:DeleteStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Disk
:Disk rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                      :CompositeObject .


