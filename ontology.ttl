@prefix : <http://www.owl-ontologies.com/onDBTuning.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.owl-ontologies.com/onDBTuning.owl#> .

<http://www.owl-ontologies.com/onDBTuning.owl> rdf:type owl:Ontology ;
                                                owl:versionIRI <http://www.owl-ontologies.com/onDBTuning.owl/1.0> ;
                                                owl:imports <http://purl.org/nemo/gufo#> ;
                                                <http://purl.org/dc/terms/creator> "Ana Carolina Almeida" ,
                                                                                   "Daniel Schwabe" ,
                                                                                   "Fernanda Baião" ,
                                                                                   "Maria Luiza Machado Campos" ,
                                                                                   "Sérgio Lifschitz" ;
                                                <http://purl.org/dc/terms/description> "Ontology for automatic database tuning: workload, DBMS metadata, access structures (indexes and materialized views), tuning heuristics and their SHACL rules."@en ;
                                                <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                <http://purl.org/dc/terms/modified> "2026-10-25"^^xsd:date ;
                                                <http://purl.org/dc/terms/title> "onDBTuning Ontology"@en ;
                                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "ot" ;
                                                <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.owl-ontologies.com/onDBTuning.owl#" ;
                                                rdfs:label "onDBTuning Ontology"@en ;
                                                owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.owl-ontologies.com/onDBTuning.owl#accesses
:accesses rdf:type owl:ObjectProperty ;
          rdfs:domain :DMLStatementExecutionPlanWithAccessStructure ;
          rdfs:range :UsedAccessStructure ;
          rdfs:label "access"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#allocates
:allocates rdf:type owl:ObjectProperty ;
           rdfs:domain :DataStructure ;
           rdfs:range :StorageArea ;
           rdfs:label "allocates"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#becomes
:becomes rdf:type owl:ObjectProperty ;
         rdfs:domain :HypotheticalIndex ;
         rdfs:range :Index ;
         rdfs:label "becomes"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#benefits
:benefits rdf:type owl:ObjectProperty ;
          rdfs:domain :AccessStructure ;
          rdfs:range :Workload ;
          rdfs:label "benefits"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#concernsAccessStructure
:concernsAccessStructure rdf:type owl:ObjectProperty ;
                         rdfs:domain :Action ;
                         rdfs:range :AccessStructure ;
                         rdfs:comment "Access structure created, rebuilt or dropped by the action."@en ;
                         rdfs:label "concerns access structure"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#considers
:considers rdf:type owl:ObjectProperty ;
           rdfs:domain :HypotheticalDMLStatementExecutionPlan ;
           rdfs:range :AccessStructure ;
           rdfs:label "considers"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#creates
:creates rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :CreateHypotheticalIndexStatement
                                     :CreateHypotheticalMaterializedViewStatement
                                     :CreateStatement
                                   )
                     ] ;
         rdfs:range :AccessStructure ;
         rdfs:label "creates"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#defines
:defines rdf:type owl:ObjectProperty ;
         rdfs:domain :DataStructureSpecification ;
         rdfs:range :DataStructure ;
         rdfs:label "defines"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#definesClause
:definesClause rdf:type owl:ObjectProperty ;
               rdfs:domain :DBMSSpecificClause ;
               rdfs:range :Clause ;
               rdfs:label "defines (clause)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#definesRule
:definesRule rdf:type owl:ObjectProperty ;
             rdfs:domain :Heuristic ;
             rdfs:range :Rule ;
             rdfs:comment "Rules that are switched on and off together with the heuristic."@en ;
             rdfs:label "defines rule"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#dependsOn
:dependsOn rdf:type owl:ObjectProperty ;
           rdfs:domain :OperationSpecification ;
           rdfs:range :OperationSpecification ;
           rdfs:label "depends on"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#derives
:derives rdf:type owl:ObjectProperty ;
         rdfs:domain :HypotheticalMaterializedView ;
         rdfs:range :MaterializedView ;
         rdfs:label "derives"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:domain :MaterializedViewSpecification ;
           rdfs:range :MaterializedView ;
           rdfs:label "describes"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#determines
:determines rdf:type owl:ObjectProperty ;
            rdfs:domain :IndexSpecification ;
            rdfs:range :DataStructureSpecification ;
            rdfs:label "determines"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#executes
:executes rdf:type owl:ObjectProperty ;
          rdfs:domain :DBMS ;
          rdfs:range :SQLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#executesOverDatabase
:executesOverDatabase rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain :DMLStatementExecution ;
                      rdfs:range :Database ;
                      rdfs:label "executes over a"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#formulates
:formulates rdf:type owl:ObjectProperty ;
            rdfs:domain :RewrittenQueryStatement ;
            rdfs:range :MaterializedViewSpecification ;
            rdfs:label "formulates"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#fragments
:fragments rdf:type owl:ObjectProperty ;
           rdfs:domain :DMLStatement ;
           rdfs:range :View ;
           rdfs:label "fragments"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#generatesAction
:generatesAction rdf:type owl:ObjectProperty ;
                 rdfs:domain :Rule ;
                 rdfs:range :Action ;
                 rdfs:label "generates action"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasClause
:hasClause rdf:type owl:ObjectProperty ;
           owl:inverseOf :isClauseOf ;
           rdfs:label "has clause"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse
:hasColumnUse rdf:type owl:ObjectProperty ;
              rdfs:domain :DMLStatement ;
              rdfs:range :Column ;
              rdfs:comment "A column that the query block uses in a way that matters for index selection (Lohman et al., in Salles 2002)."@en ;
              rdfs:label "has column use"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasComparisonOperator
:hasComparisonOperator rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasExpressionObject ,
                                          :hasToken ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain :AtomicExpression ;
                       rdfs:range :ComparisonOperator ;
                       rdfs:label "has comparison operator"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasComponentStatement
:hasComponentStatement rdf:type owl:ObjectProperty ;
                       owl:inverseOf :isComponentStatementOf ;
                       rdfs:label "has component statement"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasConditionalExpression
:hasConditionalExpression rdf:type owl:ObjectProperty ;
                          rdfs:domain :PartialIndex ;
                          rdfs:range :WhereClause ;
                          rdfs:label "has a conditional expression"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasEqualityColumn
:hasEqualityColumn rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasColumnUse ;
                   rdfs:domain :DMLStatement ;
                   rdfs:range :Column ;
                   rdfs:comment "Group EQ: column in an equality predicate with a value (column = value)."@en ;
                   rdfs:label "has equality column (EQ)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasExpressionObject
:hasExpressionObject rdf:type owl:ObjectProperty ;
                     rdfs:domain :AtomicExpression ;
                     rdfs:range :ExpressionObject ;
                     rdfs:comment "Ordered composition of figure 4; the order is given by the subproperties."@en ;
                     rdfs:label "has expression object"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasForeignKey
:hasForeignKey rdf:type owl:ObjectProperty ;
               rdfs:domain :Table ;
               rdfs:range :Column ;
               rdfs:label "has foreign key"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasInputParameter
:hasInputParameter rdf:type owl:ObjectProperty ;
                   rdfs:domain :Function ;
                   rdfs:range :Parameter ;
                   rdfs:label "has input parameter"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasLeftOperand
:hasLeftOperand rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasExpressionObject ;
                rdf:type owl:FunctionalProperty ;
                rdfs:range :ExpressionObject ;
                rdfs:label "has left operand"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasLogicalConnector
:hasLogicalConnector rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasToken ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :CompositeExpression ;
                     rdfs:range :LogicalConnector ;
                     rdfs:label "has logical connector"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasOperationSpecification
:hasOperationSpecification rdf:type owl:ObjectProperty ;
                           owl:inverseOf :isOperationSpecificationOf ;
                           rdfs:label "has operation specification"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasOrderingColumn
:hasOrderingColumn rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasColumnUse ;
                   rdfs:domain :DMLStatement ;
                   rdfs:range :Column ;
                   rdfs:comment "Group O: column in ORDER BY, GROUP BY or in a join predicate (column = column of another table, or the same column in a self-join)."@en ;
                   rdfs:label "has ordering column (O)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasOutputParameter
:hasOutputParameter rdf:type owl:ObjectProperty ;
                    rdfs:domain :Function ;
                    rdfs:range :Parameter ;
                    rdfs:label "has output parameter"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasPrecondition
:hasPrecondition rdf:type owl:ObjectProperty ;
                 rdfs:domain :Heuristic ;
                 rdfs:range :Concept ;
                 rdfs:label "has precondition"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasPrimaryKey
:hasPrimaryKey rdf:type owl:ObjectProperty ;
               rdfs:domain :Table ;
               rdfs:range :Column ;
               rdfs:label "has primary key"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasRangeColumn
:hasRangeColumn rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasColumnUse ;
                rdfs:domain :DMLStatement ;
                rdfs:range :Column ;
                rdfs:comment "Group RANGE: column in a range restriction (between, <, <=, >, >=)."@en ;
                rdfs:label "has range column (RANGE)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasReferencedColumn
:hasReferencedColumn rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasColumnUse ;
                     rdfs:domain :DMLStatement ;
                     rdfs:range :Column ;
                     rdfs:comment "Group REF: any other column referenced by the query block (SELECT, WHERE, HAVING, GROUP BY, ORDER BY)."@en ;
                     rdfs:label "has referenced column (REF)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasResponsible
:hasResponsible rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain :DMLStatementSubmission ;
                rdfs:range :DatabaseUser ;
                rdfs:label "responsible"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperand
:hasRightOperand rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasExpressionObject ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:range :ExpressionObject ;
                 rdfs:label "has right operand"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasSargableColumn
:hasSargableColumn rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasColumnUse ;
                   rdfs:domain :DMLStatement ;
                   rdfs:range :Column ;
                   rdfs:comment "Group SARG: column in another indexable (sargable) predicate: like, in."@en ;
                   rdfs:label "has sargable column (SARG)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTableMember
:hasTableMember rdf:type owl:ObjectProperty ;
                rdfs:domain :TableSubset ;
                rdfs:range :Table ;
                rdfs:label "has table member"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubset
:hasTableSubset rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :DMLStatement ;
                rdfs:range :TableSubset ;
                rdfs:comment "The set of tables of the FROM clause of a query (or subquery)."@en ;
                rdfs:label "has table subset"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasToken
:hasToken rdf:type owl:ObjectProperty ;
          rdfs:domain :Predicate ;
          rdfs:range :Token ;
          rdfs:label "has token"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#impacts
:impacts rdf:type owl:ObjectProperty ;
         rdfs:domain :DMLStatementExecution ;
         rdfs:range :IndexSpecification ;
         rdfs:label "impacts"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#indexes
:indexes rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Index
                                     :IndexSpecification
                                   )
                     ] ;
         rdfs:range :Column ;
         rdfs:comment "In the figure, Index indexes Column. Extended to Index Specification so that hypothetical indexes can point to their columns."@en ;
         rdfs:label "indexes"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#indexesTable
:indexesTable rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Index
                                          :IndexSpecification
                                        )
                          ] ;
              rdfs:range :Table ;
              rdfs:comment "Table of the index (not in the figures)."@en ;
              rdfs:label "indexes table"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#involvesDMLStatement
:involvesDMLStatement rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain :DMLStatementExecutionPlan ;
                      rdfs:range :DMLStatement ;
                      rdfs:label "participates in (DML statement)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#involvesOptimizer
:involvesOptimizer rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain :DMLStatementExecutionPlan ;
                   rdfs:range :Optimizer ;
                   rdfs:label "participates in (optimizer)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isAdministeredBy
:isAdministeredBy rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :DDLStatementExecution
                                              :DMLStatementExecution
                                            )
                              ] ;
                  rdfs:range :DBMS ;
                  rdfs:comment "«Mediation» administers."@en ;
                  rdfs:label "is administered by"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isAppliedOn
:isAppliedOn rdf:type owl:ObjectProperty ;
             rdfs:domain :DDLStatement ;
             rdfs:range :Table ;
             rdfs:label "is applied on"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isBenefitFromExecution
:isBenefitFromExecution rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :IndexBenefit
                                                    :MaterializedViewBenefit
                                                  )
                                    ] ;
                        rdfs:range :DMLStatementExecution ;
                        rdfs:comment "The execution (with its number, timestamp and plans) that produced this record."@en ;
                        rdfs:label "is benefit from execution"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isBenefitFromStatement
:isBenefitFromStatement rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :MaterializedViewBenefit ;
                        rdfs:range :DMLStatement ;
                        rdfs:comment "The query or subquery compatible with the view."@en ;
                        rdfs:label "is benefit from statement"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isBenefitOfIndex
:isBenefitOfIndex rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :IndexBenefit ;
                  rdfs:range :AccessStructure ;
                  rdfs:comment "Hypothetical or real index the record changes."@en ;
                  rdfs:label "is benefit of index"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isBenefitOfMaterializedView
:isBenefitOfMaterializedView rdf:type owl:ObjectProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :MaterializedViewBenefit ;
                             rdfs:range :HypotheticalMaterializedView ;
                             rdfs:label "is benefit of materialized view"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isBufferAreaOf
:isBufferAreaOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                rdfs:domain :BufferArea ;
                rdfs:range :Memory ;
                rdfs:label "is buffer area of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isClauseOf
:isClauseOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain :Clause ;
            rdfs:range :DMLStatement ;
            rdfs:label "is clause of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isCompatibleWithView
:isCompatibleWithView rdf:type owl:ObjectProperty ;
                      rdfs:domain :DMLStatement ;
                      rdfs:range :HypotheticalMaterializedView ;
                      rdfs:comment "The query can be answered by the view (Weberling, section 2.7): same tables, every column it uses and every aggregate it computes is in the view."@en ;
                      rdfs:label "is compatible with view"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isComponentObjectOf
:isComponentObjectOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                     rdfs:domain :DBObject ;
                     rdfs:range :CompositeObject ;
                     rdfs:label "is component object of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isComponentStatementOf
:isComponentStatementOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                        rdfs:domain :DMLStatement ;
                        rdfs:range :CompositeStatement ;
                        rdfs:comment "Subquery -> statement that contains it."@en ;
                        rdfs:label "is component statement of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isConstitutedOf
:isConstitutedOf rdf:type owl:ObjectProperty ;
                 rdfs:domain :Table ;
                 rdfs:range :Column ;
                 rdfs:label "constituted of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isCreatedBy
:isCreatedBy rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :AccessStructure ;
             rdfs:range :Heuristic ;
             rdfs:comment "Heuristic that created the access structure."@en ;
             rdfs:label "is created by"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isDBObjectOf
:isDBObjectOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
              rdfs:domain :DBObject ;
              rdfs:range :Database ;
              rdfs:label "is DB object of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isDerivedFromTable
:isDerivedFromTable rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :MaterializedViewSpecification
                                                :View
                                              )
                                ] ;
                    rdfs:range :Table ;
                    rdfs:comment "Tables a view, or the specification of a hypothetical materialized view, is computed from (not in the figures for the specification)."@en ;
                    rdfs:label "is derived from"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isDiskBlockAreaOf
:isDiskBlockAreaOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                   rdfs:domain :DiskBlockArea ;
                   rdfs:range :Disk ;
                   rdfs:label "is disk block area of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isExecutionOf
:isExecutionOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :DDLStatementExecution
                                           :DMLStatementExecution
                                         )
                           ] ;
               rdfs:range :SQLStatement ;
               rdfs:comment "«Mediation» executes."@en ;
               rdfs:label "is execution of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isImplementedBy
:isImplementedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :OperationSpecification ;
                 rdfs:range :AlgorithmSpecification ;
                 rdfs:label "implemented by"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isInstantiatedBy
:isInstantiatedBy rdf:type owl:ObjectProperty ;
                  rdfs:domain :Concept ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( :Function
                                             :Rule
                                           )
                             ] ;
                  rdfs:label "is instantiated by"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isMaterializationOf
:isMaterializationOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :IndexMaterialization ;
                     rdfs:range :Index ;
                     rdfs:label "is materialization of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isMaterializedIn
:isMaterializedIn rdf:type owl:ObjectProperty ;
                  rdfs:domain :MaterializedView ;
                  rdfs:range :Table ;
                  rdfs:label "is materialized in"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isOperandOf
:isOperandOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :Predicate ;
             rdfs:range :CompositeExpression ;
             rdfs:comment "Each Composite Expression has exactly two predicates as operands."@en ;
             rdfs:label "is operand of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isOperationSpecificationOf
:isOperationSpecificationOf rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                            rdfs:domain :OperationSpecification ;
                            rdfs:range :DMLStatementExecutionPlan ;
                            rdfs:label "is operation specification of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isOptimizerOf
:isOptimizerOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Optimizer ;
               rdfs:range :DBMS ;
               rdfs:label "is optimizer of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy
:isPerformedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Action ;
               rdfs:range :Function ;
               rdfs:label "is performed by"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isPredicateOf
:isPredicateOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Predicate ;
               rdfs:range :WhereClause ;
               rdfs:label "is predicate of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isStorageAreaComponentOf
:isStorageAreaComponentOf rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                          rdfs:domain :StorageAreaComponent ;
                          rdfs:range :StorageArea ;
                          rdfs:label "is storage area component of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isSubmissionOf
:isSubmissionOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain :DMLStatementSubmission ;
                rdfs:range :DMLStatement ;
                rdfs:label "participates to (submission)"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isWorkloadMemberOf
:isWorkloadMemberOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#isCollectionMemberOf> ;
                    rdfs:domain :DMLStatementExecution ;
                    rdfs:range :Workload ;
                    rdfs:label "is workload member of"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#manages
:manages rdf:type owl:ObjectProperty ;
         rdfs:domain :DBMS ;
         rdfs:range :Database ;
         rdfs:label "manages"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#originates
:originates rdf:type owl:ObjectProperty ;
            rdfs:domain :DMLStatement ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :IndexSpecification
                                       :RewrittenQueryStatement
                                     )
                       ] ;
            owl:propertyChainAxiom ( :hasComponentStatement
                                     :originates
                                   ) ;
            rdfs:comment "A composite statement also originates what its subqueries originate."@en ;
            rdfs:label "originates"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#originatesAccessStructure
:originatesAccessStructure rdf:type owl:ObjectProperty ;
                           rdfs:domain :DMLStatementExecution ;
                           rdfs:range :AccessStructure ;
                           rdfs:label "originates access structure"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#plans
:plans rdf:type owl:ObjectProperty ;
       rdfs:domain :Optimizer ;
       rdfs:range :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#producesPlan
:producesPlan rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :AccessStructure
                                          :DMLStatementExecution
                                        )
                          ] ;
              rdfs:range :DMLStatementExecutionPlan ;
              rdfs:comment "An execution produces its real plan (from the DBMS) and the hypothetical plan estimated with the hypothetical access structures."@en ;
              rdfs:label "produces plan"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#rebuilds
:rebuilds rdf:type owl:ObjectProperty ;
          rdfs:domain :ReindexStatement ;
          rdfs:range :Index ;
          rdfs:label "rebuilds"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#referencesColumn
:referencesColumn rdf:type owl:ObjectProperty ;
                  rdfs:domain :ColumnScopeClause ;
                  rdfs:range :ReferencedColumn ;
                  rdfs:label "references column"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#referencesNonAggregatedColumn
:referencesNonAggregatedColumn rdf:type owl:ObjectProperty ;
                               rdfs:domain :Clause ;
                               rdfs:range :Column ;
                               rdfs:comment "Column used by the SELECT clause outside aggregate functions (Rule_Column_GroupingReference)."@en ;
                               rdfs:label "references non-aggregated column"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#referencesTable
:referencesTable rdf:type owl:ObjectProperty ;
                 rdfs:domain :TableScopeClause ;
                 rdfs:range :ReferencedTable ;
                 rdfs:label "references table"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#regards
:regards rdf:type owl:ObjectProperty ;
         rdfs:domain :RealDMLStatementExecutionPlan ;
         rdfs:range :RealAccessStructure ;
         rdfs:label "regards"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#removes
:removes rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :DropHypotheticalIndexStatement
                                     :DropHypotheticalMaterializedViewStatement
                                     :DropStatement
                                   )
                     ] ;
         rdfs:range :AccessStructure ;
         rdfs:label "removes"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#results
:results rdf:type owl:ObjectProperty ;
         rdfs:domain :DDLStatementExecution ;
         rdfs:range :DBObjectSpecification ;
         rdfs:label "results"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#scans
:scans rdf:type owl:ObjectProperty ;
       rdfs:domain :FullTableScanSpecification ;
       rdfs:range :TableSpecification ;
       rdfs:label "scans"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#specifies
:specifies rdf:type owl:ObjectProperty ;
           rdfs:domain :DBObjectSpecification ;
           rdfs:range :DBObject ;
           rdfs:label "specifies"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#submits
:submits rdf:type owl:ObjectProperty ;
         rdfs:domain :DatabaseUser ;
         rdfs:range :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#submitsToExecution
:submitsToExecution rdf:type owl:ObjectProperty ;
                    rdfs:domain :DMLStatementSubmission ;
                    rdfs:range :DMLStatementExecution ;
                    rdfs:label "submits to execution"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#takes
:takes rdf:type owl:ObjectProperty ;
       rdfs:domain :FullIndexScanSpecification ;
       rdfs:range :SpecificationOfIndexToBeScanned ;
       rdfs:label "takes"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBenefit
:hasAccumulatedBenefit rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :AccessStructure ;
                       rdfs:range xsd:float ;
                       rdfs:comment "Accumulated benefit of a hypothetical index: sum of its records. After its real index is removed it starts again from -hasEstimatedCreationCost and counts only the executions after the removal (Morelli, section 3.3)."@en ;
                       rdfs:label "has accumulated benefit"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBonus
:hasAccumulatedBonus rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :AccessStructure ;
                     rdfs:range xsd:float ;
                     rdfs:comment "Accumulated benefit of a real index (Morelli, section 3.2): hasInitialAccumulatedBonus + the RealIndexBonus and IndexUpdateCost records of the executions after its creation (or after its last rebuild). Below -hasEstimatedCreationCost the index is removed (or rebuilt)."@en ;
                     rdfs:label "has accumulated bonus"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateColumnSize
:hasAggregateColumnSize rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :Heuristic ;
                        rdfs:range xsd:int ;
                        rdfs:comment "Bytes assumed for each aggregate column of a view (sum, avg, count...) in SizeRowVM."@en ;
                        rdfs:label "has aggregate column size"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateExpression
:hasAggregateExpression rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Clause ;
                        rdfs:range xsd:string ;
                        rdfs:comment "SQL text of an aggregate function call of a SELECT or HAVING clause (written by the parser, or by Rule_MV_DefineView for a view)."@en ;
                        rdfs:label "has aggregate expression"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasAlias
:hasAlias rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string ;
          rdfs:label "has alias"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasAuthor
:hasAuthor rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Heuristic ;
           rdfs:range xsd:string ;
           rdfs:label "has author"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasAvailableDiskPageCount
:hasAvailableDiskPageCount rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain :Heuristic ;
                           rdfs:range xsd:int ;
                           rdfs:comment "EDR (Oliveira, table 4.3): disk space left for tuning, in pages; a view is materialized only if its hypothetical pages (CE) are fewer (393216 pages of 8 KB in figure 4.11)."@en ;
                           rdfs:label "has available disk page count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasBenefit
:hasBenefit rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :IndexBenefit
                                        :MaterializedViewBenefit
                                      )
                        ] ;
            rdfs:range xsd:float ;
            rdfs:comment "Signed value of the record, added to the accumulated benefit or bonus of the index."@en ;
            rdfs:label "has benefit"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasBlockCount
:hasBlockCount rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :AccessStructure ;
               rdfs:range xsd:int ;
               rdfs:comment "Current number of pages of a real index, measured by the dispatcher in the DBMS (getsize, pgstatindex, pg_class.relpages)."@en ;
               rdfs:label "has block count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasBonus
:hasBonus rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:float ;
          rdfs:comment "On a real index (Morelli, section 3.2): accumulated benefit of the hypothetical index divided by the number of executions that used it, fixed when the real index is created. Added to the accumulated bonus each time a real plan uses the index."@en ;
          rdfs:label "has bonus"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasCPUCost
:hasCPUCost rdf:type owl:DatatypeProperty ;
            rdfs:domain :DBMS ;
            rdfs:range xsd:float ;
            rdfs:label "has CPU cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasClass
:hasClass rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Function ;
          rdfs:range xsd:string ;
          rdfs:comment "Java class of the dispatcher."@en ;
          rdfs:label "has class"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasClassification
:hasClassification rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Heuristic ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:oneOf [ rdf:type rdf:List ;
                                            rdf:first "Index Creation" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "Index Reindexing" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "Index Removal" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "Index Suggestion" ;
                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                        rdf:first "Materialized View Creation" ;
                                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                                   rdf:first "Materialized View Selection" ;
                                                                                                   rdf:rest rdf:nil
                                                                                                 ]
                                                                                      ]
                                                                           ]
                                                                ]
                                                     ]
                                          ]
                              ] ;
                   rdfs:label "has classification"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasColumnReference
:hasColumnReference rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Clause ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Column the clause mentions: table.column when the parser knows the table (the alias is replaced by the table name), column alone otherwise."@en ;
                    rdfs:label "has column reference"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasColumnType
:hasColumnType rdf:type owl:DatatypeProperty ;
               rdfs:domain :Column ;
               rdfs:range xsd:string ;
               rdfs:label "has column type"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasConcept
:hasConcept rdf:type owl:DatatypeProperty ;
            rdfs:domain :Parameter ;
            rdfs:range xsd:string ;
            rdfs:label "has concept"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasConnectorWord
:hasConnectorWord rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Predicate ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Logical connector of a composite expression, as text (and, or)."@en ;
                  rdfs:label "has connector word"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasCreationDate
:hasCreationDate rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :MaterializedView ;
                 rdfs:range xsd:string ;
                 rdfs:label "has creation date"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasDBADecision
:hasDBADecision rdf:type owl:DatatypeProperty ;
                rdfs:domain :Action ;
                rdfs:range xsd:boolean ;
                rdfs:label "has DBA decision"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasDatatype
:hasDatatype rdf:type owl:DatatypeProperty ;
             rdfs:domain :Parameter ;
             rdfs:range xsd:string ;
             rdfs:label "has datatype"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasDate
:hasDate rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Action
                                     :DMLStatementExecution
                                   )
                     ] ;
         rdfs:range xsd:date ;
         rdfs:comment "Date of a DML statement execution, or date on which the dispatcher executed an action."@en ;
         rdfs:label "has date"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasDefinition
:hasDefinition rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:label "has definition"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasDescription
:hasDescription rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:range xsd:string ;
                rdfs:comment "Description or SQL text."@en ;
                rdfs:label "has description"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasDomainConstraint
:hasDomainConstraint rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Column ;
                     rdfs:range xsd:string ;
                     rdfs:label "has domain constraint"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedCost
:hasEstimatedCost rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :DMLStatement ;
                  rdfs:range xsd:float ;
                  rdfs:comment "Cost estimated by the optimizer for a query or subquery without hypothetical structures (getExecutionCostQuery). Set by the dispatcher; for an executed statement the real plan of the execution is used instead."@en ;
                  rdfs:label "has estimated cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedCreationCost
:hasEstimatedCreationCost rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :AccessStructure ;
                          rdfs:range xsd:float ;
                          rdfs:comment "CCI = 2P + c R log2 R (Salles, 2002, section 4.5.1): read the P pages of the table and write the same number of index pages, plus sorting the R tuples. In plan cost units (one page I/O = 1). Copied to the real index when it is created; -CCI is its elimination threshold."@en ;
                          rdfs:label "has estimated creation cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedScanCost
:hasEstimatedScanCost rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :HypotheticalMaterializedView ;
                      rdfs:range xsd:float ;
                      rdfs:comment "HyCost (Weberling, section 3.1.2, after Hose et al.): cost of a full scan of the view = HyRowVM x SizeRowVM x fill factor / page size."@en ;
                      rdfs:label "has estimated scan cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedUpdateCost
:hasEstimatedUpdateCost rdf:type owl:DatatypeProperty ;
                        rdfs:domain :AccessStructure ;
                        rdfs:range xsd:float ;
                        rdfs:label "has estimated update cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasExecutionNumber
:hasExecutionNumber rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :DMLStatementExecution ;
                    rdfs:range xsd:int ;
                    rdfs:label "has execution number"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasExecutionProbability
:hasExecutionProbability rdf:type owl:DatatypeProperty ;
                         rdfs:domain :DMLStatement ;
                         rdfs:range xsd:float ;
                         rdfs:label "has execution probability"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasExpectedPageReadCount
:hasExpectedPageReadCount rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :HypotheticalMaterializedView ;
                          rdfs:range xsd:float ;
                          rdfs:comment "QPL used by the expectation heuristic: the pages read by that execution (hasPageReadCount), or the hypothetical pages of the view when the plan does not have them, as in the SWRL rule of Oliveira (figure 4.11)."@en ;
                          rdfs:label "has expected page read count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasExpectedQueryCost
:hasExpectedQueryCost rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :HypotheticalMaterializedView ;
                      rdfs:range xsd:float ;
                      rdfs:comment "CRC (Oliveira, table 4.3): real execution cost of the query the view was defined from, in its most recent execution."@en ;
                      rdfs:label "has expected query cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasFillFactor
:hasFillFactor rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:float ;
               rdfs:label "has fill factor"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasFragmentationDegree
:hasFragmentationDegree rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :AccessStructure ;
                        rdfs:range xsd:float ;
                        rdfs:comment "GrF in Morelli, figure 4.4: 100 - (Ra / Ri) x 100, Ra = table tuples / index blocks now, Ri = hasInitialRatio."@en ;
                        rdfs:label "has fragmentation degree"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasGroupingColumnReference
:hasGroupingColumnReference rdf:type owl:DatatypeProperty ;
                            rdfs:domain :Clause ;
                            rdfs:range xsd:string ;
                            rdfs:comment "Column the SELECT clause uses outside aggregate functions (written by the parser)."@en ;
                            rdfs:label "has grouping column reference"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasHypotheticalIndexName
:hasHypotheticalIndexName rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :hasName ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain :HypotheticalIndex ;
                          rdfs:range xsd:string ;
                          rdfs:label "has hypothetical index name"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasHypotheticalPageCount
:hasHypotheticalPageCount rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :HypotheticalMaterializedView ;
                          rdfs:range xsd:int ;
                          rdfs:comment "HyPgVM (Weberling, section 3.1.2): HyRowVM x SizeRowVM / page size, rounded up."@en ;
                          rdfs:label "has hypothetical page count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasIOCPUCostCoefficient
:hasIOCPUCostCoefficient rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :DBMS ;
                         rdfs:range xsd:float ;
                         rdfs:comment "c in Salles (2002), section 4.5.1: cost of processing one tuple in memory relative to the cost of one page I/O (PostgreSQL: 1%, i.e. 0.01). Used by the creation and update costs of indexes."@en ;
                         rdfs:label "has I/O-CPU cost coefficient"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasIOCost
:hasIOCost rdf:type owl:DatatypeProperty ;
           rdfs:domain :DBMS ;
           rdfs:range xsd:float ;
           rdfs:label "has I/O cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasInitialAccumulatedBonus
:hasInitialAccumulatedBonus rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :Index ;
                            rdfs:range xsd:float ;
                            rdfs:comment "Accumulated benefit of the hypothetical index when it became this real index. Starting value of hasAccumulatedBonus, again after each rebuild."@en ;
                            rdfs:label "has initial accumulated bonus"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasInitialRatio
:hasInitialRatio rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :AccessStructure ;
                 rdfs:range xsd:float ;
                 rdfs:comment "Ri in Morelli, chapter 4: table tuples / index blocks measured right after the creation of the real index (getsize, pgstatindex). Set by the dispatcher."@en ;
                 rdfs:label "has initial ratio"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasInstantiationOrder
:hasInstantiationOrder rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Concept ;
                       rdfs:range xsd:int ;
                       rdfs:label "has instantiation order"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasJustification
:hasJustification rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Action ;
                  rdfs:range xsd:string ;
                  rdfs:label "has justification"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasLeftOperandReference
:hasLeftOperandReference rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :Predicate ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Column on the left of an atomic expression (table.column or column)."@en ;
                         rdfs:label "has left operand reference"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasLibrary
:hasLibrary rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Function ;
            rdfs:range xsd:string ;
            rdfs:comment "Java package of the dispatcher."@en ;
            rdfs:label "has library"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasLiteralValue
:hasLiteralValue rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Literal ;
                 rdfs:range xsd:string ;
                 rdfs:comment "SQL text of the value."@en ;
                 rdfs:label "has literal value"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumCreationCost
:hasMaximumCreationCost rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :Heuristic ;
                        rdfs:range xsd:float ;
                        rdfs:comment "Views with a larger estimated creation cost are not materialized by the expectation heuristic (5000000 in figure 4.11)."@en ;
                        rdfs:label "has maximum creation cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumQueryCost
:hasMaximumQueryCost rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Heuristic ;
                     rdfs:range xsd:float ;
                     rdfs:comment "Queries with a larger real cost are not considered by the expectation heuristic (5000000 in figure 4.11)."@en ;
                     rdfs:label "has maximum query cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumSize
:hasMaximumSize rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Column ;
                rdfs:range xsd:int ;
                rdfs:comment "Maximum size of the column in bytes, from its data type (DBMS manual)."@en ;
                rdfs:label "has maximum size"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumBlockCount
:hasMinimumBlockCount rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Heuristic ;
                      rdfs:range xsd:int ;
                      rdfs:comment "dia_size: indexes with fewer blocks are not rebuilt (default 800 blocks of 8 KB)."@en ;
                      rdfs:label "has minimum block count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumFragmentationDegree
:hasMinimumFragmentationDegree rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain :Heuristic ;
                               rdfs:range xsd:float ;
                               rdfs:comment "dia_ratio: minimum fragmentation degree (GrF, in %) for an index to be rebuilt (default 50)."@en ;
                               rdfs:label "has minimum fragmentation degree"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumProcessingPercentage
:hasMinimumProcessingPercentage rdf:type owl:DatatypeProperty ,
                                         owl:FunctionalProperty ;
                                rdfs:domain :Heuristic ;
                                rdfs:range xsd:float ;
                                rdfs:comment "X% of the expectation heuristic (rule 4-2): the processing share above which a view is materialized (50 in the experiments of Oliveira, section 6.4.3)."@en ;
                                rdfs:label "has minimum processing percentage"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumScanCount
:hasMinimumScanCount rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Heuristic ;
                     rdfs:range xsd:int ;
                     rdfs:comment "dia_scans: minimum number of useful scans for an index to be rebuilt (default 2)."@en ;
                     rdfs:label "has minimum scan count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasName
:hasName rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:range xsd:string ;
         rdfs:label "has name"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasOperatorSymbol
:hasOperatorSymbol rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Predicate ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Comparison operator of an atomic expression, as text (=, <, between, like, not in, ...)."@en ;
                   rdfs:label "has operator symbol"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasOrdinalPosition
:hasOrdinalPosition rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Column ;
                    rdfs:range xsd:int ;
                    rdfs:comment "Position of the column in its table."@en ;
                    rdfs:label "has ordinal position"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasPageCount
:hasPageCount rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Table ;
              rdfs:range xsd:int ;
              rdfs:label "has page count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasPageReadCount
:hasPageReadCount rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :DMLStatementExecutionPlan ;
                  rdfs:range xsd:int ;
                  rdfs:comment "QPL (Oliveira, table 4.3): number of disk pages read by the execution of the query (e.g. EXPLAIN (ANALYZE, BUFFERS) in PostgreSQL). Set by the dispatcher on the real plan."@en ;
                  rdfs:label "has page read count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasPageSize
:hasPageSize rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :DBMS ;
             rdfs:range xsd:int ;
             rdfs:label "has page size"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasPredicateOrder
:hasPredicateOrder rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :AtomicExpression ;
                   rdfs:range xsd:int ;
                   rdfs:comment "Position (1, 2, ...) of the atomic expression in the WHERE clause, from left to right."@en ;
                   rdfs:label "has predicate order"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasProcessedTupleCount
:hasProcessedTupleCount rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :DMLStatementExecutionPlan ;
                        rdfs:range xsd:int ;
                        rdfs:comment "Number of tuples the plan processed. In the real plan of an INSERT, UPDATE or DELETE: the tuples inserted, updated or deleted (r in the update cost of Salles, 2002)."@en ;
                        rdfs:label "has processed tuple count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasProcessingPercentage
:hasProcessingPercentage rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :HypotheticalMaterializedView ;
                         rdfs:range xsd:float ;
                         rdfs:comment "(CRC - QPL) x 100 / CRC (Oliveira, rule 4-4): share of the cost of the query that is processing (CPU) and not reading pages."@en ;
                         rdfs:label "has processing percentage"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasResetUpdate
:hasResetUpdate rdf:type owl:DatatypeProperty ;
                rdfs:domain :Rule ;
                rdfs:range xsd:string ;
                rdfs:comment "SPARQL 1.1 Update that removes the values the rule recomputes from scratch (costs, accumulated benefits, benefit records). The tool executes it before the rules whenever the rule is going to run, so that a new run does not count an execution twice. Kept with the SHACL implementation of the rule (rules.ttl)."@en ;
                rdfs:label "has reset update"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperandReference
:hasRightOperandReference rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :Predicate ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Column on the right of an atomic expression, when the right operand is a column (join)."@en ;
                          rdfs:label "has right operand reference"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperandValue
:hasRightOperandValue rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Predicate ;
                      rdfs:range xsd:string ;
                      rdfs:comment "SQL text of the value on the right of an atomic expression (becomes a Literal)."@en ;
                      rdfs:label "has right operand value"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasSFDiskSize
:hasSFDiskSize rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :DBMS ;
               rdfs:range xsd:int ;
               rdfs:label "has SF disk size"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasStatus
:hasStatus rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :AccessStructure ;
           rdfs:range [ rdf:type rdfs:Datatype ;
                        owl:oneOf [ rdf:type rdf:List ;
                                    rdf:first "collecting" ;
                                    rdf:rest [ rdf:type rdf:List ;
                                               rdf:first "created" ;
                                               rdf:rest [ rdf:type rdf:List ;
                                                          rdf:first "dbaDecision" ;
                                                          rdf:rest [ rdf:type rdf:List ;
                                                                     rdf:first "persisted" ;
                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                rdf:first "removed" ;
                                                                                rdf:rest rdf:nil
                                                                              ]
                                                                   ]
                                                        ]
                                             ]
                                  ]
                      ] ;
           rdfs:comment "Status of a real index, computed by Rule_RealIndex_Lifecycle: dbaDecision (CREATE INDEX proposed, not executed yet), created (exists in the database), removed (DROP INDEX executed)."@en ;
           rdfs:label "has status"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasSymbol
:hasSymbol rdf:type owl:DatatypeProperty ;
           rdfs:domain :Token ;
           rdfs:range xsd:string ;
           rdfs:label "has symbol"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTableReference
:hasTableReference rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Clause ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Name of a table the clause mentions, as written in the SQL (FROM, UPDATE, DELETE FROM, INSERT INTO)."@en ;
                   rdfs:label "has table reference"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetCost
:hasTableSubsetCost rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :TableSubset ;
                    rdfs:range xsd:float ;
                    rdfs:comment "TS-Cost(T): total cost of the queries and subqueries of the workload (one per execution) whose tables include T."@en ;
                    rdfs:label "has TS-Cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetSize
:hasTableSubsetSize rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :TableSubset ;
                    rdfs:range xsd:float ;
                    rdfs:comment "sizeTables(T): sum of the page counts of the tables of the subset."@en ;
                    rdfs:label "has table subset size"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetWeight
:hasTableSubsetWeight rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :TableSubset ;
                      rdfs:range xsd:float ;
                      rdfs:comment "TS-Weight(T) = sum over those queries Qi of Cost(Qi) x sizeTables(T) / sizeTablesClause(Qi), table size = pages."@en ;
                      rdfs:label "has TS-Weight"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTime
:hasTime rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Action
                                     :DMLStatementExecution
                                   )
                     ] ;
         rdfs:range xsd:time ;
         rdfs:comment "Time of a DML statement execution, or time at which the dispatcher executed an action."@en ;
         rdfs:label "has time"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTimestamp
:hasTimestamp rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Action
                                          :DMLStatementExecution
                                        )
                          ] ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "hasDate + hasTime (00:00:00 when there is no time), computed by Rule_IndexBenefit_Timestamp. Puts executions and executed actions in order: an execution counts for a real index only between the creation (or the last rebuild) and the removal of the index."@en ;
              rdfs:label "has timestamp"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTotalCost
:hasTotalCost rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :DMLStatementExecutionPlan ;
              rdfs:range xsd:float ;
              rdfs:comment "Total cost of an execution plan, real or hypothetical."@en ;
              rdfs:label "has total cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTupleCount
:hasTupleCount rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Table ;
               rdfs:range xsd:int ;
               rdfs:label "has tuple count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasTupleSize
:hasTupleSize rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :HypotheticalMaterializedView ;
              rdfs:range xsd:float ;
              rdfs:comment "SizeRowVM (Weberling, section 3.1.2): maximum size in bytes of a tuple of the view, the sum of the maximum sizes of its columns."@en ;
              rdfs:label "has tuple size"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasType
:hasType rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string ;
         rdfs:label "has type"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasUpdateCost
:hasUpdateCost rdf:type owl:DatatypeProperty ;
               rdfs:domain :AccessStructure ;
               rdfs:range xsd:float ;
               rdfs:label "has update cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasUsageCount
:hasUsageCount rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :AccessStructure ;
               rdfs:range xsd:int ;
               rdfs:comment "Hypothetical index: number of counted executions whose hypothetical plan used it (divides the accumulated benefit to give the bonus). Real index: number of executions since its creation (or its last rebuild) whose real plan used it."@en ;
               rdfs:label "has usage count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasUsefulScanCount
:hasUsefulScanCount rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :AccessStructure ;
                    rdfs:range xsd:int ;
                    rdfs:comment "V in Morelli, chapter 4: number of executions since the creation of the real index whose real plan used it in a scan (a range predicate on one of its columns: between, <, <=, >, >=)."@en ;
                    rdfs:label "has useful scan count"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasVersion
:hasVersion rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Heuristic ;
            rdfs:range xsd:string ;
            rdfs:label "has version"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasWorkloadFraction
:hasWorkloadFraction rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Heuristic ;
                     rdfs:range xsd:float ;
                     rdfs:comment "C as a fraction of the total cost of the workload (0.10 in Agrawal et al. for SQL Server)."@en ;
                     rdfs:label "has workload fraction"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#hasWorkloadThreshold
:hasWorkloadThreshold rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :TableSubset ;
                      rdfs:range xsd:float ;
                      rdfs:comment "C: hasWorkloadFraction of the heuristic x total cost of the workload."@en ;
                      rdfs:label "has workload threshold"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isEnabled
:isEnabled rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Heuristic
                                       :Rule
                                     )
                       ] ;
           rdfs:range xsd:boolean ;
           rdfs:comment "On a heuristic: true, the rules it defines (definesRule) are executed; false, they are skipped. On a rule: false switches off only that rule (no value means enabled)."@en ;
           rdfs:label "is enabled"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#isInterestingTableSubset
:isInterestingTableSubset rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :TableSubset ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "TS-Cost >= C and TS-Weight >= C (InterestingTableSubsets, figure 8)."@en ;
                          rdfs:label "is interesting table subset"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#wasCreatedAt
:wasCreatedAt rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Index ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "Timestamp of the executed CREATE INDEX action."@en ;
              rdfs:label "was created at"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#wasExecuted
:wasExecuted rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Action ;
             rdfs:range xsd:boolean ;
             rdfs:label "was executed"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#wasIndexUsed
:wasIndexUsed rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :IndexBenefit ;
              rdfs:range xsd:boolean ;
              rdfs:comment "HypotheticalPlanBenefit: the hypothetical plan accesses the index. RealIndexBonus: the real plan accesses the index."@en ;
              rdfs:label "was index used"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#wasRebuiltAt
:wasRebuiltAt rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Index ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "Timestamp of the last executed REINDEX action."@en ;
              rdfs:label "was rebuilt at"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#wasRemovedAt
:wasRemovedAt rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Index ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "Timestamp of the executed DROP INDEX action."@en ;
              rdfs:label "was removed at"@en .


#################################################################
#    Classes
#################################################################

###  http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure
:AccessStructure rdf:type owl:Class ;
                 rdfs:subClassOf :AtomicObject ;
                 owl:disjointUnionOf ( :HypotheticalAccessStructure
                                       :RealAccessStructure
                                     ) .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action
:Action rdf:type owl:Class ;
        rdfs:subClassOf :TaskConcept ;
        rdfs:label "Action"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#AlgorithmSpecification
:AlgorithmSpecification rdf:type owl:Class ;
                        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#AtomicExpression
:AtomicExpression rdf:type owl:Class ;
                  rdfs:subClassOf :Predicate .


###  http://www.owl-ontologies.com/onDBTuning.owl#AtomicObject
:AtomicObject rdf:type owl:Class ;
              rdfs:subClassOf :DBObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#AtomicStatement
:AtomicStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#BPlusTreeSpecification
:BPlusTreeSpecification rdf:type owl:Class ;
                        rdfs:subClassOf :DataStructureSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#BitmapSpecification
:BitmapSpecification rdf:type owl:Class ;
                     rdfs:subClassOf :DataStructureSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#BufferArea
:BufferArea rdf:type owl:Class ;
            rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                            :AtomicObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#Clause
:Clause rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Column
:Column rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                        :AtomicObject ,
                        :ExpressionObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#ColumnScopeClause
:ColumnScopeClause rdf:type owl:Class ;
                   rdfs:subClassOf :Clause .


###  http://www.owl-ontologies.com/onDBTuning.owl#ComparisonOperator
:ComparisonOperator rdf:type owl:Class ;
                    rdfs:subClassOf :ExpressionObject ,
                                    :Token .


###  http://www.owl-ontologies.com/onDBTuning.owl#CompositeExpression
:CompositeExpression rdf:type owl:Class ;
                     rdfs:subClassOf :Predicate .


###  http://www.owl-ontologies.com/onDBTuning.owl#CompositeObject
:CompositeObject rdf:type owl:Class ;
                 rdfs:subClassOf :DBObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#CompositeStatement
:CompositeStatement rdf:type owl:Class ;
                    rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#ComputationalAgent
:ComputationalAgent rdf:type owl:Class ;
                    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Concept
:Concept rdf:type owl:Class ;
         rdfs:subClassOf :TaskConcept ;
         rdfs:label "Concept"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#CreateHypotheticalIndexStatement
:CreateHypotheticalIndexStatement rdf:type owl:Class ;
                                  rdfs:subClassOf :TuningAssistStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#CreateHypotheticalMaterializedViewStatement
:CreateHypotheticalMaterializedViewStatement rdf:type owl:Class ;
                                             rdfs:subClassOf :TuningAssistStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#CreateIndexStatement
:CreateIndexStatement rdf:type owl:Class ;
                      rdfs:subClassOf :CreateStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#CreateMaterializedViewStatement
:CreateMaterializedViewStatement rdf:type owl:Class ;
                                 rdfs:subClassOf :CreateStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#CreateStatement
:CreateStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DDLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#DBClientApplication
:DBClientApplication rdf:type owl:Class ;
                     rdfs:subClassOf :ComputationalAgent ,
                                     :DatabaseUser .


###  http://www.owl-ontologies.com/onDBTuning.owl#DBMS
:DBMS rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DBMSSpecificClause
:DBMSSpecificClause rdf:type owl:Class ;
                    rdfs:subClassOf :Clause .


###  http://www.owl-ontologies.com/onDBTuning.owl#DBObject
:DBObject rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ;
          owl:disjointUnionOf ( :AtomicObject
                                :CompositeObject
                              ) .


###  http://www.owl-ontologies.com/onDBTuning.owl#DBObjectSpecification
:DBObjectSpecification rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DDLStatement
:DDLStatement rdf:type owl:Class ;
              rdfs:subClassOf :SQLStatement ;
              owl:disjointWith :DMLStatement ,
                               :TuningAssistStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#DDLStatementExecution
:DDLStatementExecution rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement
:DMLStatement rdf:type owl:Class ;
              rdfs:subClassOf :SQLStatement ;
              owl:disjointUnionOf ( :AtomicStatement
                                    :CompositeStatement
                                  ) .


###  http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution
:DMLStatementExecution rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan
:DMLStatementExecutionPlan rdf:type owl:Class ;
                           rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> ;
                           owl:disjointUnionOf ( :HypotheticalDMLStatementExecutionPlan
                                                 :RealDMLStatementExecutionPlan
                                               ) .


###  http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlanWithAccessStructure
:DMLStatementExecutionPlanWithAccessStructure rdf:type owl:Class ;
                                              rdfs:subClassOf :DMLStatementExecutionPlan .


###  http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementSubmission
:DMLStatementSubmission rdf:type owl:Class ;
                        rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DataStructure
:DataStructure rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DataStructureSpecification
:DataStructureSpecification rdf:type owl:Class ;
                            rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Database
:Database rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DatabaseUser
:DatabaseUser rdf:type owl:Class ;
              rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#DeleteFromClause
:DeleteFromClause rdf:type owl:Class ;
                  rdfs:subClassOf :TableScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#DeleteStatement
:DeleteStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#Disk
:Disk rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                      :CompositeObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#DiskBlockArea
:DiskBlockArea rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                               :AtomicObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#DropHypotheticalIndexStatement
:DropHypotheticalIndexStatement rdf:type owl:Class ;
                                rdfs:subClassOf :TuningAssistStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#DropHypotheticalMaterializedViewStatement
:DropHypotheticalMaterializedViewStatement rdf:type owl:Class ;
                                           rdfs:subClassOf :TuningAssistStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#DropIndexStatement
:DropIndexStatement rdf:type owl:Class ;
                    rdfs:subClassOf :DropStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#DropMaterializedViewStatement
:DropMaterializedViewStatement rdf:type owl:Class ;
                               rdfs:subClassOf :DropStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#DropStatement
:DropStatement rdf:type owl:Class ;
               rdfs:subClassOf :DDLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#ExpressionObject
:ExpressionObject rdf:type owl:Class ;
                  rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ;
                  owl:disjointUnionOf ( :Column
                                        :ComparisonOperator
                                        :Literal
                                      ) .


###  http://www.owl-ontologies.com/onDBTuning.owl#FromClause
:FromClause rdf:type owl:Class ;
            rdfs:subClassOf :TableScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#FullIndexScanSpecification
:FullIndexScanSpecification rdf:type owl:Class ;
                            rdfs:subClassOf :ScanSpecification ;
                            owl:disjointWith :FullTableScanSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#FullTableScanSpecification
:FullTableScanSpecification rdf:type owl:Class ;
                            rdfs:subClassOf :ScanSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#Function
:Function rdf:type owl:Class ;
          rdfs:subClassOf :Source ;
          rdfs:label "Function"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#GroupByClause
:GroupByClause rdf:type owl:Class ;
               rdfs:subClassOf :ColumnScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#HashTableSpecification
:HashTableSpecification rdf:type owl:Class ;
                        rdfs:subClassOf :DataStructureSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#HavingClause
:HavingClause rdf:type owl:Class ;
              rdfs:subClassOf :ColumnScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#Heuristic
:Heuristic rdf:type owl:Class ;
           rdfs:subClassOf :TaskConcept ;
           rdfs:label "Heuristic"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalAccessStructure
:HypotheticalAccessStructure rdf:type owl:Class ;
                             rdfs:subClassOf :AccessStructure .


###  http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalDMLStatementExecutionPlan
:HypotheticalDMLStatementExecutionPlan rdf:type owl:Class ;
                                       rdfs:subClassOf :DMLStatementExecutionPlan .


###  http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalIndex
:HypotheticalIndex rdf:type owl:Class ;
                   rdfs:subClassOf :HypotheticalAccessStructure ,
                                   :IndexSpecification ;
                   owl:disjointWith :HypotheticalMaterializedView .


###  http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView
:HypotheticalMaterializedView rdf:type owl:Class ;
                              rdfs:subClassOf :HypotheticalAccessStructure ,
                                              :MaterializedViewSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalPlanBenefit
:HypotheticalPlanBenefit rdf:type owl:Class ;
                         rdfs:subClassOf :IndexBenefit ;
                         rdfs:comment "Benefit of a hypothetical index estimated from the plans of one execution of a statement that originates it: +(real plan total cost - hypothetical plan total cost) if the hypothetical plan uses the index, the same value negated otherwise. Not recorded while the index is real."@en ;
                         rdfs:label "Hypothetical Plan Benefit"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#Index
:Index rdf:type owl:Class ;
       rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                       :DataStructure ,
                       :RealAccessStructure ;
       owl:disjointWith :MaterializedView ,
                        :Table .


###  http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit
:IndexBenefit rdf:type owl:Class ;
              rdfs:subClassOf :TaskConcept ;
              owl:disjointWith :MaterializedViewBenefit ;
              owl:disjointUnionOf ( :HypotheticalPlanBenefit
                                    :IndexUpdateCost
                                    :RealIndexBonus
                                  ) ;
              rdfs:comment "Change that one DML statement execution makes to the accumulated benefit (hypothetical index) or to the accumulated bonus (real index) of one index. Explains the numbers to the DBA."@en ;
              rdfs:label "Index Benefit"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#IndexMaterialization
:IndexMaterialization rdf:type owl:Class ;
                      rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#IndexSpecification
:IndexSpecification rdf:type owl:Class ;
                    rdfs:subClassOf :DBObjectSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#IndexUpdateCost
:IndexUpdateCost rdf:type owl:Class ;
                 rdfs:subClassOf :IndexBenefit ;
                 rdfs:comment "Cost of keeping an index up to date in one INSERT, UPDATE or DELETE execution (Salles, 2002, section 4.5.1; Morelli, figure 3.5): CA = 2 x ceil(r / R x P) + c x r, subtracted from hypothetical and real indexes alike."@en ;
                 rdfs:label "Index Update Cost"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#InsertIntoClause
:InsertIntoClause rdf:type owl:Class ;
                  rdfs:subClassOf :ColumnScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#InsertStatement
:InsertStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#LimitClause
:LimitClause rdf:type owl:Class ;
             rdfs:subClassOf :OutputScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#Literal
:Literal rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                         :ExpressionObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#LogicalConnector
:LogicalConnector rdf:type owl:Class ;
                  rdfs:subClassOf :Token .


###  http://www.owl-ontologies.com/onDBTuning.owl#MaterializedView
:MaterializedView rdf:type owl:Class ;
                  rdfs:subClassOf :RealAccessStructure ,
                                  :View .


###  http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewBenefit
:MaterializedViewBenefit rdf:type owl:Class ;
                         rdfs:subClassOf :TaskConcept ;
                         rdfs:comment "HyGainVM of one execution for one hypothetical materialized view: Cost(q) - HyCost, q the query or subquery of the execution compatible with the view (figure 17)."@en ;
                         rdfs:label "Materialized View Benefit"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewSpecification
:MaterializedViewSpecification rdf:type owl:Class ;
                               rdfs:subClassOf :DBObjectSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#Memory
:Memory rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                        :CompositeObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#MySQLSpecificClause
:MySQLSpecificClause rdf:type owl:Class ;
                     rdfs:subClassOf :DBMSSpecificClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#OperationSpecification
:OperationSpecification rdf:type owl:Class ;
                        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Optimizer
:Optimizer rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#OracleSpecificClause
:OracleSpecificClause rdf:type owl:Class ;
                      rdfs:subClassOf :DBMSSpecificClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#OrderByClause
:OrderByClause rdf:type owl:Class ;
               rdfs:subClassOf :ColumnScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#OutputScopeClause
:OutputScopeClause rdf:type owl:Class ;
                   rdfs:subClassOf :Clause .


###  http://www.owl-ontologies.com/onDBTuning.owl#Parameter
:Parameter rdf:type owl:Class ;
           rdfs:subClassOf :TaskConcept ;
           rdfs:label "Parameter"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#PartialIndex
:PartialIndex rdf:type owl:Class ;
              rdfs:subClassOf :Index .


###  http://www.owl-ontologies.com/onDBTuning.owl#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#PersonDBUser
:PersonDBUser rdf:type owl:Class ;
              rdfs:subClassOf :DatabaseUser ,
                              :Person .


###  http://www.owl-ontologies.com/onDBTuning.owl#PostgreSQLSpecificClause
:PostgreSQLSpecificClause rdf:type owl:Class ;
                          rdfs:subClassOf :DBMSSpecificClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#Predicate
:Predicate rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ;
           owl:disjointUnionOf ( :AtomicExpression
                                 :CompositeExpression
                               ) .


###  http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageArea
:PrimaryStorageArea rdf:type owl:Class ;
                    rdfs:subClassOf :Memory ,
                                    :StorageArea ;
                    owl:disjointWith :SecondaryStorageArea .


###  http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageAreaComponent
:PrimaryStorageAreaComponent rdf:type owl:Class ;
                             rdfs:subClassOf :BufferArea ,
                                             :StorageAreaComponent ;
                             owl:disjointWith :SecondaryStorageAreaComponent .


###  http://www.owl-ontologies.com/onDBTuning.owl#QueryStatement
:QueryStatement rdf:type owl:Class ;
                rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure
:RealAccessStructure rdf:type owl:Class ;
                     rdfs:subClassOf :AccessStructure .


###  http://www.owl-ontologies.com/onDBTuning.owl#RealDMLStatementExecutionPlan
:RealDMLStatementExecutionPlan rdf:type owl:Class ;
                               rdfs:subClassOf :DMLStatementExecutionPlan .


###  http://www.owl-ontologies.com/onDBTuning.owl#RealIndexBonus
:RealIndexBonus rdf:type owl:Class ;
                rdfs:subClassOf :IndexBenefit ;
                rdfs:comment "Bonus of a real index for one execution, read from the real plan (from the DBMS): +hasBonus if the real plan uses the index (Morelli, figure 3.4, line 9); -hasBonus if the statement originated the index but the real plan did not use it (Rule_RealIndex_UnusedPenalty, an extension to Morelli)."@en ;
                rdfs:label "Real Index Bonus"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#ReferencedColumn
:ReferencedColumn rdf:type owl:Class ;
                  rdfs:subClassOf :Column .


###  http://www.owl-ontologies.com/onDBTuning.owl#ReferencedTable
:ReferencedTable rdf:type owl:Class ;
                 rdfs:subClassOf :Table .


###  http://www.owl-ontologies.com/onDBTuning.owl#ReindexStatement
:ReindexStatement rdf:type owl:Class ;
                  rdfs:subClassOf :DDLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#RewrittenQueryStatement
:RewrittenQueryStatement rdf:type owl:Class ;
                         rdfs:subClassOf :QueryStatement ,
                                         :TuningAssistStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#RownumClause
:RownumClause rdf:type owl:Class ;
              rdfs:subClassOf :OutputScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule
:Rule rdf:type owl:Class ;
      rdfs:subClassOf :Source ;
      rdfs:comment "A rule of a heuristic. When a SHACL rule has the same IRI as a Rule individual, the script runs it only if a heuristic that defines it is enabled and the rule itself is not disabled (isEnabled false)."@en ;
      rdfs:label "Rule"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#SQLServerSpecificClause
:SQLServerSpecificClause rdf:type owl:Class ;
                         rdfs:subClassOf :DBMSSpecificClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#SQLStatement
:SQLStatement rdf:type owl:Class ;
              rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#ScanSpecification
:ScanSpecification rdf:type owl:Class ;
                   rdfs:subClassOf :OperationSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#SecondaryStorageArea
:SecondaryStorageArea rdf:type owl:Class ;
                      rdfs:subClassOf :Disk ,
                                      :StorageArea .


###  http://www.owl-ontologies.com/onDBTuning.owl#SecondaryStorageAreaComponent
:SecondaryStorageAreaComponent rdf:type owl:Class ;
                               rdfs:subClassOf :DiskBlockArea ,
                                               :StorageAreaComponent .


###  http://www.owl-ontologies.com/onDBTuning.owl#SelectClause
:SelectClause rdf:type owl:Class ;
              rdfs:subClassOf :ColumnScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#SetClause
:SetClause rdf:type owl:Class ;
           rdfs:subClassOf :ColumnScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#Source
:Source rdf:type owl:Class ;
        rdfs:subClassOf :TaskConcept ;
        rdfs:label "Source"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#SpecificationOfIndexToBeScanned
:SpecificationOfIndexToBeScanned rdf:type owl:Class ;
                                 rdfs:subClassOf :IndexSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#StorageArea
:StorageArea rdf:type owl:Class ;
             rdfs:subClassOf :CompositeObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#StorageAreaComponent
:StorageAreaComponent rdf:type owl:Class ;
                      rdfs:subClassOf :AtomicObject .


###  http://www.owl-ontologies.com/onDBTuning.owl#Table
:Table rdf:type owl:Class ;
       rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ,
                       :AtomicObject ,
                       :DataStructure .


###  http://www.owl-ontologies.com/onDBTuning.owl#TableScopeClause
:TableScopeClause rdf:type owl:Class ;
                  rdfs:subClassOf :Clause .


###  http://www.owl-ontologies.com/onDBTuning.owl#TableSpecification
:TableSpecification rdf:type owl:Class ;
                    rdfs:subClassOf :DBObjectSpecification .


###  http://www.owl-ontologies.com/onDBTuning.owl#TableSubset
:TableSubset rdf:type owl:Class ;
             rdfs:subClassOf :TaskConcept ;
             rdfs:comment "Set of tables referenced by a basic query (TS in Agrawal et al., 2000, used by Weberling, section 3.1.1). Interesting when TS-Cost and TS-Weight reach the threshold C."@en ;
             rdfs:label "Table Subset"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#TaskConcept
:TaskConcept rdf:type owl:Class ;
             rdfs:label "Task Concept"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#Token
:Token rdf:type owl:Class ;
       rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> ;
       owl:disjointUnionOf ( :ComparisonOperator
                             :LogicalConnector
                           ) .


###  http://www.owl-ontologies.com/onDBTuning.owl#TopClause
:TopClause rdf:type owl:Class ;
           rdfs:subClassOf :OutputScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#TuningAssistStatement
:TuningAssistStatement rdf:type owl:Class ;
                       rdfs:subClassOf :SQLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#UpdateClause
:UpdateClause rdf:type owl:Class ;
              rdfs:subClassOf :TableScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#UpdateStatement
:UpdateStatement rdf:type owl:Class ;
                 rdfs:subClassOf :DMLStatement .


###  http://www.owl-ontologies.com/onDBTuning.owl#UsedAccessStructure
:UsedAccessStructure rdf:type owl:Class ;
                     rdfs:subClassOf :AccessStructure .


###  http://www.owl-ontologies.com/onDBTuning.owl#View
:View rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .


###  http://www.owl-ontologies.com/onDBTuning.owl#WhereClause
:WhereClause rdf:type owl:Class ;
             rdfs:subClassOf :ColumnScopeClause .


###  http://www.owl-ontologies.com/onDBTuning.owl#Workload
:Workload rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.org/nemo/gufo#VariableCollection> .


#################################################################
#    Individuals
#################################################################

###  http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure
:AccessStructure rdf:type owl:NamedIndividual ,
                          <http://purl.org/nemo/gufo#Category> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex
:Action_CreateHypotheticalIndex rdf:type owl:NamedIndividual ,
                                         :Action ;
                                :isPerformedBy :Function_CreateHypotheticalIndex ;
                                :hasDescription "create hypothetical index % on %(%);" ;
                                :hasJustification "As the index is no longer beneficial to the database (Benefit: % x Creation cost: %), it was removed and kept only in the metabase." .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealIndex
:Action_CreateRealIndex rdf:type owl:NamedIndividual ,
                                 :Action ;
                        :isPerformedBy :Function_CreateRealIndex ;
                        :hasDescription "create index % on %(%);" ;
                        :hasJustification "The index has an estimated benefit of %, which exceeds its estimated creation cost of %. Statements that generated the benefits: %." .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealMaterializedView
:Action_CreateRealMaterializedView rdf:type owl:NamedIndividual ,
                                            :Action ;
                                   :isPerformedBy :Function_RealMaterializedView ;
                                   :hasDBADecision "true"^^xsd:boolean ;
                                   :hasDescription "create materialized view %" ;
                                   :hasJustification "The hypothetical materialized view has an estimated positive benefit of %, which in absolute value exceeds its estimated creation cost of %." ;
                                   :wasExecuted "false"^^xsd:boolean .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_DropHypotheticalIndex
:Action_DropHypotheticalIndex rdf:type owl:NamedIndividual ,
                                       :Action ;
                              :isPerformedBy :Function_DropHypotheticalIndex ;
                              :hasDescription "drop hypothetical index %;" ;
                              :hasJustification "As the index proved beneficial to the database (Benefit: % x Creation cost: %), it was removed as hypothetical and created as a real index in the database." .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_DropRealIndex
:Action_DropRealIndex rdf:type owl:NamedIndividual ,
                               :Action ;
                      :isPerformedBy :Function_DropRealIndex ;
                      :hasDescription "drop index %;" ;
                      :hasJustification "The index has an estimated negative benefit of %, which in absolute value exceeds its estimated creation cost of %. Statements that caused the losses: %." .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewBenefitsHeuristic
:Action_MaterializedViewBenefitsHeuristic rdf:type owl:NamedIndividual ,
                                                   :Action ;
                                          :isPerformedBy :Function_RealMaterializedView ;
                                          :hasDBADecision "true"^^xsd:boolean ;
                                          :hasDescription "MaterializedViewBenefitsHeuristic" ;
                                          :hasJustification "This materialized view has an estimated benefit of <MaterializedView.accumulatedBenefit>, which exceeds its estimated creation cost of <MaterializedView.creationCost>. Statements that generated the benefits: <MaterializedView.benefitedStatements>" ;
                                          :wasExecuted "false"^^xsd:boolean .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewCandidatesHeuristic
:Action_MaterializedViewCandidatesHeuristic rdf:type owl:NamedIndividual ,
                                                     :Action ;
                                            :isPerformedBy :Function_HypotheticalMaterializedView ;
                                            :hasDBADecision "true"^^xsd:boolean ;
                                            :hasDescription "MaterializedViewCandidatesHeuristic" ;
                                            :hasJustification "The SQL query <Query> was rewritten to make it generic and usable by other queries with the same structure but different parameters. As a consequence, the hypothetical materialized view with the following syntax was suggested: <DDL Create View>" ;
                                            :wasExecuted "false"^^xsd:boolean .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewExpectationHeuristic
:Action_MaterializedViewExpectationHeuristic rdf:type owl:NamedIndividual ,
                                                      :Action ;
                                             :isPerformedBy :Function_RealMaterializedView ;
                                             :hasDBADecision "true"^^xsd:boolean ;
                                             :hasDescription "MaterializedViewExpectationHeuristic" ;
                                             :hasJustification "This materialized view has an estimated execution cost of <MaterializedView.estimatedExecutionCost>, while the original query costs <Query.executionCost>. Therefore, the estimated saving each time the materialized view is used may be <MaterializedView.executionGain>" ;
                                             :wasExecuted "false"^^xsd:boolean .


###  http://www.owl-ontologies.com/onDBTuning.owl#Action_RebuildRealIndex
:Action_RebuildRealIndex rdf:type owl:NamedIndividual ,
                                  :Action ;
                         :isPerformedBy :Function_RebuildRealIndex ;
                         :hasDescription "alter index % set (fillfactor = %); reindex index %;" ;
                         :hasJustification "The accumulated bonus of the index, %, is below its elimination cost, %, but the index is fragmented (GrF %) and was useful in % scans: rebuild it with fill factor % instead of dropping it." .


###  http://www.owl-ontologies.com/onDBTuning.owl#AlgorithmSpecification
:AlgorithmSpecification rdf:type owl:NamedIndividual ,
                                 <http://purl.org/nemo/gufo#Kind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#AtomicExpression
:AtomicExpression rdf:type owl:NamedIndividual ,
                           <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#AtomicObject
:AtomicObject rdf:type owl:NamedIndividual ,
                       <http://purl.org/nemo/gufo#Category> .


###  http://www.owl-ontologies.com/onDBTuning.owl#AtomicStatement
:AtomicStatement rdf:type owl:NamedIndividual ,
                          <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#BPlusTreeSpecification
:BPlusTreeSpecification rdf:type owl:NamedIndividual ,
                                 <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#BitmapSpecification
:BitmapSpecification rdf:type owl:NamedIndividual ,
                              <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#BufferArea
:BufferArea rdf:type owl:NamedIndividual ,
                     <http://purl.org/nemo/gufo#Kind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#CandidateIndexesHeuristic
:CandidateIndexesHeuristic rdf:type owl:NamedIndividual ,
                                    :Heuristic ;
                           :definesRule :Rule_HypotheticalIndex_ColumnGroups ,
                                        :Rule_HypotheticalIndex_GroupCombination ,
                                        :Rule_HypotheticalIndex_ReferencedColumns ,
                                        :Rule_HypotheticalIndex_SingleColumn ;
                           :hasPrecondition :Concept_Clause ,
                                            :Concept_Column ,
                                            :Concept_DBMS ,
                                            :Concept_DMLStatement ,
                                            :Concept_DMLStatementExecution ,
                                            :Concept_Predicate ,
                                            :Concept_Table ;
                           :hasAuthor "Marcos Salles" ;
                           :hasClassification "Index Creation" ;
                           :hasName "CandidateIndexesHeuristic" ;
                           :hasVersion "1.0" ;
                           :isEnabled "true"^^xsd:boolean ;
                           rdfs:label "Candidate Indexes Heuristic"@en .


