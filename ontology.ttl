###  http://www.owl-ontologies.com/onDBTuning.owl#Person
:Person rdf:type owl:NamedIndividual ,
                 <http://purl.org/nemo/gufo#Kind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#PersonDBUser
:PersonDBUser rdf:type owl:NamedIndividual ,
                       <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#PostgreSQLSpecificClause
:PostgreSQLSpecificClause rdf:type owl:NamedIndividual ,
                                   <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Predicate
:Predicate rdf:type owl:NamedIndividual ,
                    <http://purl.org/nemo/gufo#Kind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageArea
:PrimaryStorageArea rdf:type owl:NamedIndividual ,
                             <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageAreaComponent
:PrimaryStorageAreaComponent rdf:type owl:NamedIndividual ,
                                      <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#QueryStatement
:QueryStatement rdf:type owl:NamedIndividual ,
                         <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure
:RealAccessStructure rdf:type owl:NamedIndividual ,
                              <http://purl.org/nemo/gufo#Category> .


###  http://www.owl-ontologies.com/onDBTuning.owl#RealDMLStatementExecutionPlan
:RealDMLStatementExecutionPlan rdf:type owl:NamedIndividual ,
                                        <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#ReferencedColumn
:ReferencedColumn rdf:type owl:NamedIndividual ,
                           <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#ReferencedTable
:ReferencedTable rdf:type owl:NamedIndividual ,
                          <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#ReindexStatement
:ReindexStatement rdf:type owl:NamedIndividual ,
                           <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#RewrittenQueryStatement
:RewrittenQueryStatement rdf:type owl:NamedIndividual ,
                                  <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#RownumClause
:RownumClause rdf:type owl:NamedIndividual ,
                       <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_3
:Rule_3 rdf:type owl:NamedIndividual ;
        :hasName "" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Clause_Membership
:Rule_Clause_Membership rdf:type owl:NamedIndividual ,
                                 :Rule ;
                        :hasDescription "Links each clause and its statement in both directions (hasClause / isClauseOf)." ;
                        :hasName "Clause_Membership" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_InsertedColumns
:Rule_Column_InsertedColumns rdf:type owl:NamedIndividual ,
                                      :Rule ;
                             :hasDescription "An INSERT INTO clause without a column list references every column of its table." ;
                             :hasName "Column_InsertedColumns" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_QualifiedReference
:Rule_Column_QualifiedReference rdf:type owl:NamedIndividual ,
                                         :Rule ;
                                :hasDescription "Turns each table.column reference of a clause into the Column of that table (referencesColumn, ReferencedColumn), creating the column if the table does not have it." ;
                                :hasName "Column_QualifiedReference" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_UnqualifiedReference
:Rule_Column_UnqualifiedReference rdf:type owl:NamedIndividual ,
                                           :Rule ;
                                  :hasDescription "Turns each column reference without table into the column with that name of the only table, among those of the FROM clauses of the statement and of the statements around it, that has it." ;
                                  :hasName "Column_UnqualifiedReference" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_ComparisonOperator_Link
:Rule_ComparisonOperator_Link rdf:type owl:NamedIndividual ,
                                       :Rule ;
                              :hasDescription "Links each atomic expression to the ComparisonOperator with its symbol, creating the operator if the symbol is new." ;
                              :hasName "ComparisonOperator_Link" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Classification
:Rule_DMLStatement_Classification rdf:type owl:NamedIndividual ,
                                           :Rule ;
                                  :hasDescription "Types each statement by its clauses: UpdateClause -> UpdateStatement, InsertIntoClause -> InsertStatement, DeleteFromClause -> DeleteStatement, otherwise SelectClause -> QueryStatement." ;
                                  :hasName "DMLStatement_Classification" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Composition
:Rule_DMLStatement_Composition rdf:type owl:NamedIndividual ,
                                        :Rule ;
                               :hasDescription "Links each statement and its subqueries in both directions (hasComponentStatement / isComponentStatementOf) and types it CompositeStatement (it has subqueries) or AtomicStatement." ;
                               :hasName "DMLStatement_Composition" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ColumnGroups
:Rule_HypotheticalIndex_ColumnGroups rdf:type owl:NamedIndividual ,
                                              :Rule ;
                                     :hasDescription "Puts the columns of each query block in the groups of Salles (2002, section 4.5.1): EQ (equality with a value), O (ORDER BY, GROUP BY, join predicates), RANGE (between, <, <=, >, >=) and SARG (like, in)." ;
                                     :hasName "HypotheticalIndex_ColumnGroups" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_GroupCombination
:Rule_HypotheticalIndex_GroupCombination rdf:type owl:NamedIndividual ,
                                                  :Rule ;
                                         :generatesAction :Action_CreateHypotheticalIndex ;
                                         :hasDescription "For each query block and table, suggests the hypothetical indexes EQ+O, EQ+O+RANGE, EQ+O+RANGE+SARG, EQ+O+RANGE+REF, O+EQ, O+EQ+RANGE, O+EQ+RANGE+SARG and O+EQ+RANGE+REF (two or more columns, no repeated column, columns of a group in table order), as in Salles (2002), section 4.5.1." ;
                                         :hasName "HypotheticalIndex_GroupCombination" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ReferencedColumns
:Rule_HypotheticalIndex_ReferencedColumns rdf:type owl:NamedIndividual ,
                                                   :Rule ;
                                          :hasDescription "Group REF: the other columns referenced by the query block (SELECT, WHERE, HAVING, GROUP BY, ORDER BY)." ;
                                          :hasName "HypotheticalIndex_ReferencedColumns" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_SingleColumn
:Rule_HypotheticalIndex_SingleColumn rdf:type owl:NamedIndividual ,
                                              :Rule ;
                                     :generatesAction :Action_CreateHypotheticalIndex ;
                                     :hasDescription "Suggests a single-column hypothetical index for each column of the groups EQ, O, RANGE and SARG." ;
                                     :hasName "HypotheticalIndex_SingleColumn" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Accumulated
:Rule_IndexBenefit_Accumulated rdf:type owl:NamedIndividual ,
                                        :Rule ;
                               :hasDescription "Accumulated benefit of each hypothetical index = sum of its records; after its real index is removed, -CCI plus the records of the later executions (Morelli, section 3.3). Usage count = executions that used it." ;
                               :hasName "IndexBenefit_Accumulated" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_CreationCost
:Rule_IndexBenefit_CreationCost rdf:type owl:NamedIndividual ,
                                         :Rule ;
                                :hasDescription "Creation cost of each hypothetical index (Salles, 2002, section 4.5.1): CCI = 2P + c R log2 R, P and R the pages and tuples of the table, c the I/O-CPU cost coefficient of the DBMS." ;
                                :hasName "IndexBenefit_CreationCost" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_ExecutionBenefit
:Rule_IndexBenefit_ExecutionBenefit rdf:type owl:NamedIndividual ,
                                             :Rule ;
                                    :hasDescription "For each DML statement execution and each hypothetical index the statement originates (while the index is not real), records a HypotheticalPlanBenefit: +(real plan total cost - hypothetical plan total cost) if the hypothetical plan uses the index, the same value negated otherwise." ;
                                    :hasName "IndexBenefit_ExecutionBenefit" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Timestamp
:Rule_IndexBenefit_Timestamp rdf:type owl:NamedIndividual ,
                                      :Rule ;
                             :hasDescription "Timestamp (hasDate + hasTime) of each DML statement execution and of each executed action, to put them in order." ;
                             :hasName "IndexBenefit_Timestamp" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_UpdateCost
:Rule_IndexBenefit_UpdateCost rdf:type owl:NamedIndividual ,
                                       :Rule ;
                              :hasDescription "For each INSERT, UPDATE or DELETE execution and each index it affects (every index of the table for INSERT and DELETE, the indexes with a SET column for UPDATE), hypothetical or real, records an IndexUpdateCost of -CA, CA = 2 x ceil(r / R x P) + c x r (Salles, 2002, section 4.5.1)." ;
                              :hasName "IndexBenefit_UpdateCost" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_Decision
:Rule_IndexRebuild_Decision rdf:type owl:NamedIndividual ,
                                     :Rule ;
                            :generatesAction :Action_RebuildRealIndex ;
                            :hasDescription "When a real index is about to be removed but is fragmented (GrF, blocks and scans above the thresholds of the heuristic), proposes a REINDEX with fill factor 10 - ((V + 10) div 10) instead of the DROP (Morelli, figures 4.4 and 4.13)." ;
                            :hasName "IndexRebuild_Decision" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_FragmentationDegree
:Rule_IndexRebuild_FragmentationDegree rdf:type owl:NamedIndividual ,
                                                :Rule ;
                                       :hasDescription "Fragmentation degree GrF = 100 - (Ra / Ri) x 100 and number of useful scans V of each real index (Morelli, chapter 4)." ;
                                       :hasName "IndexRebuild_FragmentationDegree" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Literal_Creation
:Rule_Literal_Creation rdf:type owl:NamedIndividual ,
                                :Rule ;
                       :hasDescription "Creates the Literal with the value on the right of an atomic expression (hasLiteralValue) and makes it the right operand." ;
                       :hasName "Literal_Creation" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_LogicalConnector_Link
:Rule_LogicalConnector_Link rdf:type owl:NamedIndividual ,
                                     :Rule ;
                            :hasDescription "Links each composite expression to the LogicalConnector with its word (and, or), creating it if the word is new." ;
                            :hasName "LogicalConnector_Link" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_AccumulatedBenefit
:Rule_MV_AccumulatedBenefit rdf:type owl:NamedIndividual ,
                                     :Rule ;
                            :hasDescription "HyGainACVM: sum of the MaterializedViewBenefit records of the view (figure 17, line 7)." ;
                            :hasName "MV_AccumulatedBenefit" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_Compatibility
:Rule_MV_Compatibility rdf:type owl:NamedIndividual ,
                                :Rule ;
                       :hasDescription "A basic query is compatible with a view when it has the same tables and every field it projects, filters or groups by and every aggregate it computes is in the view (Weberling, section 2.7)." ;
                       :hasName "MV_Compatibility" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByBenefits
:Rule_MV_CreationByBenefits rdf:type owl:NamedIndividual ,
                                     :Rule ;
                            :generatesAction :Action_MaterializedViewBenefitsHeuristic ;
                            :hasDescription "When HyGainACVM > CreationCostVM (figure 17, line 8), creates the real MaterializedView (derives), the CreateMaterializedViewStatement and an Action with the justification for the DBA." ;
                            :hasName "MV_CreationByBenefits" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByExpectation
:Rule_MV_CreationByExpectation rdf:type owl:NamedIndividual ,
                                        :Rule ;
                               :generatesAction :Action_MaterializedViewExpectationHeuristic ;
                               :hasDescription "When the view fits in the disk space left for tuning (EDR > CE) and the processing share of the query is above X% (Oliveira, rule 4-2), creates a real MaterializedView (derives), the CreateMaterializedViewStatement and an Action with the justification, whatever the frequency of the query." ;
                               :hasName "MV_CreationByExpectation" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_DefineView
:Rule_MV_DefineView rdf:type owl:NamedIndividual ,
                             :Rule ;
                    :generatesAction :Action_MaterializedViewCandidatesHeuristic ;
                    :hasDescription "MountVM and DefineView (Weberling, figures 14 and 15): for each basic query whose tables form an interesting subset, a hypothetical materialized view over the same tables and joins, projecting the fields, filter fields and HAVING aggregates of the query, grouped by its non-aggregated fields; the view is formulated by a RewrittenQueryStatement the query originates. The same definition is the same view (Merge, figure 16)." ;
                    :hasName "MV_DefineView" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_EstimatedCreationCost
:Rule_MV_EstimatedCreationCost rdf:type owl:NamedIndividual ,
                                        :Rule ;
                               :hasDescription "CreationCostVM = Cost(ClauseVM) + 2 x HyPgVM: computing the definition and writing the pages of the view." ;
                               :hasName "MV_EstimatedCreationCost" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExecutionBenefit
:Rule_MV_ExecutionBenefit rdf:type owl:NamedIndividual ,
                                   :Rule ;
                          :hasDescription "For each execution and each of its queries or subqueries compatible with a view, records a MaterializedViewBenefit HyGainVM = Cost(q) - HyCost(q) (Weberling, figure 17, lines 3-5)." ;
                          :hasName "MV_ExecutionBenefit" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExpectedGain
:Rule_MV_ExpectedGain rdf:type owl:NamedIndividual ,
                               :Rule ;
                      :hasDescription "For each hypothetical materialized view: CRC, the real cost of the query it was defined from in its most recent execution, QPL, the pages that execution read, and (CRC - QPL) x 100 / CRC, the share of the cost that is processing (Oliveira, rule 4-4)." ;
                      :hasName "MV_ExpectedGain" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_FullScanCost
:Rule_MV_FullScanCost rdf:type owl:NamedIndividual ,
                               :Rule ;
                      :hasDescription "HyCost = HyRowVM x SizeRowVM x fill factor / page size: cost of a full scan of the view (Hose et al.)." ;
                      :hasName "MV_FullScanCost" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_HypotheticalPageCount
:Rule_MV_HypotheticalPageCount rdf:type owl:NamedIndividual ,
                                        :Rule ;
                               :hasDescription "HyPgVM = HyRowVM x SizeRowVM / page size (HyRowVM from the plan of the definition of the view)." ;
                               :hasName "MV_HypotheticalPageCount" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_InterestingTableSubset
:Rule_MV_InterestingTableSubset rdf:type owl:NamedIndividual ,
                                         :Rule ;
                                :hasDescription "InterestingTableSubsets (Weberling, figure 8): TS-Cost(T) = total cost of the queries and subqueries of the workload whose tables include T; TS-Weight(T) = sum of Cost(Qi) x sizeTables(T) / sizeTablesClause(Qi); T is interesting when both reach C = workload fraction x total cost of the workload." ;
                                :hasName "MV_InterestingTableSubset" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubset
:Rule_MV_TableSubset rdf:type owl:NamedIndividual ,
                              :Rule ;
                     :hasDescription "Creates the TableSubset of the tables of each query and subquery (TS in Agrawal et al., 2000)." ;
                     :hasName "MV_TableSubset" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubsetSize
:Rule_MV_TableSubsetSize rdf:type owl:NamedIndividual ,
                                  :Rule ;
                         :hasDescription "sizeTables(T): sum of the page counts of the tables of each table subset." ;
                         :hasName "MV_TableSubsetSize" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TupleSize
:Rule_MV_TupleSize rdf:type owl:NamedIndividual ,
                            :Rule ;
                   :hasDescription "SizeRowVM: sum of the maximum sizes of the columns of the view, plus the aggregate column size for each aggregate." ;
                   :hasName "MV_TupleSize" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Classification
:Rule_Predicate_Classification rdf:type owl:NamedIndividual ,
                                        :Rule ;
                               :hasDescription "Types each predicate: with an operator symbol -> AtomicExpression, with a connector word -> CompositeExpression." ;
                               :hasName "Predicate_Classification" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Operands
:Rule_Predicate_Operands rdf:type owl:NamedIndividual ,
                                  :Rule ;
                         :hasDescription "Links the left and right operands of each atomic expression to the columns of its WHERE clause." ;
                         :hasName "Predicate_Operands" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_AccumulatedBonus
:Rule_RealIndex_AccumulatedBonus rdf:type owl:NamedIndividual ,
                                          :Rule ;
                                 :hasDescription "Accumulated bonus of each real index = initial accumulated bonus + its records after the creation or the last rebuild (Morelli, section 3.2)." ;
                                 :hasName "RealIndex_AccumulatedBonus" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Creation
:Rule_RealIndex_Creation rdf:type owl:NamedIndividual ,
                                  :Rule ;
                         :generatesAction :Action_CreateRealIndex ;
                         :hasDescription "When the accumulated benefit of a hypothetical index exceeds its estimated creation cost, creates the real index (Index, linked by becomes) with bonus = accumulated benefit / executions that used it and initial accumulated bonus = accumulated benefit (Morelli, section 3.2), the CreateIndexStatement that creates it and an Action with the justification for the DBA." ;
                         :hasName "RealIndex_Creation" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Lifecycle
:Rule_RealIndex_Lifecycle rdf:type owl:NamedIndividual ,
                                   :Rule ;
                          :hasDescription "Creation, last rebuild and removal timestamps and status (dbaDecision, created, removed) of each real index, from the actions the dispatcher executed." ;
                          :hasName "RealIndex_Lifecycle" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Removal
:Rule_RealIndex_Removal rdf:type owl:NamedIndividual ,
                                 :Rule ;
                        :generatesAction :Action_DropRealIndex ;
                        :hasDescription "When the accumulated bonus of an existing real index falls below its elimination cost (-CCI) and no rebuild is pending, creates the DropIndexStatement that removes it and an Action with the justification for the DBA (Morelli, sections 3.3 and 3.4)." ;
                        :hasName "RealIndex_Removal" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UnusedPenalty
:Rule_RealIndex_UnusedPenalty rdf:type owl:NamedIndividual ,
                                       :Rule ;
                              :hasDescription "For each execution of a statement that originated a real index whose real plan does not use it, records a RealIndexBonus of -bonus. Extension to Morelli: switch it off (isEnabled false) to decrement only on updates." ;
                              :hasName "RealIndex_UnusedPenalty" ;
                              :isEnabled "true"^^xsd:boolean .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UsageBonus
:Rule_RealIndex_UsageBonus rdf:type owl:NamedIndividual ,
                                    :Rule ;
                           :hasDescription "For each execution whose real plan uses a real index, records a RealIndexBonus of +bonus (Morelli, figure 3.4, line 9)." ;
                           :hasName "RealIndex_UsageBonus" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Rule_Table_Reference
:Rule_Table_Reference rdf:type owl:NamedIndividual ,
                               :Rule ;
                      :hasDescription "Turns each table reference of a clause into the Table with that name, creating it if missing; FROM, UPDATE and DELETE FROM clauses reference it (referencesTable), which makes it a ReferencedTable." ;
                      :hasName "Table_Reference" .


###  http://www.owl-ontologies.com/onDBTuning.owl#SQLServerSpecificClause
:SQLServerSpecificClause rdf:type owl:NamedIndividual ,
                                  <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#SQLStatement
:SQLStatement rdf:type owl:NamedIndividual ,
                       <http://purl.org/nemo/gufo#Kind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#ScanSpecification
:ScanSpecification rdf:type owl:NamedIndividual ,
                            <http://purl.org/nemo/gufo#RoleMixin> .


###  http://www.owl-ontologies.com/onDBTuning.owl#SecondaryStorageArea
:SecondaryStorageArea rdf:type owl:NamedIndividual ,
                               <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#SecondaryStorageAreaComponent
:SecondaryStorageAreaComponent rdf:type owl:NamedIndividual ,
                                        <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#SelectClause
:SelectClause rdf:type owl:NamedIndividual ,
                       <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#SetClause
:SetClause rdf:type owl:NamedIndividual ,
                    <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#SpecificationOfIndexToBeScanned
:SpecificationOfIndexToBeScanned rdf:type owl:NamedIndividual ,
                                          <http://purl.org/nemo/gufo#Role> .


###  http://www.owl-ontologies.com/onDBTuning.owl#StorageArea
:StorageArea rdf:type owl:NamedIndividual ,
                      <http://purl.org/nemo/gufo#RoleMixin> .


###  http://www.owl-ontologies.com/onDBTuning.owl#StorageAreaComponent
:StorageAreaComponent rdf:type owl:NamedIndividual ,
                               <http://purl.org/nemo/gufo#RoleMixin> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Table
:Table rdf:type owl:NamedIndividual ,
                <http://purl.org/nemo/gufo#Kind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#TableScopeClause
:TableScopeClause rdf:type owl:NamedIndividual ,
                           <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#TableSpecification
:TableSpecification rdf:type owl:NamedIndividual ,
                             <http://purl.org/nemo/gufo#SubKind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#Table_customer
:Table_customer rdf:type owl:NamedIndividual ,
                         :Table ;
                :isConstitutedOf :Column_customer_c_acctbal ,
                                 :Column_customer_c_address ,
                                 :Column_customer_c_comment ,
                                 :Column_customer_c_custkey ,
                                 :Column_customer_c_mktsegment ,
                                 :Column_customer_c_name ,
                                 :Column_customer_c_nationkey ,
                                 :Column_customer_c_phone ;
                :isDBObjectOf :Database_TPCH ;
                :hasName "customer" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Table_lineitem
:Table_lineitem rdf:type owl:NamedIndividual ,
                         :Table ;
                :isConstitutedOf :Column_lineitem_l_comment ,
                                 :Column_lineitem_l_commitdate ,
                                 :Column_lineitem_l_discount ,
                                 :Column_lineitem_l_extendedprice ,
                                 :Column_lineitem_l_linenumber ,
                                 :Column_lineitem_l_linestatus ,
                                 :Column_lineitem_l_orderkey ,
                                 :Column_lineitem_l_partkey ,
                                 :Column_lineitem_l_quantity ,
                                 :Column_lineitem_l_receiptdate ,
                                 :Column_lineitem_l_returnflag ,
                                 :Column_lineitem_l_shipdate ,
                                 :Column_lineitem_l_shipinstruct ,
                                 :Column_lineitem_l_shipmode ,
                                 :Column_lineitem_l_suppkey ,
                                 :Column_lineitem_l_tax ;
                :isDBObjectOf :Database_TPCH ;
                :hasName "lineitem" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Table_nation
:Table_nation rdf:type owl:NamedIndividual ,
                       :Table ;
              :isConstitutedOf :Column_nation_n_comment ,
                               :Column_nation_n_name ,
                               :Column_nation_n_nationkey ,
                               :Column_nation_n_regionkey ;
              :isDBObjectOf :Database_TPCH ;
              :hasName "nation" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Table_orders
:Table_orders rdf:type owl:NamedIndividual ,
                       :Table ;
              :isConstitutedOf :Column_orders_o_clerk ,
                               :Column_orders_o_comment ,
                               :Column_orders_o_custkey ,
                               :Column_orders_o_orderdate ,
                               :Column_orders_o_orderkey ,
                               :Column_orders_o_orderpriority ,
                               :Column_orders_o_orderstatus ,
                               :Column_orders_o_shippriority ,
                               :Column_orders_o_totalprice ;
              :isDBObjectOf :Database_TPCH ;
              :hasName "orders" .


###  http://www.owl-ontologies.com/onDBTuning.owl#Table_part
