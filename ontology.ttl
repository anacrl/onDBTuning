@prefix : <http://www.owl-ontologies.com/OntologiaTuning.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.owl-ontologies.com/OntologiaTuning.owl#> .

<http://www.owl-ontologies.com/OntologiaTuning.owl> rdf:type owl:Ontology ;
                                                     owl:imports <http://purl.org/nemo/gufo#> ;
                                                     rdfs:label "OntologiaOuterTuning"@pt ;
                                                     owl:versionInfo "2.0" .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.owl-ontologies.com/OntologiaTuning.owl#accesses
:accesses rdf:type owl:ObjectProperty ;
          rdfs:domain :ExecutionPlanWithAccessStructure ;
          rdfs:range :UsedAccessStructure ;
          rdfs:comment "Nome anterior: utiliza."@pt ;
          rdfs:label "access"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#allocates
:allocates rdf:type owl:ObjectProperty ;
           rdfs:domain :DataStructure ;
           rdfs:range :StorageArea ;
           rdfs:label "allocates"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#aplicadoSobre
:aplicadoSobre rdf:type owl:ObjectProperty ;
               rdfs:domain :DDLStatement ;
               rdfs:range :Table .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#becomes
:becomes rdf:type owl:ObjectProperty ;
         rdfs:domain :HypotheticalIndex ;
         rdfs:range :Index ;
         rdfs:label "becomes"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#benefits
:benefits rdf:type owl:ObjectProperty ;
          rdfs:domain :AccessStructure ;
          rdfs:range :Workload ;
          rdfs:label "benefits"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#considers
:considers rdf:type owl:ObjectProperty ;
           rdfs:domain :HypotheticalExecutionPlan ;
           rdfs:range :AccessStructure ;
           rdfs:label "considers"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#creates
:creates rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :CreateHypotheticalIndexStatement
                                     :CreateHypotheticalMaterializedViewStatement
                                     :CreateStatement
                                   )
                     ] ;
         rdfs:range :AccessStructure ;
         rdfs:label "creates"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#criadaPor
:criadaPor rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :AccessStructure ;
           rdfs:range :Heuristica .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#define
:define rdf:type owl:ObjectProperty ;
        rdfs:domain :Heuristica ;
        rdfs:range :Regra .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#defines
:defines rdf:type owl:ObjectProperty ;
         rdfs:domain :DataStructureSpecification ;
         rdfs:range :DataStructure ;
         rdfs:label "defines"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#definesClause
:definesClause rdf:type owl:ObjectProperty ;
               rdfs:domain :DBMSSpecificClause ;
               rdfs:range :Clause ;
               rdfs:label "defines (clause)"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#dependsOn
:dependsOn rdf:type owl:ObjectProperty ;
           rdfs:domain :Operation ;
           rdfs:range :Operation ;
           rdfs:label "depends on"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#derives
:derives rdf:type owl:ObjectProperty ;
         rdfs:domain :HypotheticalMaterializedView ;
         rdfs:range :MaterializedView ;
         rdfs:comment "Nome anterior: eGeradoPor (as regras SWRL já o usavam no sentido hipotética -> real)."@pt ;
         rdfs:label "derives"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:domain :MaterializedViewSpecification ;
           rdfs:range :MaterializedView ;
           rdfs:label "describes"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#determines
:determines rdf:type owl:ObjectProperty ;
            rdfs:domain :IndexSpecification ;
            rdfs:range :DataStructureSpecification ;
            rdfs:label "determines"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#eInstanciadoPor
:eInstanciadoPor rdf:type owl:ObjectProperty ;
                 rdfs:domain :Conceito ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :Funcao
                                            :Regra
                                          )
                            ] .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor
:eRealizadaPor rdf:type owl:ObjectProperty ;
               rdfs:domain :Acao ;
               rdfs:range :Funcao .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#executes
:executes rdf:type owl:ObjectProperty ;
          rdfs:domain :DBMS ;
          rdfs:range :SQLStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#executesOverDatabase
:executesOverDatabase rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain :DMLStatementExecution ;
                      rdfs:range :Database ;
                      rdfs:label "executes over a"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#formulates
:formulates rdf:type owl:ObjectProperty ;
            rdfs:domain :RewrittenQueryStatement ;
            rdfs:range :MaterializedViewSpecification ;
            rdfs:label "formulates"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#fragments
:fragments rdf:type owl:ObjectProperty ;
           rdfs:domain :DMLStatement ;
           rdfs:range :View ;
           rdfs:label "fragments"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#generates
:generates rdf:type owl:ObjectProperty ;
           rdfs:domain :Optimizer ;
           rdfs:range :DMLStatementExecutionPlan ;
           rdfs:label "generates"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#gera
:gera rdf:type owl:ObjectProperty ;
      rdfs:domain :Regra ;
      rdfs:range :Acao ;
      rdfs:comment "Agora só Regra -> Acao. Os usos índice hipotético -> real e visão hipotética -> real passaram para becomes e derives."@pt .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasClause
:hasClause rdf:type owl:ObjectProperty ;
           owl:inverseOf :isClauseOf ;
           rdfs:comment "Nome anterior: possui."@pt ;
           rdfs:label "has clause"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasComparisonOperator
:hasComparisonOperator rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasExpressionObject ,
                                          :hasToken ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain :AtomicExpression ;
                       rdfs:range :ComparisonOperator ;
                       rdfs:label "has comparison operator"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasComponentStatement
:hasComponentStatement rdf:type owl:ObjectProperty ;
                       owl:inverseOf :isComponentStatementOf ;
                       rdfs:label "has component statement"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasConditionalExpression
:hasConditionalExpression rdf:type owl:ObjectProperty ;
                          rdfs:domain :PartialIndex ;
                          rdfs:range :WhereClause ;
                          rdfs:label "has a conditional expression"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasExpressionObject
:hasExpressionObject rdf:type owl:ObjectProperty ;
                     rdfs:domain :AtomicExpression ;
                     rdfs:range :ExpressionObject ;
                     rdfs:comment "Composição {ordered} da figura 4; a ordem é dada pelas subpropriedades."@pt ;
                     rdfs:label "has expression object"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasLeftOperand
:hasLeftOperand rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasExpressionObject ;
                rdf:type owl:FunctionalProperty ;
                rdfs:range :ExpressionObject ;
                rdfs:comment "Nome anterior: temObjetoExpressao."@pt ;
                rdfs:label "has left operand"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasLogicalConnector
:hasLogicalConnector rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasToken ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :CompositeExpression ;
                     rdfs:range :LogicalConnector ;
                     rdfs:label "has logical connector"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasOperation
:hasOperation rdf:type owl:ObjectProperty ;
              owl:inverseOf :isOperationOf ;
              rdfs:comment "Nome anterior: seleciona."@pt ;
              rdfs:label "has operation"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasResponsible
:hasResponsible rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain :DMLStatementSubmission ;
                rdfs:range :DatabaseUser ;
                rdfs:label "responsible"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasRightOperand
:hasRightOperand rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasExpressionObject ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:range :ExpressionObject ;
                 rdfs:comment "Nomes anteriores: temValorPredicado (coluna) e temValorPredicadoLiteral (agora um indivíduo Literal)."@pt ;
                 rdfs:label "has right operand"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasToken
:hasToken rdf:type owl:ObjectProperty ;
          rdfs:domain :Predicate ;
          rdfs:range :Token ;
          rdfs:comment "Nome anterior: temToken."@pt ;
          rdfs:label "has token"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#impacts
:impacts rdf:type owl:ObjectProperty ;
         rdfs:domain :DMLStatementExecution ;
         rdfs:range :IndexSpecification ;
         rdfs:comment "Nome anterior: impacta."@pt ;
         rdfs:label "impacts"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#indexes
:indexes rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Index
                                     :IndexSpecification
                                   )
                     ] ;
         rdfs:range :Column ;
         rdfs:comment "Na figura, Index indexes Column. Estendido a Index Specification para que índices hipotéticos indiquem suas colunas. Nome anterior: atuaSobre."@pt ;
         rdfs:label "indexes"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#indexesTable
:indexesTable rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Index
                                          :IndexSpecification
                                        )
                          ] ;
              rdfs:range :Table ;
              rdfs:comment "Tabela do índice (não está nas figuras)."@pt ;
              rdfs:label "indexes table"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#involvesDBMS
:involvesDBMS rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
              rdf:type owl:FunctionalProperty ;
              rdfs:domain :DMLStatementExecutionPlan ;
              rdfs:range :DBMS ;
              rdfs:label "participates in (DBMS)"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#involvesDMLStatement
:involvesDMLStatement rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain :DMLStatementExecutionPlan ;
                      rdfs:range :DMLStatement ;
                      rdfs:label "participates in (DML statement)"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#involvesExecutionPlan
:involvesExecutionPlan rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain :DMLStatementExecutionPlan ;
                       rdfs:range :ExecutionPlan ;
                       rdfs:label "participates in (execution plan)"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isAdministeredBy
:isAdministeredBy rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :DDLStatementExecution
                                              :DMLStatementExecution
                                            )
                              ] ;
                  rdfs:range :DBMS ;
                  rdfs:comment "«Mediation» administers. Nome anterior: executado."@pt ;
                  rdfs:label "is administered by"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isBufferAreaOf
:isBufferAreaOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                rdfs:domain :BufferArea ;
                rdfs:range :Memory ;
                rdfs:label "is buffer area of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isClauseOf
:isClauseOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain :Clause ;
            rdfs:range :DMLStatement ;
            rdfs:label "is clause of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isComponentObjectOf
:isComponentObjectOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                     rdfs:domain :DBObject ;
                     rdfs:range :CompositeObject ;
                     rdfs:label "is component object of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isComponentStatementOf
:isComponentStatementOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                        rdfs:domain :DMLStatement ;
                        rdfs:range :CompositeStatement ;
                        rdfs:comment "Subconsulta -> comando que a contém."@pt ;
                        rdfs:label "is component statement of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isConstitutedOf
:isConstitutedOf rdf:type owl:ObjectProperty ;
                 rdfs:domain :Table ;
                 rdfs:range :Column ;
                 rdfs:comment "Nome anterior: possuiColuna."@pt ;
                 rdfs:label "constituted of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isDBObjectOf
:isDBObjectOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
              rdfs:domain :DBObject ;
              rdfs:range :Database ;
              rdfs:label "is DB object of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isDerivedFromTable
:isDerivedFromTable rdf:type owl:ObjectProperty ;
                    rdfs:domain :View ;
                    rdfs:range :Table ;
                    rdfs:label "is derived from"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isDiskBlockAreaOf
:isDiskBlockAreaOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                   rdfs:domain :DiskBlockArea ;
                   rdfs:range :Disk ;
                   rdfs:label "is disk block area of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isExecutionOf
:isExecutionOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :DDLStatementExecution
                                           :DMLStatementExecution
                                         )
                           ] ;
               rdfs:range :SQLStatement ;
               rdfs:comment "«Mediation» executes. Nome anterior: corresponde."@pt ;
               rdfs:label "is execution of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isImplementedBy
:isImplementedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :Operation ;
                 rdfs:range :Algorithm ;
                 rdfs:label "implemented by"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isMaterializationOf
:isMaterializationOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain :IndexMaterialization ;
                     rdfs:range :Index ;
                     rdfs:label "is materialization of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isMaterializedIn
:isMaterializedIn rdf:type owl:ObjectProperty ;
                  rdfs:domain :MaterializedView ;
                  rdfs:range :Table ;
                  rdfs:label "is materialized in"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isOperandOf
:isOperandOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :Predicate ;
             rdfs:range :CompositeExpression ;
             rdfs:comment "Cada Composite Expression tem exatamente dois predicados como operandos."@pt ;
             rdfs:label "is operand of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isOperationOf
:isOperationOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
               rdfs:domain :Operation ;
               rdfs:range :ExecutionPlan ;
               rdfs:label "is operation of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isOptimizerOf
:isOptimizerOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Optimizer ;
               rdfs:range :DBMS ;
               rdfs:label "is optimizer of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isPredicateOf
:isPredicateOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Predicate ;
               rdfs:range :WhereClause ;
               rdfs:comment "Nome anterior: eExpressaoLogicaDe."@pt ;
               rdfs:label "is predicate of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isStorageAreaComponentOf
:isStorageAreaComponentOf rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://purl.org/nemo/gufo#isComponentOf> ;
                          rdfs:domain :StorageAreaComponent ;
                          rdfs:range :StorageArea ;
                          rdfs:label "is storage area component of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isSubmissionOf
:isSubmissionOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://purl.org/nemo/gufo#mediates> ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain :DMLStatementSubmission ;
                rdfs:range :DMLStatement ;
                rdfs:label "participates to (submission)"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#isWorkloadMemberOf
:isWorkloadMemberOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.org/nemo/gufo#isCollectionMemberOf> ;
                    rdfs:domain :DMLStatementExecution ;
                    rdfs:range :Workload ;
                    rdfs:label "is workload member of"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#manages
:manages rdf:type owl:ObjectProperty ;
         rdfs:domain :DBMS ;
         rdfs:range :Database ;
         rdfs:label "manages"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#origina
:origina rdf:type owl:ObjectProperty ;
         rdfs:domain :DMLStatementExecution ;
         rdfs:range :AccessStructure .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#originates
:originates rdf:type owl:ObjectProperty ;
            rdfs:domain :DMLStatement ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :IndexSpecification
                                       :RewrittenQueryStatement
                                     )
                       ] ;
            owl:propertyChainAxiom ( :hasComponentStatement
                                     :originates
                                   ) ;
            rdfs:comment "Um comando composto também origina o que as suas subconsultas originam."@pt ;
            rdfs:label "originates"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#plans
:plans rdf:type owl:ObjectProperty ;
       rdfs:domain :DMLStatement ;
       rdfs:range :ExecutionPlan .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#produz
:produz rdf:type owl:ObjectProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :AccessStructure
                                    :DMLStatementExecution
                                  )
                    ] ;
        rdfs:range :ExecutionPlan .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#rebuilds
:rebuilds rdf:type owl:ObjectProperty ;
          rdfs:domain :ReindexStatement ;
          rdfs:range :Index ;
          rdfs:label "rebuilds"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#referencesColumn
:referencesColumn rdf:type owl:ObjectProperty ;
                  rdfs:domain :ColumnScopeClause ;
                  rdfs:range :ReferencedColumn ;
                  rdfs:comment "Nome anterior: referencia."@pt ;
                  rdfs:label "references column"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#referencesTable
:referencesTable rdf:type owl:ObjectProperty ;
                 rdfs:domain :TableScopeClause ;
                 rdfs:range :ReferencedTable ;
                 rdfs:label "references table"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#regards
:regards rdf:type owl:ObjectProperty ;
         rdfs:domain :RealExecutionPlan ;
         rdfs:range :RealAccessStructure ;
         rdfs:label "regards"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#removes
:removes rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :DropHypotheticalIndexStatement
                                     :DropHypotheticalMaterializedViewStatement
                                     :DropStatement
                                   )
                     ] ;
         rdfs:range :AccessStructure ;
         rdfs:label "removes"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#results
:results rdf:type owl:ObjectProperty ;
         rdfs:domain :DDLStatementExecution ;
         rdfs:range :DBObjectSpecification ;
         rdfs:label "results"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#scans
:scans rdf:type owl:ObjectProperty ;
       rdfs:domain :FullTableScan ;
       rdfs:range :ScannedTable ;
       rdfs:label "scans"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#specifies
:specifies rdf:type owl:ObjectProperty ;
           rdfs:domain :DBObjectSpecification ;
           rdfs:range :DBObject ;
           rdfs:label "specifies"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#submits
:submits rdf:type owl:ObjectProperty ;
         rdfs:domain :DatabaseUser ;
         rdfs:range :DMLStatement .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#submitsToExecution
:submitsToExecution rdf:type owl:ObjectProperty ;
                    rdfs:domain :DMLStatementSubmission ;
                    rdfs:range :DMLStatementExecution ;
                    rdfs:label "submits to execution"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#takes
:takes rdf:type owl:ObjectProperty ;
       rdfs:domain :FullIndexScan ;
       rdfs:range :SpecificationOfIndexToBeScanned ;
       rdfs:label "takes"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temChaveEstrangeira
:temChaveEstrangeira rdf:type owl:ObjectProperty ;
                     rdfs:domain :Table ;
                     rdfs:range :Column .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temChavePrimaria
:temChavePrimaria rdf:type owl:ObjectProperty ;
                  rdfs:domain :Table ;
                  rdfs:range :Column .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temParametroEntrada
:temParametroEntrada rdf:type owl:ObjectProperty ;
                     rdfs:domain :Funcao ;
                     rdfs:range :Parametro .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temParametroSaida
:temParametroSaida rdf:type owl:ObjectProperty ;
                   rdfs:domain :Funcao ;
                   rdfs:range :Parametro .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temPreCondicao
:temPreCondicao rdf:type owl:ObjectProperty ;
                rdfs:domain :Heuristica ;
                rdfs:range :Conceito .


#################################################################
#    Data properties
#################################################################

###  http://www.owl-ontologies.com/OntologiaTuning.owl#foiExecutada
:foiExecutada rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Acao ;
              rdfs:range xsd:boolean .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasHypotheticalIndexName
:hasHypotheticalIndexName rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :temNome ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain :HypotheticalIndex ;
                          rdfs:range xsd:string ;
                          rdfs:label "has hypothetical index name"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasLiteralValue
:hasLiteralValue rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Literal ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Texto SQL do valor. Nome anterior: temValorPredicadoLiteral."@pt ;
                 rdfs:label "has literal value"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#hasPredicateOrder
:hasPredicateOrder rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :AtomicExpression ;
                   rdfs:range xsd:int ;
                   rdfs:comment "Posição (1, 2, ...) da expressão atômica na cláusula WHERE, da esquerda para a direita."@pt ;
                   rdfs:label "has predicate order"@en .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temAlias
:temAlias rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temAutor
:temAutor rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Heuristica ;
          rdfs:range xsd:string .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temBiblioteca
:temBiblioteca rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Funcao ;
               rdfs:range xsd:string .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temClasse
:temClasse rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Funcao ;
           rdfs:range xsd:string .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temClassificacao
:temClassificacao rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Heuristica ;
                  rdfs:range [ rdf:type rdfs:Datatype ;
                               owl:oneOf [ rdf:type rdf:List ;
                                           rdf:first "Criação de visões materializadas" ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first "Criação de Índice" ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first "Index Creation" ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first "Index Reindexing" ;
                                                                            rdf:rest [ rdf:type rdf:List ;
                                                                                       rdf:first "Index Removal" ;
                                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                                  rdf:first "Index Suggestion" ;
                                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                                             rdf:first "Materialized View Creation" ;
                                                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                                                        rdf:first "Materialized View Selection" ;
                                                                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                                                                   rdf:first "Reindexação de Índice" ;
                                                                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                                                                              rdf:first "Remoção de Índice" ;
                                                                                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                         rdf:first "Seleção de visões materializadas" ;
                                                                                                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                                    rdf:first "Sugestão de Índice" ;
                                                                                                                                                                    rdf:rest rdf:nil
                                                                                                                                                                  ]
                                                                                                                                                       ]
                                                                                                                                            ]
                                                                                                                                 ]
                                                                                                                      ]
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ]
                             ] ;
                  rdfs:comment "Valores em inglês acrescentados: as heurísticas já usavam 'Index Creation' etc., o que deixava a ontologia inconsistente."@pt .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temCoeficienteCusto_IO_CPU
:temCoeficienteCusto_IO_CPU rdf:type owl:DatatypeProperty ;
                            rdfs:domain :DBMS ;
                            rdfs:range xsd:float .


