###  http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefitsHeuristic
:IndexBenefitsHeuristic rdf:type owl:NamedIndividual ,
                                 :Heuristic ;
                        :definesRule :Rule_IndexBenefit_Accumulated ,
                                     :Rule_IndexBenefit_CreationCost ,
                                     :Rule_IndexBenefit_ExecutionBenefit ,
                                     :Rule_IndexBenefit_Timestamp ,
                                     :Rule_IndexBenefit_UpdateCost ,
                                     :Rule_RealIndex_AccumulatedBonus ,
                                     :Rule_RealIndex_Creation ,
                                     :Rule_RealIndex_Lifecycle ,
                                     :Rule_RealIndex_Removal ,
                                     :Rule_RealIndex_UnusedPenalty ,
                                     :Rule_RealIndex_UsageBonus ;
                        :hasPrecondition :Concept_Clause ,
                                         :Concept_Column ,
                                         :Concept_DBMS ,
                                         :Concept_DMLStatement ,
                                         :Concept_DMLStatementExecution ,
                                         :Concept_DMLStatementExecutionPlan ,
                                         :Concept_HypotheticalIndex ,
                                         :Concept_Table ;
                        :hasAuthor "Morelli" ;
                        :hasClassification "Index Suggestion" ;
                        :hasName "IndexBenefitsHeuristic" ;
                        :hasVersion "1.0" ;
                        :isEnabled "true"^^xsd:boolean ;
                        rdfs:label "Index Benefits Heuristic"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#IndexMaterialization
:IndexMaterialization rdf:type owl:NamedIndividual ,
                               <http://purl.org/nemo/gufo#Kind> .


###  http://www.owl-ontologies.com/onDBTuning.owl#IndexRebuildHeuristic
:IndexRebuildHeuristic rdf:type owl:NamedIndividual ,
                                :Heuristic ;
                       :definesRule :Rule_IndexRebuild_Decision ,
                                    :Rule_IndexRebuild_FragmentationDegree ;
                       :hasAuthor "Morelli" ;
                       :hasClassification "Index Reindexing" ;
                       :hasMinimumBlockCount "800"^^xsd:int ;
                       :hasMinimumFragmentationDegree "50.0"^^xsd:float ;
                       :hasMinimumScanCount "2"^^xsd:int ;
                       :hasName "IndexRebuildHeuristic" ;
                       :hasVersion "1.0" ;
                       :isEnabled "true"^^xsd:boolean ;
                       rdfs:label "Index Rebuild Heuristic"@en .


