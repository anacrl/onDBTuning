:temSimbolo rdf:type owl:DatatypeProperty ;
            rdfs:domain :Token ;
            rdfs:range xsd:string .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temSituacao
:temSituacao rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :AccessStructure ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:oneOf [ rdf:type rdf:List ;
                                      rdf:first "coletando" ;
                                      rdf:rest [ rdf:type rdf:List ;
                                                 rdf:first "criada" ;
                                                 rdf:rest [ rdf:type rdf:List ;
                                                            rdf:first "decisaoDBA" ;
                                                            rdf:rest [ rdf:type rdf:List ;
                                                                       rdf:first "persistida" ;
                                                                       rdf:rest rdf:nil
                                                                     ]
                                                          ]
                                               ]
                                    ]
                        ] .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#temTamanhoDiscoSF
:temTamanhoDiscoSF rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :DBMS ;
                   rdfs:range xsd:int .


