###  http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewBenefitsHeuristic
:MaterializedViewBenefitsHeuristic rdf:type owl:NamedIndividual ,
                                            :Heuristic ;
                                   :definesRule :Rule_MV_AccumulatedBenefit ,
                                                :Rule_MV_Compatibility ,
                                                :Rule_MV_CreationByBenefits ,
                                                :Rule_MV_EstimatedCreationCost ,
                                                :Rule_MV_ExecutionBenefit ,
                                                :Rule_MV_FullScanCost ,
                                                :Rule_MV_HypotheticalPageCount ,
                                                :Rule_MV_TupleSize ;
                                   :hasPrecondition :Concept_Clause ,
                                                    :Concept_Column ,
                                                    :Concept_DBMS ,
                                                    :Concept_DMLStatement ,
                                                    :Concept_DMLStatementExecution ,
                                                    :Concept_DMLStatementExecutionPlan ,
                                                    :Concept_HypotheticalMaterializedView ;
                                   :hasAggregateColumnSize "8"^^xsd:int ;
                                   :hasAuthor "Andrea Weberling Carvalho" ;
                                   :hasClassification "Materialized View Creation" ;
                                   :hasName "MaterializedViewBenefitsHeuristic" ;
                                   :hasVersion "1.0" ;
                                   :isEnabled "true"^^xsd:boolean ;
                                   rdfs:label "Materialized View Benefits Heuristic"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewCandidatesHeuristic
:MaterializedViewCandidatesHeuristic rdf:type owl:NamedIndividual ,
                                              :Heuristic ;
                                     :definesRule :Rule_MV_DefineView ,
                                                  :Rule_MV_InterestingTableSubset ,
                                                  :Rule_MV_TableSubset ,
                                                  :Rule_MV_TableSubsetSize ;
                                     :hasPrecondition :Concept_Clause ,
                                                      :Concept_Column ,
                                                      :Concept_DBMS ,
                                                      :Concept_DMLStatement ,
                                                      :Concept_DMLStatementExecution ,
                                                      :Concept_DMLStatementExecutionPlan ,
                                                      :Concept_Predicate ,
                                                      :Concept_Table ;
                                     :hasAuthor "Andrea Weberling Carvalho" ;
                                     :hasClassification "Materialized View Selection" ;
                                     :hasName "MaterializedViewCandidatesHeuristic" ;
                                     :hasVersion "1.0" ;
                                     :hasWorkloadFraction "0.1"^^xsd:float ;
                                     :isEnabled "true"^^xsd:boolean ;
                                     rdfs:label "Materialized View Candidates Heuristic"@en .


###  http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewExpectationHeuristic
:MaterializedViewExpectationHeuristic rdf:type owl:NamedIndividual ,
                                               :Heuristic ;
                                      :definesRule :Rule_MV_CreationByExpectation ,
                                                   :Rule_MV_ExpectedGain ;
                                      :hasPrecondition :Concept_DBMS ,
                                                       :Concept_DMLStatementExecution ,
                                                       :Concept_DMLStatementExecutionPlan ,
                                                       :Concept_HypotheticalMaterializedView ;
                                      :hasAuthor "Rafael Pereira de Oliveira" ;
                                      :hasAvailableDiskPageCount "393216"^^xsd:int ;
                                      :hasClassification "Materialized View Creation" ;
                                      :hasMaximumCreationCost "5000000.0"^^xsd:float ;
                                      :hasMaximumQueryCost "5000000.0"^^xsd:float ;
                                      :hasMinimumProcessingPercentage "50.0"^^xsd:float ;
                                      :hasName "MaterializedViewExpectationHeuristic" ;
                                      :hasVersion "0.5" ;
                                      :isEnabled "true"^^xsd:boolean ;
                                      rdfs:label "Materialized View Expectation Heuristic"@en .


