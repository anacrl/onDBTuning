###  http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_Clausula
:Funcao_Clausula rdf:type owl:NamedIndividual ,
                          :Funcao ;
                 :temParametroEntrada :ParametroEntrada_Clausula1 ;
                 :temParametroSaida :ParametroSaida_Clausula1 ,
                                    :ParametroSaida_Clausula10 ,
                                    :ParametroSaida_Clausula11 ,
                                    :ParametroSaida_Clausula2 ,
                                    :ParametroSaida_Clausula3 ,
                                    :ParametroSaida_Clausula4 ,
                                    :ParametroSaida_Clausula5 ,
                                    :ParametroSaida_Clausula6 ,
                                    :ParametroSaida_Clausula7 ,
                                    :ParametroSaida_Clausula8 ,
                                    :ParametroSaida_Clausula9 ;
                 :temBiblioteca "bib.dispatcher.index" ;
                 :temClasse "bib.dispatcher.index.Clausula" ;
                 :temNome "fcInstanciaClausula" .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_Coluna
:Funcao_Coluna rdf:type owl:NamedIndividual ,
                        :Funcao ;
               :temParametroEntrada :ParametroEntrada_ObjetoSGBD ;
               :temParametroSaida :ParametroSaida_Coluna1 ,
                                  :ParametroSaida_Coluna2 ,
                                  :ParametroSaida_Coluna3 ,
                                  :ParametroSaida_Coluna4 ;
               :temBiblioteca "bib.dispatcher.index" ;
               :temClasse "bib.dispatcher.index.Coluna" ;
               :temNome "fcInstanciaColuna" .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_ComandoDML
:Funcao_ComandoDML rdf:type owl:NamedIndividual ,
                            :Funcao ;
                   :temParametroEntrada :ParametroEntrada_ComandoDML1 ;
                   :temParametroSaida :ParametroSaida_ComandoDML1 ,
                                      :ParametroSaida_ComandoDML2 ,
                                      :ParametroSaida_ComandoDML3 ,
                                      :ParametroSaida_ComandoDML4 ,
                                      :ParametroSaida_ComandoDML5 ,
                                      :ParametroSaida_ComandoDML6 ;
                   :temBiblioteca "bib.dispatcher.index" ;
                   :temClasse "bib.dispatcher.index.ComandoDML" ;
                   :temNome "fcInstanciaComandoDML" .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_CriarIndiceHipotetico
:Funcao_CriarIndiceHipotetico rdf:type owl:NamedIndividual ,
                                       :Funcao .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_CriarIndiceReal
:Funcao_CriarIndiceReal rdf:type owl:NamedIndividual ,
                                 :Funcao .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_ExecucaoComando
:Funcao_ExecucaoComando rdf:type owl:NamedIndividual ,
                                 :Funcao ;
                        :temParametroSaida :ParametroSaida_ExecucaoComando1 ,
