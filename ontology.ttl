#################################################################
#    Individuals
#################################################################

###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceHipotetico
:Acao_CriarIndiceHipotetico rdf:type owl:NamedIndividual ,
                                     :Acao ;
                            :eRealizadaPor :Funcao_CriarIndiceHipotetico ;
                            :temDescricao "create hypothetical index % on %(%);" ;
                            :temJustificativa "Como o índice deixou de ser benéfico para o BD (Benefício: % X Custo de criação: %), decidiu-se por removê-lo e criá-lo apenas na metabase." .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceReal
:Acao_CriarIndiceReal rdf:type owl:NamedIndividual ,
                               :Acao ;
                      :eRealizadaPor :Funcao_CriarIndiceReal ;
                      :temDescricao "create index % on %(%);" ;
                      :temJustificativa "Índice possui o benefício estimado em %, o que supera o seu custo de criação estimado em %. Comandos que geraram os benefícios: %." .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarVisaoMaterializadaReal
:Acao_CriarVisaoMaterializadaReal rdf:type owl:NamedIndividual ,
                                           :Acao ;
                                  :eRealizadaPor :Funcao_VisaoMaterializadaReal ;
                                  :foiExecutada "false"^^xsd:boolean ;
                                  :temDecisaoDBA "true"^^xsd:boolean ;
                                  :temDescricao "create materialized view %" ;
                                  :temJustificativa "A visão materializada hipotética está com benefício positivo estimado de %, o que, em módulo, supera o seu custo de criação estimado em %." .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaBeneficios
:Acao_HeuristicaVisaoMaterializadaBeneficios rdf:type owl:NamedIndividual ,
                                                      :Acao ;
                                             :eRealizadaPor :Funcao_VisaoMaterializadaReal ;
                                             :foiExecutada "false"^^xsd:boolean ;
                                             :temDecisaoDBA "true"^^xsd:boolean ;
                                             :temDescricao "HeuristicaVisaoMaterializadaBeneficios" ;
                                             :temJustificativa "Esta visão materializada possui o benefício estimado em <VisaoMaterializada.beneficioAcumulado>, o que supera o seu custo de criação estimado de <VisaoMaterializada.custoCriacao>. Comandos que geraram os benefícios:  <VisaoMaterializada.comandosBeneficiados>" .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaCandidatas
:Acao_HeuristicaVisaoMaterializadaCandidatas rdf:type owl:NamedIndividual ,
                                                      :Acao ;
                                             :eRealizadaPor :Funcao_VisaoMaterializadaHipotetica ;
                                             :foiExecutada "false"^^xsd:boolean ;
                                             :temDecisaoDBA "true"^^xsd:boolean ;
                                             :temDescricao "HeuristicaVisaoMaterializadaCandidatas" ;
                                             :temJustificativa "A consulta SQL: <Consulta>  foi reescrita para torná-la genérica e passível de uso por outras consultas com a mesma estrutura, mas parâmetros diferentes.   Como consequência, foi sugerida a visão materializada hipotética com a seguinte sintaxe:  <DLL Create View>" .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaExpectativa
:Acao_HeuristicaVisaoMaterializadaExpectativa rdf:type owl:NamedIndividual ,
                                                       :Acao ;
                                              :eRealizadaPor :Funcao_VisaoMaterializadaReal ;
                                              :foiExecutada "false"^^xsd:boolean ;
                                              :temDecisaoDBA "true"^^xsd:boolean ;
                                              :temDescricao "HeuristicaVisaoMaterializadaExpectativa" ;
                                              :temJustificativa "Esta visão materializada possui o custo estimado de execução de <VisaoMaterializada.custoEstimadoExecucao>, enquanto a consulta original possui o custo de <Consulta.custoExecucao>. Logo, a economia estimada a cada utilização da visão materializada poderá ser de <VisaoMaterializada.ganhoExecucao>" .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceHipotetico
:Acao_RemoverIndiceHipotetico rdf:type owl:NamedIndividual ,
                                       :Acao ;
                              :eRealizadaPor :Funcao_RemoverIndiceHipotetico ;
                              :temDescricao "drop hypothetical index %;" ;
                              :temJustificativa "Como o índice demonstrou ser benéfico para o BD (Benefício: % X Custo de criação: %), decidiu-se por removê-lo como hipotético e criá-lo como real, fisicamente no BD." .


###  http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceReal
:Acao_RemoverIndiceReal rdf:type owl:NamedIndividual ,
                                 :Acao ;
                        :eRealizadaPor :Funcao_RemoverIndiceReal ;
                        :temDescricao "drop index %;" ;
                        :temJustificativa "Índice está com benefício negativo estimado de %, o que, em módulo, supera o seu custo de criação estimado em %. Comandos que geraram os malefícios: %." .


