<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.owl-ontologies.com/onDBTuning.owl#"
     xml:base="http://www.owl-ontologies.com/onDBTuning.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:gufo="http://purl.org/nemo/gufo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:onDBTuning="http://www.owl-ontologies.com/onDBTuning.owl#">
    <owl:Ontology rdf:about="http://www.owl-ontologies.com/onDBTuning.owl">
        <owl:versionIRI rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl/1.0"/>
        <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
        <terms:creator>Ana Carolina Almeida</terms:creator>
        <terms:creator>Daniel Schwabe</terms:creator>
        <terms:creator>Fernanda Baião</terms:creator>
        <terms:creator>Maria Luiza Machado Campos</terms:creator>
        <terms:creator>Sérgio Lifschitz</terms:creator>
        <terms:description xml:lang="en">Ontology for automatic database tuning: workload, DBMS metadata, access structures (indexes and materialized views), tuning heuristics and their SHACL rules.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-25</terms:modified>
        <terms:title xml:lang="en">onDBTuning Ontology</terms:title>
        <vann:preferredNamespacePrefix>ot</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.owl-ontologies.com/onDBTuning.owl#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">onDBTuning Ontology</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#time -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#accesses -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#accesses">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlanWithAccessStructure"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#UsedAccessStructure"/>
        <rdfs:label xml:lang="en">access</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#allocates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#allocates">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DataStructure"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#StorageArea"/>
        <rdfs:label xml:lang="en">allocates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#becomes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#becomes">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalIndex"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Index"/>
        <rdfs:label xml:lang="en">becomes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#benefits -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#benefits">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Workload"/>
        <rdfs:label xml:lang="en">benefits</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#concernsAccessStructure -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#concernsAccessStructure">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:comment xml:lang="en">Access structure created, rebuilt or dropped by the action.</rdfs:comment>
        <rdfs:label xml:lang="en">concerns access structure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#considers -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#considers">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalDMLStatementExecutionPlan"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:label xml:lang="en">considers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#creates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#creates">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#CreateHypotheticalIndexStatement"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#CreateHypotheticalMaterializedViewStatement"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#CreateStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:label xml:lang="en">creates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#defines -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#defines">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DataStructureSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DataStructure"/>
        <rdfs:label xml:lang="en">defines</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#definesClause -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#definesClause">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMSSpecificClause"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Clause"/>
        <rdfs:label xml:lang="en">defines (clause)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#definesRule -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#definesRule">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <rdfs:comment xml:lang="en">Rules that are switched on and off together with the heuristic.</rdfs:comment>
        <rdfs:label xml:lang="en">defines rule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#dependsOn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#dependsOn">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#OperationSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#OperationSpecification"/>
        <rdfs:label xml:lang="en">depends on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#derives -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#derives">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedView"/>
        <rdfs:label xml:lang="en">derives</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#describes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#describes">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedView"/>
        <rdfs:label xml:lang="en">describes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#determines -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#determines">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#IndexSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DataStructureSpecification"/>
        <rdfs:label xml:lang="en">determines</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#executes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#executes">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#SQLStatement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#executesOverDatabase -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#executesOverDatabase">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Database"/>
        <rdfs:label xml:lang="en">executes over a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#formulates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#formulates">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#RewrittenQueryStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewSpecification"/>
        <rdfs:label xml:lang="en">formulates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#fragments -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#fragments">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#View"/>
        <rdfs:label xml:lang="en">fragments</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#generatesAction -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#generatesAction">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <rdfs:label xml:lang="en">generates action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasClause -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasClause">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#isClauseOf"/>
        <rdfs:label xml:lang="en">has clause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:comment xml:lang="en">A column that the query block uses in a way that matters for index selection (Lohman et al., in Salles 2002).</rdfs:comment>
        <rdfs:label xml:lang="en">has column use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasComparisonOperator -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasComparisonOperator">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasExpressionObject"/>
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasToken"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AtomicExpression"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ComparisonOperator"/>
        <rdfs:label xml:lang="en">has comparison operator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasComponentStatement -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasComponentStatement">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#isComponentStatementOf"/>
        <rdfs:label xml:lang="en">has component statement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasConditionalExpression -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasConditionalExpression">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#PartialIndex"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#WhereClause"/>
        <rdfs:label xml:lang="en">has a conditional expression</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasEqualityColumn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasEqualityColumn">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:comment xml:lang="en">Group EQ: column in an equality predicate with a value (column = value).</rdfs:comment>
        <rdfs:label xml:lang="en">has equality column (EQ)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasExpressionObject -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasExpressionObject">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AtomicExpression"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ExpressionObject"/>
        <rdfs:comment xml:lang="en">Ordered composition of figure 4; the order is given by the subproperties.</rdfs:comment>
        <rdfs:label xml:lang="en">has expression object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasForeignKey -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasForeignKey">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Table"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:label xml:lang="en">has foreign key</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasInputParameter -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasInputParameter">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <rdfs:label xml:lang="en">has input parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasLeftOperand -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasLeftOperand">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasExpressionObject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ExpressionObject"/>
        <rdfs:label xml:lang="en">has left operand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasLogicalConnector -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasLogicalConnector">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasToken"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#CompositeExpression"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#LogicalConnector"/>
        <rdfs:label xml:lang="en">has logical connector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasOperationSpecification -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasOperationSpecification">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#isOperationSpecificationOf"/>
        <rdfs:label xml:lang="en">has operation specification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasOrderingColumn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasOrderingColumn">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:comment xml:lang="en">Group O: column in ORDER BY, GROUP BY or in a join predicate (column = column of another table, or the same column in a self-join).</rdfs:comment>
        <rdfs:label xml:lang="en">has ordering column (O)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasOutputParameter -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasOutputParameter">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <rdfs:label xml:lang="en">has output parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasPrecondition -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasPrecondition">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Concept"/>
        <rdfs:label xml:lang="en">has precondition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasPrimaryKey -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasPrimaryKey">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Table"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:label xml:lang="en">has primary key</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasRangeColumn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasRangeColumn">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:comment xml:lang="en">Group RANGE: column in a range restriction (between, &lt;, &lt;=, &gt;, &gt;=).</rdfs:comment>
        <rdfs:label xml:lang="en">has range column (RANGE)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasReferencedColumn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasReferencedColumn">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:comment xml:lang="en">Group REF: any other column referenced by the query block (SELECT, WHERE, HAVING, GROUP BY, ORDER BY).</rdfs:comment>
        <rdfs:label xml:lang="en">has referenced column (REF)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasResponsible -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasResponsible">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementSubmission"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DatabaseUser"/>
        <rdfs:label xml:lang="en">responsible</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperand -->


