        <hasPrecondition rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Concept_Predicate"/>
        <hasPrecondition rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Concept_Table"/>
        <hasAuthor>Marcos Salles</hasAuthor>
        <hasClassification>Index Creation</hasClassification>
        <hasName>CandidateIndexesHeuristic</hasName>
        <hasVersion>1.0</hasVersion>
        <isEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isEnabled>
        <rdfs:label xml:lang="en">Candidate Indexes Heuristic</rdfs:label>
    </owl:NamedIndividual>
    


