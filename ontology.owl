        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">was executed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#wasIndexUsed -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#wasIndexUsed">
