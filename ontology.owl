    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#ReferencedColumn">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
    </owl:Class>
    


