        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Timestamp of the executed DROP INDEX action.</rdfs:comment>
        <rdfs:label xml:lang="en">was removed at</rdfs:label>
    </owl:DatatypeProperty>
    


