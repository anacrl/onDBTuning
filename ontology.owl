        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Index"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Timestamp of the last executed REINDEX action.</rdfs:comment>
        <rdfs:label xml:lang="en">was rebuilt at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#wasRemovedAt -->


