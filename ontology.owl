    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#LimitClause">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#OutputScopeClause"/>
    </owl:Class>
    


