        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#StorageArea"/>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#SecondaryStorageArea"/>
    </owl:Class>
    


