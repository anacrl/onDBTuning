    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Source"/>
        <rdfs:comment xml:lang="en">A rule of a heuristic. When a SHACL rule has the same IRI as a Rule individual, the script runs it only if a heuristic that defines it is enabled and the rule itself is not disabled (isEnabled false).</rdfs:comment>
        <rdfs:label xml:lang="en">Rule</rdfs:label>
    </owl:Class>
    


