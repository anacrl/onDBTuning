    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#CandidateIndexesHeuristic">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <definesRule rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ColumnGroups"/>
        <definesRule rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_GroupCombination"/>
