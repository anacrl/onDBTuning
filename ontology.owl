    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewSpecification">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBObjectSpecification"/>
    </owl:Class>
    


