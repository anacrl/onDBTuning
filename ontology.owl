        <hasConcept>Predicate</hasConcept>
        <hasDatatype>hasLeftOperandReference</hasDatatype>
        <hasType>string</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Predicate9 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Predicate9">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>Predicate</hasConcept>
        <hasDatatype>hasOperatorSymbol</hasDatatype>
        <hasType>string</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_RealMaterializedView1 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_RealMaterializedView1">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>MaterializedView</hasConcept>
        <hasDatatype>hasCreationDate</hasDatatype>
        <hasType>datetime</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_RealMaterializedView2 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_RealMaterializedView2">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>MaterializedView</hasConcept>
        <hasDatatype>hasStatus</hasDatatype>
        <hasType>string</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table1 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table1">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>Table</hasConcept>
        <hasDatatype>hasName</hasDatatype>
        <hasType>string</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table2 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table2">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>Table</hasConcept>
        <hasDatatype>hasTupleCount</hasDatatype>
        <hasType>int</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table3 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table3">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>Table</hasConcept>
        <hasDatatype>hasPrimaryKey</hasDatatype>
        <hasType>Column</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table4 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table4">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>Table</hasConcept>
        <hasDatatype>hasForeignKey</hasDatatype>
        <hasType>Column</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table5 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table5">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>Table</hasConcept>
        <hasDatatype>isConstitutedOf</hasDatatype>
        <hasType>Column</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table6 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputParameter_Table6">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <hasConcept>Table</hasConcept>
        <hasDatatype>hasPageCount</hasDatatype>
        <hasType>int</hasType>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#OutputScopeClause -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#OutputScopeClause">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#PartialIndex -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#PartialIndex">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Person -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Person">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#PersonDBUser -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#PersonDBUser">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#PostgreSQLSpecificClause -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#PostgreSQLSpecificClause">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Predicate -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Predicate">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageArea -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageArea">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageAreaComponent -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageAreaComponent">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#QueryStatement -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#QueryStatement">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Category"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#RealDMLStatementExecutionPlan -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RealDMLStatementExecutionPlan">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#ReferencedColumn -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#ReferencedColumn">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#ReferencedTable -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#ReferencedTable">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#ReindexStatement -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#ReindexStatement">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#RewrittenQueryStatement -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RewrittenQueryStatement">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#RownumClause -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RownumClause">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_3 -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_3">
        <hasName></hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Clause_Membership -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Clause_Membership">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Links each clause and its statement in both directions (hasClause / isClauseOf).</hasDescription>
        <hasName>Clause_Membership</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_InsertedColumns -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_InsertedColumns">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>An INSERT INTO clause without a column list references every column of its table.</hasDescription>
        <hasName>Column_InsertedColumns</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_QualifiedReference -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_QualifiedReference">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Turns each table.column reference of a clause into the Column of that table (referencesColumn, ReferencedColumn), creating the column if the table does not have it.</hasDescription>
        <hasName>Column_QualifiedReference</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_UnqualifiedReference -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_UnqualifiedReference">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Turns each column reference without table into the column with that name of the only table, among those of the FROM clauses of the statement and of the statements around it, that has it.</hasDescription>
        <hasName>Column_UnqualifiedReference</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_ComparisonOperator_Link -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_ComparisonOperator_Link">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Links each atomic expression to the ComparisonOperator with its symbol, creating the operator if the symbol is new.</hasDescription>
        <hasName>ComparisonOperator_Link</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Classification -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Classification">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Types each statement by its clauses: UpdateClause -&gt; UpdateStatement, InsertIntoClause -&gt; InsertStatement, DeleteFromClause -&gt; DeleteStatement, otherwise SelectClause -&gt; QueryStatement.</hasDescription>
        <hasName>DMLStatement_Classification</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Composition -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Composition">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Links each statement and its subqueries in both directions (hasComponentStatement / isComponentStatementOf) and types it CompositeStatement (it has subqueries) or AtomicStatement.</hasDescription>
        <hasName>DMLStatement_Composition</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ColumnGroups -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ColumnGroups">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Puts the columns of each query block in the groups of Salles (2002, section 4.5.1): EQ (equality with a value), O (ORDER BY, GROUP BY, join predicates), RANGE (between, &lt;, &lt;=, &gt;, &gt;=) and SARG (like, in).</hasDescription>
        <hasName>HypotheticalIndex_ColumnGroups</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_GroupCombination -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_GroupCombination">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex"/>
        <hasDescription>For each query block and table, suggests the hypothetical indexes EQ+O, EQ+O+RANGE, EQ+O+RANGE+SARG, EQ+O+RANGE+REF, O+EQ, O+EQ+RANGE, O+EQ+RANGE+SARG and O+EQ+RANGE+REF (two or more columns, no repeated column, columns of a group in table order), as in Salles (2002), section 4.5.1.</hasDescription>
        <hasName>HypotheticalIndex_GroupCombination</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ReferencedColumns -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ReferencedColumns">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Group REF: the other columns referenced by the query block (SELECT, WHERE, HAVING, GROUP BY, ORDER BY).</hasDescription>
        <hasName>HypotheticalIndex_ReferencedColumns</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_SingleColumn -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_SingleColumn">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex"/>
        <hasDescription>Suggests a single-column hypothetical index for each column of the groups EQ, O, RANGE and SARG.</hasDescription>
        <hasName>HypotheticalIndex_SingleColumn</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Accumulated -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Accumulated">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Accumulated benefit of each hypothetical index = sum of its records; after its real index is removed, -CCI plus the records of the later executions (Morelli, section 3.3). Usage count = executions that used it.</hasDescription>
        <hasName>IndexBenefit_Accumulated</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_CreationCost -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_CreationCost">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Creation cost of each hypothetical index (Salles, 2002, section 4.5.1): CCI = 2P + c R log2 R, P and R the pages and tuples of the table, c the I/O-CPU cost coefficient of the DBMS.</hasDescription>
        <hasName>IndexBenefit_CreationCost</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_ExecutionBenefit -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_ExecutionBenefit">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>For each DML statement execution and each hypothetical index the statement originates (while the index is not real), records a HypotheticalPlanBenefit: +(real plan total cost - hypothetical plan total cost) if the hypothetical plan uses the index, the same value negated otherwise.</hasDescription>
        <hasName>IndexBenefit_ExecutionBenefit</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Timestamp -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Timestamp">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Timestamp (hasDate + hasTime) of each DML statement execution and of each executed action, to put them in order.</hasDescription>
        <hasName>IndexBenefit_Timestamp</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_UpdateCost -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_UpdateCost">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>For each INSERT, UPDATE or DELETE execution and each index it affects (every index of the table for INSERT and DELETE, the indexes with a SET column for UPDATE), hypothetical or real, records an IndexUpdateCost of -CA, CA = 2 x ceil(r / R x P) + c x r (Salles, 2002, section 4.5.1).</hasDescription>
        <hasName>IndexBenefit_UpdateCost</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_Decision -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_Decision">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_RebuildRealIndex"/>
        <hasDescription>When a real index is about to be removed but is fragmented (GrF, blocks and scans above the thresholds of the heuristic), proposes a REINDEX with fill factor 10 - ((V + 10) div 10) instead of the DROP (Morelli, figures 4.4 and 4.13).</hasDescription>
        <hasName>IndexRebuild_Decision</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_FragmentationDegree -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_FragmentationDegree">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Fragmentation degree GrF = 100 - (Ra / Ri) x 100 and number of useful scans V of each real index (Morelli, chapter 4).</hasDescription>
        <hasName>IndexRebuild_FragmentationDegree</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Literal_Creation -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Literal_Creation">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Creates the Literal with the value on the right of an atomic expression (hasLiteralValue) and makes it the right operand.</hasDescription>
        <hasName>Literal_Creation</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_LogicalConnector_Link -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_LogicalConnector_Link">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Links each composite expression to the LogicalConnector with its word (and, or), creating it if the word is new.</hasDescription>
        <hasName>LogicalConnector_Link</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_AccumulatedBenefit -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_AccumulatedBenefit">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>HyGainACVM: sum of the MaterializedViewBenefit records of the view (figure 17, line 7).</hasDescription>
        <hasName>MV_AccumulatedBenefit</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_Compatibility -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_Compatibility">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>A basic query is compatible with a view when it has the same tables and every field it projects, filters or groups by and every aggregate it computes is in the view (Weberling, section 2.7).</hasDescription>
        <hasName>MV_Compatibility</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByBenefits -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByBenefits">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewBenefitsHeuristic"/>
        <hasDescription>When HyGainACVM &gt; CreationCostVM (figure 17, line 8), creates the real MaterializedView (derives), the CreateMaterializedViewStatement and an Action with the justification for the DBA.</hasDescription>
        <hasName>MV_CreationByBenefits</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByExpectation -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByExpectation">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewExpectationHeuristic"/>
        <hasDescription>When the view fits in the disk space left for tuning (EDR &gt; CE) and the processing share of the query is above X% (Oliveira, rule 4-2), creates a real MaterializedView (derives), the CreateMaterializedViewStatement and an Action with the justification, whatever the frequency of the query.</hasDescription>
        <hasName>MV_CreationByExpectation</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_DefineView -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_DefineView">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewCandidatesHeuristic"/>
        <hasDescription>MountVM and DefineView (Weberling, figures 14 and 15): for each basic query whose tables form an interesting subset, a hypothetical materialized view over the same tables and joins, projecting the fields, filter fields and HAVING aggregates of the query, grouped by its non-aggregated fields; the view is formulated by a RewrittenQueryStatement the query originates. The same definition is the same view (Merge, figure 16).</hasDescription>
        <hasName>MV_DefineView</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_EstimatedCreationCost -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_EstimatedCreationCost">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>CreationCostVM = Cost(ClauseVM) + 2 x HyPgVM: computing the definition and writing the pages of the view.</hasDescription>
        <hasName>MV_EstimatedCreationCost</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExecutionBenefit -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExecutionBenefit">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>For each execution and each of its queries or subqueries compatible with a view, records a MaterializedViewBenefit HyGainVM = Cost(q) - HyCost(q) (Weberling, figure 17, lines 3-5).</hasDescription>
        <hasName>MV_ExecutionBenefit</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExpectedGain -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExpectedGain">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>For each hypothetical materialized view: CRC, the real cost of the query it was defined from in its most recent execution, QPL, the pages that execution read, and (CRC - QPL) x 100 / CRC, the share of the cost that is processing (Oliveira, rule 4-4).</hasDescription>
        <hasName>MV_ExpectedGain</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_FullScanCost -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_FullScanCost">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>HyCost = HyRowVM x SizeRowVM x fill factor / page size: cost of a full scan of the view (Hose et al.).</hasDescription>
        <hasName>MV_FullScanCost</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_HypotheticalPageCount -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_HypotheticalPageCount">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>HyPgVM = HyRowVM x SizeRowVM / page size (HyRowVM from the plan of the definition of the view).</hasDescription>
        <hasName>MV_HypotheticalPageCount</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_InterestingTableSubset -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_InterestingTableSubset">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>InterestingTableSubsets (Weberling, figure 8): TS-Cost(T) = total cost of the queries and subqueries of the workload whose tables include T; TS-Weight(T) = sum of Cost(Qi) x sizeTables(T) / sizeTablesClause(Qi); T is interesting when both reach C = workload fraction x total cost of the workload.</hasDescription>
        <hasName>MV_InterestingTableSubset</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubset -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubset">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Creates the TableSubset of the tables of each query and subquery (TS in Agrawal et al., 2000).</hasDescription>
        <hasName>MV_TableSubset</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubsetSize -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubsetSize">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>sizeTables(T): sum of the page counts of the tables of each table subset.</hasDescription>
        <hasName>MV_TableSubsetSize</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TupleSize -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TupleSize">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>SizeRowVM: sum of the maximum sizes of the columns of the view, plus the aggregate column size for each aggregate.</hasDescription>
        <hasName>MV_TupleSize</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Classification -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Classification">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Types each predicate: with an operator symbol -&gt; AtomicExpression, with a connector word -&gt; CompositeExpression.</hasDescription>
        <hasName>Predicate_Classification</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Operands -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Operands">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Links the left and right operands of each atomic expression to the columns of its WHERE clause.</hasDescription>
        <hasName>Predicate_Operands</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_AccumulatedBonus -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_AccumulatedBonus">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Accumulated bonus of each real index = initial accumulated bonus + its records after the creation or the last rebuild (Morelli, section 3.2).</hasDescription>
        <hasName>RealIndex_AccumulatedBonus</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Creation -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Creation">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealIndex"/>
        <hasDescription>When the accumulated benefit of a hypothetical index exceeds its estimated creation cost, creates the real index (Index, linked by becomes) with bonus = accumulated benefit / executions that used it and initial accumulated bonus = accumulated benefit (Morelli, section 3.2), the CreateIndexStatement that creates it and an Action with the justification for the DBA.</hasDescription>
        <hasName>RealIndex_Creation</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Lifecycle -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Lifecycle">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Creation, last rebuild and removal timestamps and status (dbaDecision, created, removed) of each real index, from the actions the dispatcher executed.</hasDescription>
        <hasName>RealIndex_Lifecycle</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Removal -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Removal">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <generatesAction rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action_DropRealIndex"/>
        <hasDescription>When the accumulated bonus of an existing real index falls below its elimination cost (-CCI) and no rebuild is pending, creates the DropIndexStatement that removes it and an Action with the justification for the DBA (Morelli, sections 3.3 and 3.4).</hasDescription>
        <hasName>RealIndex_Removal</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UnusedPenalty -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UnusedPenalty">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>For each execution of a statement that originated a real index whose real plan does not use it, records a RealIndexBonus of -bonus. Extension to Morelli: switch it off (isEnabled false) to decrement only on updates.</hasDescription>
        <hasName>RealIndex_UnusedPenalty</hasName>
        <isEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isEnabled>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UsageBonus -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UsageBonus">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>For each execution whose real plan uses a real index, records a RealIndexBonus of +bonus (Morelli, figure 3.4, line 9).</hasDescription>
        <hasName>RealIndex_UsageBonus</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Rule_Table_Reference -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_Table_Reference">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <hasDescription>Turns each table reference of a clause into the Table with that name, creating it if missing; FROM, UPDATE and DELETE FROM clauses reference it (referencesTable), which makes it a ReferencedTable.</hasDescription>
        <hasName>Table_Reference</hasName>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#SQLServerSpecificClause -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#SQLServerSpecificClause">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    </owl:NamedIndividual>
    


