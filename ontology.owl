    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Literal">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ExpressionObject"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#LogicalConnector -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#LogicalConnector">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Token"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#MaterializedView -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedView">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure"/>
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#View"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewBenefit -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewBenefit">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TaskConcept"/>
        <rdfs:comment xml:lang="en">HyGainVM of one execution for one hypothetical materialized view: Cost(q) - HyCost, q the query or subquery of the execution compatible with the view (figure 17).</rdfs:comment>
        <rdfs:label xml:lang="en">Materialized View Benefit</rdfs:label>
    </owl:Class>
    


