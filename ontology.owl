        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">HypotheticalPlanBenefit: the hypothetical plan accesses the index. RealIndexBonus: the real plan accesses the index.</rdfs:comment>
        <rdfs:label xml:lang="en">was index used</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#wasRebuiltAt -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#wasRebuiltAt">
