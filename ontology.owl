    <!-- http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Category"/>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_CreateHypotheticalIndex"/>
        <hasDescription>create hypothetical index % on %(%);</hasDescription>
        <hasJustification>As the index is no longer beneficial to the database (Benefit: % x Creation cost: %), it was removed and kept only in the metabase.</hasJustification>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealIndex -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealIndex">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_CreateRealIndex"/>
        <hasDescription>create index % on %(%);</hasDescription>
        <hasJustification>The index has an estimated benefit of %, which exceeds its estimated creation cost of %. Statements that generated the benefits: %.</hasJustification>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealMaterializedView -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealMaterializedView">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_RealMaterializedView"/>
        <hasDBADecision rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasDBADecision>
        <hasDescription>create materialized view %</hasDescription>
        <hasJustification>The hypothetical materialized view has an estimated positive benefit of %, which in absolute value exceeds its estimated creation cost of %.</hasJustification>
        <wasExecuted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</wasExecuted>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_DropHypotheticalIndex -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_DropHypotheticalIndex">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_DropHypotheticalIndex"/>
        <hasDescription>drop hypothetical index %;</hasDescription>
        <hasJustification>As the index proved beneficial to the database (Benefit: % x Creation cost: %), it was removed as hypothetical and created as a real index in the database.</hasJustification>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_DropRealIndex -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_DropRealIndex">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_DropRealIndex"/>
        <hasDescription>drop index %;</hasDescription>
        <hasJustification>The index has an estimated negative benefit of %, which in absolute value exceeds its estimated creation cost of %. Statements that caused the losses: %.</hasJustification>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewBenefitsHeuristic -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewBenefitsHeuristic">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_RealMaterializedView"/>
        <hasDBADecision rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasDBADecision>
        <hasDescription>MaterializedViewBenefitsHeuristic</hasDescription>
        <hasJustification>This materialized view has an estimated benefit of &lt;MaterializedView.accumulatedBenefit&gt;, which exceeds its estimated creation cost of &lt;MaterializedView.creationCost&gt;. Statements that generated the benefits: &lt;MaterializedView.benefitedStatements&gt;</hasJustification>
        <wasExecuted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</wasExecuted>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewCandidatesHeuristic -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewCandidatesHeuristic">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_HypotheticalMaterializedView"/>
        <hasDBADecision rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasDBADecision>
        <hasDescription>MaterializedViewCandidatesHeuristic</hasDescription>
        <hasJustification>The SQL query &lt;Query&gt; was rewritten to make it generic and usable by other queries with the same structure but different parameters. As a consequence, the hypothetical materialized view with the following syntax was suggested: &lt;DDL Create View&gt;</hasJustification>
        <wasExecuted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</wasExecuted>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewExpectationHeuristic -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewExpectationHeuristic">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_RealMaterializedView"/>
        <hasDBADecision rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasDBADecision>
        <hasDescription>MaterializedViewExpectationHeuristic</hasDescription>
        <hasJustification>This materialized view has an estimated execution cost of &lt;MaterializedView.estimatedExecutionCost&gt;, while the original query costs &lt;Query.executionCost&gt;. Therefore, the estimated saving each time the materialized view is used may be &lt;MaterializedView.executionGain&gt;</hasJustification>
        <wasExecuted rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</wasExecuted>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Action_RebuildRealIndex -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_RebuildRealIndex">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_RebuildRealIndex"/>
        <hasDescription>alter index % set (fillfactor = %); reindex index %;</hasDescription>
        <hasJustification>The accumulated bonus of the index, %, is below its elimination cost, %, but the index is fragmented (GrF %) and was useful in % scans: rebuild it with fill factor % instead of dropping it.</hasJustification>
    </owl:NamedIndividual>
    


