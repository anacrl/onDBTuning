        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Predicate"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#WhereClause"/>
        <rdfs:label xml:lang="en">is predicate of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#isStorageAreaComponentOf -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#isStorageAreaComponentOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#isComponentOf"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#StorageAreaComponent"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#StorageArea"/>
        <rdfs:label xml:lang="en">is storage area component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#isSubmissionOf -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#isSubmissionOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementSubmission"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:label xml:lang="en">participates to (submission)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#isWorkloadMemberOf -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#isWorkloadMemberOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#isCollectionMemberOf"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Workload"/>
        <rdfs:label xml:lang="en">is workload member of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#manages -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#manages">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Database"/>
        <rdfs:label xml:lang="en">manages</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#originates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#originates">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexSpecification"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RewrittenQueryStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasComponentStatement"/>
            <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#originates"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="en">A composite statement also originates what its subqueries originate.</rdfs:comment>
        <rdfs:label xml:lang="en">originates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#originatesAccessStructure -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#originatesAccessStructure">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:label xml:lang="en">originates access structure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#plans -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#plans">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Optimizer"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#producesPlan -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#producesPlan">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan"/>
        <rdfs:comment xml:lang="en">An execution produces its real plan (from the DBMS) and the hypothetical plan estimated with the hypothetical access structures.</rdfs:comment>
        <rdfs:label xml:lang="en">produces plan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#rebuilds -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#rebuilds">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ReindexStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Index"/>
        <rdfs:label xml:lang="en">rebuilds</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#referencesColumn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#referencesColumn">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ColumnScopeClause"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ReferencedColumn"/>
        <rdfs:label xml:lang="en">references column</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#referencesNonAggregatedColumn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#referencesNonAggregatedColumn">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Clause"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:comment xml:lang="en">Column used by the SELECT clause outside aggregate functions (Rule_Column_GroupingReference).</rdfs:comment>
        <rdfs:label xml:lang="en">references non-aggregated column</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#referencesTable -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#referencesTable">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TableScopeClause"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ReferencedTable"/>
        <rdfs:label xml:lang="en">references table</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#regards -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#regards">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#RealDMLStatementExecutionPlan"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure"/>
        <rdfs:label xml:lang="en">regards</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#removes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#removes">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#DropHypotheticalIndexStatement"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#DropHypotheticalMaterializedViewStatement"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#DropStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:label xml:lang="en">removes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#results -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#results">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DDLStatementExecution"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBObjectSpecification"/>
        <rdfs:label xml:lang="en">results</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#scans -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#scans">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#FullTableScanSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TableSpecification"/>
        <rdfs:label xml:lang="en">scans</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#specifies -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#specifies">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBObjectSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBObject"/>
        <rdfs:label xml:lang="en">specifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#submits -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#submits">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DatabaseUser"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#submitsToExecution -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#submitsToExecution">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementSubmission"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
        <rdfs:label xml:lang="en">submits to execution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#takes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#takes">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#FullIndexScanSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#SpecificationOfIndexToBeScanned"/>
        <rdfs:label xml:lang="en">takes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBenefit -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBenefit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Accumulated benefit of a hypothetical index: sum of its records. After its real index is removed it starts again from -hasEstimatedCreationCost and counts only the executions after the removal (Morelli, section 3.3).</rdfs:comment>
        <rdfs:label xml:lang="en">has accumulated benefit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBonus -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBonus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Accumulated benefit of a real index (Morelli, section 3.2): hasInitialAccumulatedBonus + the RealIndexBonus and IndexUpdateCost records of the executions after its creation (or after its last rebuild). Below -hasEstimatedCreationCost the index is removed (or rebuilt).</rdfs:comment>
        <rdfs:label xml:lang="en">has accumulated bonus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateColumnSize -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateColumnSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Bytes assumed for each aggregate column of a view (sum, avg, count...) in SizeRowVM.</rdfs:comment>
        <rdfs:label xml:lang="en">has aggregate column size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateExpression -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateExpression">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Clause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">SQL text of an aggregate function call of a SELECT or HAVING clause (written by the parser, or by Rule_MV_DefineView for a view).</rdfs:comment>
        <rdfs:label xml:lang="en">has aggregate expression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasAlias -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasAlias">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has alias</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasAuthor -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasAuthor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has author</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasAvailableDiskPageCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasAvailableDiskPageCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">EDR (Oliveira, table 4.3): disk space left for tuning, in pages; a view is materialized only if its hypothetical pages (CE) are fewer (393216 pages of 8 KB in figure 4.11).</rdfs:comment>
        <rdfs:label xml:lang="en">has available disk page count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasBenefit -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasBenefit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewBenefit"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Signed value of the record, added to the accumulated benefit or bonus of the index.</rdfs:comment>
        <rdfs:label xml:lang="en">has benefit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasBlockCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasBlockCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Current number of pages of a real index, measured by the dispatcher in the DBMS (getsize, pgstatindex, pg_class.relpages).</rdfs:comment>
        <rdfs:label xml:lang="en">has block count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasBonus -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasBonus">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">On a real index (Morelli, section 3.2): accumulated benefit of the hypothetical index divided by the number of executions that used it, fixed when the real index is created. Added to the accumulated bonus each time a real plan uses the index.</rdfs:comment>
        <rdfs:label xml:lang="en">has bonus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasCPUCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasCPUCost">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">has CPU cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasClass -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Java class of the dispatcher.</rdfs:comment>
        <rdfs:label xml:lang="en">has class</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasClassification -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasClassification">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Index Creation</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Index Reindexing</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Index Removal</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>Index Suggestion</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>Materialized View Creation</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first>Materialized View Selection</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">has classification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasColumnReference -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasColumnReference">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Clause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Column the clause mentions: table.column when the parser knows the table (the alias is replaced by the table name), column alone otherwise.</rdfs:comment>
        <rdfs:label xml:lang="en">has column reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasColumnType -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasColumnType">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has column type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasConcept -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasConcept">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has concept</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasConnectorWord -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasConnectorWord">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Predicate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Logical connector of a composite expression, as text (and, or).</rdfs:comment>
        <rdfs:label xml:lang="en">has connector word</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasCreationDate -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasCreationDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedView"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has creation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasDBADecision -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasDBADecision">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">has DBA decision</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasDatatype -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasDatatype">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has datatype</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasDate -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of a DML statement execution, or date on which the dispatcher executed an action.</rdfs:comment>
        <rdfs:label xml:lang="en">has date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasDefinition -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasDefinition">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has definition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasDescription -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasDescription">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description or SQL text.</rdfs:comment>
        <rdfs:label xml:lang="en">has description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasDomainConstraint -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasDomainConstraint">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has domain constraint</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Cost estimated by the optimizer for a query or subquery without hypothetical structures (getExecutionCostQuery). Set by the dispatcher; for an executed statement the real plan of the execution is used instead.</rdfs:comment>
        <rdfs:label xml:lang="en">has estimated cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedCreationCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedCreationCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">CCI = 2P + c R log2 R (Salles, 2002, section 4.5.1): read the P pages of the table and write the same number of index pages, plus sorting the R tuples. In plan cost units (one page I/O = 1). Copied to the real index when it is created; -CCI is its elimination threshold.</rdfs:comment>
        <rdfs:label xml:lang="en">has estimated creation cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedScanCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedScanCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">HyCost (Weberling, section 3.1.2, after Hose et al.): cost of a full scan of the view = HyRowVM x SizeRowVM x fill factor / page size.</rdfs:comment>
        <rdfs:label xml:lang="en">has estimated scan cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedUpdateCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedUpdateCost">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">has estimated update cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasExecutionNumber -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasExecutionNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">has execution number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasExecutionProbability -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasExecutionProbability">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">has execution probability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasExpectedPageReadCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasExpectedPageReadCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">QPL used by the expectation heuristic: the pages read by that execution (hasPageReadCount), or the hypothetical pages of the view when the plan does not have them, as in the SWRL rule of Oliveira (figure 4.11).</rdfs:comment>
        <rdfs:label xml:lang="en">has expected page read count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasExpectedQueryCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasExpectedQueryCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">CRC (Oliveira, table 4.3): real execution cost of the query the view was defined from, in its most recent execution.</rdfs:comment>
        <rdfs:label xml:lang="en">has expected query cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasFillFactor -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasFillFactor">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">has fill factor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasFragmentationDegree -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasFragmentationDegree">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">GrF in Morelli, figure 4.4: 100 - (Ra / Ri) x 100, Ra = table tuples / index blocks now, Ri = hasInitialRatio.</rdfs:comment>
        <rdfs:label xml:lang="en">has fragmentation degree</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasGroupingColumnReference -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasGroupingColumnReference">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Clause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Column the SELECT clause uses outside aggregate functions (written by the parser).</rdfs:comment>
        <rdfs:label xml:lang="en">has grouping column reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasHypotheticalIndexName -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasHypotheticalIndexName">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#hasName"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalIndex"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has hypothetical index name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasHypotheticalPageCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasHypotheticalPageCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">HyPgVM (Weberling, section 3.1.2): HyRowVM x SizeRowVM / page size, rounded up.</rdfs:comment>
        <rdfs:label xml:lang="en">has hypothetical page count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasIOCPUCostCoefficient -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasIOCPUCostCoefficient">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">c in Salles (2002), section 4.5.1: cost of processing one tuple in memory relative to the cost of one page I/O (PostgreSQL: 1%, i.e. 0.01). Used by the creation and update costs of indexes.</rdfs:comment>
        <rdfs:label xml:lang="en">has I/O-CPU cost coefficient</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasIOCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasIOCost">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">has I/O cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasInitialAccumulatedBonus -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasInitialAccumulatedBonus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Index"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Accumulated benefit of the hypothetical index when it became this real index. Starting value of hasAccumulatedBonus, again after each rebuild.</rdfs:comment>
        <rdfs:label xml:lang="en">has initial accumulated bonus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasInitialRatio -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasInitialRatio">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Ri in Morelli, chapter 4: table tuples / index blocks measured right after the creation of the real index (getsize, pgstatindex). Set by the dispatcher.</rdfs:comment>
        <rdfs:label xml:lang="en">has initial ratio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasInstantiationOrder -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasInstantiationOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">has instantiation order</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasJustification -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasJustification">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has justification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasLeftOperandReference -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasLeftOperandReference">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Predicate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Column on the left of an atomic expression (table.column or column).</rdfs:comment>
        <rdfs:label xml:lang="en">has left operand reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasLibrary -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasLibrary">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Java package of the dispatcher.</rdfs:comment>
        <rdfs:label xml:lang="en">has library</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasLiteralValue -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasLiteralValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Literal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">SQL text of the value.</rdfs:comment>
        <rdfs:label xml:lang="en">has literal value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumCreationCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumCreationCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Views with a larger estimated creation cost are not materialized by the expectation heuristic (5000000 in figure 4.11).</rdfs:comment>
        <rdfs:label xml:lang="en">has maximum creation cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumQueryCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumQueryCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Queries with a larger real cost are not considered by the expectation heuristic (5000000 in figure 4.11).</rdfs:comment>
        <rdfs:label xml:lang="en">has maximum query cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumSize -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Maximum size of the column in bytes, from its data type (DBMS manual).</rdfs:comment>
        <rdfs:label xml:lang="en">has maximum size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumBlockCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumBlockCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">dia_size: indexes with fewer blocks are not rebuilt (default 800 blocks of 8 KB).</rdfs:comment>
        <rdfs:label xml:lang="en">has minimum block count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumFragmentationDegree -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumFragmentationDegree">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">dia_ratio: minimum fragmentation degree (GrF, in %) for an index to be rebuilt (default 50).</rdfs:comment>
        <rdfs:label xml:lang="en">has minimum fragmentation degree</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumProcessingPercentage -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumProcessingPercentage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">X% of the expectation heuristic (rule 4-2): the processing share above which a view is materialized (50 in the experiments of Oliveira, section 6.4.3).</rdfs:comment>
        <rdfs:label xml:lang="en">has minimum processing percentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumScanCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMinimumScanCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">dia_scans: minimum number of useful scans for an index to be rebuilt (default 2).</rdfs:comment>
        <rdfs:label xml:lang="en">has minimum scan count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasName -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasOperatorSymbol -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasOperatorSymbol">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Predicate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Comparison operator of an atomic expression, as text (=, &lt;, between, like, not in, ...).</rdfs:comment>
        <rdfs:label xml:lang="en">has operator symbol</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasOrdinalPosition -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasOrdinalPosition">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Column"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Position of the column in its table.</rdfs:comment>
        <rdfs:label xml:lang="en">has ordinal position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasPageCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasPageCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Table"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">has page count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasPageReadCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasPageReadCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">QPL (Oliveira, table 4.3): number of disk pages read by the execution of the query (e.g. EXPLAIN (ANALYZE, BUFFERS) in PostgreSQL). Set by the dispatcher on the real plan.</rdfs:comment>
        <rdfs:label xml:lang="en">has page read count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasPageSize -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasPageSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">has page size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasPredicateOrder -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasPredicateOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AtomicExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Position (1, 2, ...) of the atomic expression in the WHERE clause, from left to right.</rdfs:comment>
        <rdfs:label xml:lang="en">has predicate order</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasProcessedTupleCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasProcessedTupleCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Number of tuples the plan processed. In the real plan of an INSERT, UPDATE or DELETE: the tuples inserted, updated or deleted (r in the update cost of Salles, 2002).</rdfs:comment>
        <rdfs:label xml:lang="en">has processed tuple count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasProcessingPercentage -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasProcessingPercentage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">(CRC - QPL) x 100 / CRC (Oliveira, rule 4-4): share of the cost of the query that is processing (CPU) and not reading pages.</rdfs:comment>
        <rdfs:label xml:lang="en">has processing percentage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasResetUpdate -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasResetUpdate">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">SPARQL 1.1 Update that removes the values the rule recomputes from scratch (costs, accumulated benefits, benefit records). The tool executes it before the rules whenever the rule is going to run, so that a new run does not count an execution twice. Kept with the SHACL implementation of the rule (rules.ttl).</rdfs:comment>
        <rdfs:label xml:lang="en">has reset update</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperandReference -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperandReference">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Predicate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Column on the right of an atomic expression, when the right operand is a column (join).</rdfs:comment>
        <rdfs:label xml:lang="en">has right operand reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperandValue -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasRightOperandValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Predicate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">SQL text of the value on the right of an atomic expression (becomes a Literal).</rdfs:comment>
        <rdfs:label xml:lang="en">has right operand value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasSFDiskSize -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasSFDiskSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">has SF disk size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasStatus -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>collecting</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>created</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>dbaDecision</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>persisted</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>removed</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Status of a real index, computed by Rule_RealIndex_Lifecycle: dbaDecision (CREATE INDEX proposed, not executed yet), created (exists in the database), removed (DROP INDEX executed).</rdfs:comment>
        <rdfs:label xml:lang="en">has status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasSymbol -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasSymbol">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Token"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has symbol</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTableReference -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTableReference">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Clause"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of a table the clause mentions, as written in the SQL (FROM, UPDATE, DELETE FROM, INSERT INTO).</rdfs:comment>
        <rdfs:label xml:lang="en">has table reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TableSubset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">TS-Cost(T): total cost of the queries and subqueries of the workload (one per execution) whose tables include T.</rdfs:comment>
        <rdfs:label xml:lang="en">has TS-Cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetSize -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TableSubset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">sizeTables(T): sum of the page counts of the tables of the subset.</rdfs:comment>
        <rdfs:label xml:lang="en">has table subset size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetWeight -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTableSubsetWeight">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TableSubset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">TS-Weight(T) = sum over those queries Qi of Cost(Qi) x sizeTables(T) / sizeTablesClause(Qi), table size = pages.</rdfs:comment>
        <rdfs:label xml:lang="en">has TS-Weight</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTime -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
        <rdfs:comment xml:lang="en">Time of a DML statement execution, or time at which the dispatcher executed an action.</rdfs:comment>
        <rdfs:label xml:lang="en">has time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTimestamp -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTimestamp">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecution"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">hasDate + hasTime (00:00:00 when there is no time), computed by Rule_IndexBenefit_Timestamp. Puts executions and executed actions in order: an execution counts for a real index only between the creation (or the last rebuild) and the removal of the index.</rdfs:comment>
        <rdfs:label xml:lang="en">has timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTotalCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTotalCost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Total cost of an execution plan, real or hypothetical.</rdfs:comment>
        <rdfs:label xml:lang="en">has total cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTupleCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTupleCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Table"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label xml:lang="en">has tuple count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasTupleSize -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasTupleSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">SizeRowVM (Weberling, section 3.1.2): maximum size in bytes of a tuple of the view, the sum of the maximum sizes of its columns.</rdfs:comment>
        <rdfs:label xml:lang="en">has tuple size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasType -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasUpdateCost -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasUpdateCost">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">has update cost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasUsageCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasUsageCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">Hypothetical index: number of counted executions whose hypothetical plan used it (divides the accumulated benefit to give the bonus). Real index: number of executions since its creation (or its last rebuild) whose real plan used it.</rdfs:comment>
        <rdfs:label xml:lang="en">has usage count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasUsefulScanCount -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasUsefulScanCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">V in Morelli, chapter 4: number of executions since the creation of the real index whose real plan used it in a scan (a range predicate on one of its columns: between, &lt;, &lt;=, &gt;, &gt;=).</rdfs:comment>
        <rdfs:label xml:lang="en">has useful scan count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasVersion -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasWorkloadFraction -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasWorkloadFraction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">C as a fraction of the total cost of the workload (0.10 in Agrawal et al. for SQL Server).</rdfs:comment>
        <rdfs:label xml:lang="en">has workload fraction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#hasWorkloadThreshold -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasWorkloadThreshold">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TableSubset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">C: hasWorkloadFraction of the heuristic x total cost of the workload.</rdfs:comment>
        <rdfs:label xml:lang="en">has workload threshold</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#isEnabled -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#isEnabled">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">On a heuristic: true, the rules it defines (definesRule) are executed; false, they are skipped. On a rule: false switches off only that rule (no value means enabled).</rdfs:comment>
        <rdfs:label xml:lang="en">is enabled</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#isInterestingTableSubset -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#isInterestingTableSubset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TableSubset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">TS-Cost &gt;= C and TS-Weight &gt;= C (InterestingTableSubsets, figure 8).</rdfs:comment>
        <rdfs:label xml:lang="en">is interesting table subset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#wasCreatedAt -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#wasCreatedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Index"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Timestamp of the executed CREATE INDEX action.</rdfs:comment>
        <rdfs:label xml:lang="en">was created at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#wasExecuted -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#wasExecuted">
