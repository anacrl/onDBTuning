    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasHypotheticalIndexName -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasHypotheticalIndexName">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#temNome"/>
