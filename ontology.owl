     -->


    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceHipotetico -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceHipotetico">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_CriarIndiceHipotetico"/>
        <temDescricao>create hypothetical index % on %(%);</temDescricao>
        <temJustificativa>Como o índice deixou de ser benéfico para o BD (Benefício: % X Custo de criação: %), decidiu-se por removê-lo e criá-lo apenas na metabase.</temJustificativa>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceReal -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceReal">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_CriarIndiceReal"/>
        <temDescricao>create index % on %(%);</temDescricao>
        <temJustificativa>Índice possui o benefício estimado em %, o que supera o seu custo de criação estimado em %. Comandos que geraram os benefícios: %.</temJustificativa>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarVisaoMaterializadaReal -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarVisaoMaterializadaReal">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaReal"/>
        <foiExecutada rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</foiExecutada>
        <temDecisaoDBA rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</temDecisaoDBA>
        <temDescricao>create materialized view %</temDescricao>
        <temJustificativa>A visão materializada hipotética está com benefício positivo estimado de %, o que, em módulo, supera o seu custo de criação estimado em %.</temJustificativa>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaBeneficios -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaBeneficios">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaReal"/>
        <foiExecutada rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</foiExecutada>
        <temDecisaoDBA rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</temDecisaoDBA>
        <temDescricao>HeuristicaVisaoMaterializadaBeneficios</temDescricao>
        <temJustificativa>Esta visão materializada possui o benefício estimado em &lt;VisaoMaterializada.beneficioAcumulado&gt;, o que supera o seu custo de criação estimado de &lt;VisaoMaterializada.custoCriacao&gt;. Comandos que geraram os benefícios:  &lt;VisaoMaterializada.comandosBeneficiados&gt;</temJustificativa>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaCandidatas -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaCandidatas">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaHipotetica"/>
        <foiExecutada rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</foiExecutada>
        <temDecisaoDBA rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</temDecisaoDBA>
        <temDescricao>HeuristicaVisaoMaterializadaCandidatas</temDescricao>
        <temJustificativa>A consulta SQL: &lt;Consulta&gt;  foi reescrita para torná-la genérica e passível de uso por outras consultas com a mesma estrutura, mas parâmetros diferentes.   Como consequência, foi sugerida a visão materializada hipotética com a seguinte sintaxe:  &lt;DLL Create View&gt;</temJustificativa>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaExpectativa -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaExpectativa">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaReal"/>
        <foiExecutada rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</foiExecutada>
        <temDecisaoDBA rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</temDecisaoDBA>
        <temDescricao>HeuristicaVisaoMaterializadaExpectativa</temDescricao>
        <temJustificativa>Esta visão materializada possui o custo estimado de execução de &lt;VisaoMaterializada.custoEstimadoExecucao&gt;, enquanto a consulta original possui o custo de &lt;Consulta.custoExecucao&gt;. Logo, a economia estimada a cada utilização da visão materializada poderá ser de &lt;VisaoMaterializada.ganhoExecucao&gt;</temJustificativa>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceHipotetico -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceHipotetico">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_RemoverIndiceHipotetico"/>
        <temDescricao>drop hypothetical index %;</temDescricao>
        <temJustificativa>Como o índice demonstrou ser benéfico para o BD (Benefício: % X Custo de criação: %), decidiu-se por removê-lo como hipotético e criá-lo como real, fisicamente no BD.</temJustificativa>
    </owl:NamedIndividual>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceReal -->


    <owl:NamedIndividual rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceReal">
        <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <eRealizadaPor rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_RemoverIndiceReal"/>
        <temDescricao>drop index %;</temDescricao>
        <temJustificativa>Índice está com benefício negativo estimado de %, o que, em módulo, supera o seu custo de criação estimado em %. Comandos que geraram os malefícios: %.</temJustificativa>
    </owl:NamedIndividual>
    


