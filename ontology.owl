        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#AtomicExpression"/>
            <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#CompositeExpression"/>
        </owl:disjointUnionOf>
