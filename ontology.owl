        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TaskConcept"/>
        <rdfs:label xml:lang="en">Heuristic</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalAccessStructure -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalAccessStructure">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalDMLStatementExecutionPlan -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalDMLStatementExecutionPlan">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalIndex -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalIndex">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalAccessStructure"/>
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#IndexSpecification"/>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalAccessStructure"/>
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewSpecification"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalPlanBenefit -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalPlanBenefit">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit"/>
        <rdfs:comment xml:lang="en">Benefit of a hypothetical index estimated from the plans of one execution of a statement that originates it: +(real plan total cost - hypothetical plan total cost) if the hypothetical plan uses the index, the same value negated otherwise. Not recorded while the index is real.</rdfs:comment>
        <rdfs:label xml:lang="en">Hypothetical Plan Benefit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#Index -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Index">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DataStructure"/>
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure"/>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedView"/>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Table"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#TaskConcept"/>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#MaterializedViewBenefit"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalPlanBenefit"/>
            <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexUpdateCost"/>
            <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RealIndexBonus"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Change that one DML statement execution makes to the accumulated benefit (hypothetical index) or to the accumulated bonus (real index) of one index. Explains the numbers to the DBA.</rdfs:comment>
        <rdfs:label xml:lang="en">Index Benefit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#IndexMaterialization -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexMaterialization">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#IndexSpecification -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexSpecification">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DBObjectSpecification"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#IndexUpdateCost -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexUpdateCost">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit"/>
        <rdfs:comment xml:lang="en">Cost of keeping an index up to date in one INSERT, UPDATE or DELETE execution (Salles, 2002, section 4.5.1; Morelli, figure 3.5): CA = 2 x ceil(r / R x P) + c x r, subtracted from hypothetical and real indexes alike.</rdfs:comment>
        <rdfs:label xml:lang="en">Index Update Cost</rdfs:label>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#InsertIntoClause -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#InsertIntoClause">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#ColumnScopeClause"/>
    </owl:Class>
    


