    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#PrimaryStorageAreaComponent">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#BufferArea"/>
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#StorageAreaComponent"/>
        <owl:disjointWith rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#SecondaryStorageAreaComponent"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#QueryStatement -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#QueryStatement">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RealAccessStructure">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#RealDMLStatementExecutionPlan -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RealDMLStatementExecutionPlan">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan"/>
    </owl:Class>
    


    <!-- http://www.owl-ontologies.com/onDBTuning.owl#RealIndexBonus -->


    <owl:Class rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#RealIndexBonus">
        <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit"/>
        <rdfs:comment xml:lang="en">Bonus of a real index for one execution, read from the real plan (from the DBMS): +hasBonus if the real plan uses the index (Morelli, figure 3.4, line 9); -hasBonus if the statement originated the index but the real plan did not use it (Rule_RealIndex_UnusedPenalty, an extension to Morelli).</rdfs:comment>
        <rdfs:label xml:lang="en">Real Index Bonus</rdfs:label>
    </owl:Class>
    


