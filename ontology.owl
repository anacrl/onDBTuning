<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.owl-ontologies.com/OntologiaTuning.owl#"
     xml:base="http://www.owl-ontologies.com/OntologiaTuning.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:gufo="http://purl.org/nemo/gufo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:OntologiaTuning="http://www.owl-ontologies.com/OntologiaTuning.owl#">
    <owl:Ontology rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl">
        <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
        <rdfs:label xml:lang="pt">OntologiaOuterTuning</rdfs:label>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#time -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#accesses -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#accesses">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#ExecutionPlanWithAccessStructure"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#UsedAccessStructure"/>
        <rdfs:comment xml:lang="pt">Nome anterior: utiliza.</rdfs:comment>
        <rdfs:label xml:lang="en">access</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#allocates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#allocates">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DataStructure"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#StorageArea"/>
        <rdfs:label xml:lang="en">allocates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#aplicadoSobre -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#aplicadoSobre">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DDLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Table"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#becomes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#becomes">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#HypotheticalIndex"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Index"/>
        <rdfs:label xml:lang="en">becomes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#benefits -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#benefits">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Workload"/>
        <rdfs:label xml:lang="en">benefits</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#considers -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#considers">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#HypotheticalExecutionPlan"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#AccessStructure"/>
        <rdfs:label xml:lang="en">considers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#creates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#creates">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#CreateHypotheticalIndexStatement"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#CreateHypotheticalMaterializedViewStatement"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#CreateStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#AccessStructure"/>
        <rdfs:label xml:lang="en">creates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#criadaPor -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#criadaPor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#AccessStructure"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Heuristica"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#define -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#define">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Heuristica"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Regra"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#defines -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#defines">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DataStructureSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DataStructure"/>
        <rdfs:label xml:lang="en">defines</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#definesClause -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#definesClause">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DBMSSpecificClause"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Clause"/>
        <rdfs:label xml:lang="en">defines (clause)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#dependsOn -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#dependsOn">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Operation"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Operation"/>
        <rdfs:label xml:lang="en">depends on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#derives -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#derives">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#HypotheticalMaterializedView"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#MaterializedView"/>
        <rdfs:comment xml:lang="pt">Nome anterior: eGeradoPor (as regras SWRL já o usavam no sentido hipotética -&gt; real).</rdfs:comment>
        <rdfs:label xml:lang="en">derives</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#describes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#describes">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#MaterializedViewSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#MaterializedView"/>
        <rdfs:label xml:lang="en">describes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#determines -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#determines">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#IndexSpecification"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DataStructureSpecification"/>
        <rdfs:label xml:lang="en">determines</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#eInstanciadoPor -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#eInstanciadoPor">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Conceito"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Regra"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#executes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#executes">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DBMS"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#SQLStatement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#executesOverDatabase -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#executesOverDatabase">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementExecution"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Database"/>
        <rdfs:label xml:lang="en">executes over a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#formulates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#formulates">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#RewrittenQueryStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#MaterializedViewSpecification"/>
        <rdfs:label xml:lang="en">formulates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#fragments -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#fragments">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatement"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#View"/>
        <rdfs:label xml:lang="en">fragments</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#generates -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#generates">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Optimizer"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementExecutionPlan"/>
        <rdfs:label xml:lang="en">generates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#gera -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#gera">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Regra"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"/>
        <rdfs:comment xml:lang="pt">Agora só Regra -&gt; Acao. Os usos índice hipotético -&gt; real e visão hipotética -&gt; real passaram para becomes e derives.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasClause -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasClause">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#isClauseOf"/>
        <rdfs:comment xml:lang="pt">Nome anterior: possui.</rdfs:comment>
        <rdfs:label xml:lang="en">has clause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasComparisonOperator -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasComparisonOperator">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#hasExpressionObject"/>
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#hasToken"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#AtomicExpression"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#ComparisonOperator"/>
        <rdfs:label xml:lang="en">has comparison operator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasComponentStatement -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasComponentStatement">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#isComponentStatementOf"/>
        <rdfs:label xml:lang="en">has component statement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasConditionalExpression -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasConditionalExpression">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#PartialIndex"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#WhereClause"/>
        <rdfs:label xml:lang="en">has a conditional expression</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasExpressionObject -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasExpressionObject">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#AtomicExpression"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#ExpressionObject"/>
        <rdfs:comment xml:lang="pt">Composição {ordered} da figura 4; a ordem é dada pelas subpropriedades.</rdfs:comment>
        <rdfs:label xml:lang="en">has expression object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasLeftOperand -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasLeftOperand">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#hasExpressionObject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#ExpressionObject"/>
        <rdfs:comment xml:lang="pt">Nome anterior: temObjetoExpressao.</rdfs:comment>
        <rdfs:label xml:lang="en">has left operand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasLogicalConnector -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasLogicalConnector">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#hasToken"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#CompositeExpression"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#LogicalConnector"/>
        <rdfs:label xml:lang="en">has logical connector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasOperation -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasOperation">
        <owl:inverseOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#isOperationOf"/>
        <rdfs:comment xml:lang="pt">Nome anterior: seleciona.</rdfs:comment>
        <rdfs:label xml:lang="en">has operation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasResponsible -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasResponsible">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementSubmission"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DatabaseUser"/>
        <rdfs:label xml:lang="en">responsible</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasRightOperand -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasRightOperand">
        <rdfs:subPropertyOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#hasExpressionObject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#ExpressionObject"/>
        <rdfs:comment xml:lang="pt">Nomes anteriores: temValorPredicado (coluna) e temValorPredicadoLiteral (agora um indivíduo Literal).</rdfs:comment>
        <rdfs:label xml:lang="en">has right operand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasToken -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasToken">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Predicate"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Token"/>
        <rdfs:comment xml:lang="pt">Nome anterior: temToken.</rdfs:comment>
        <rdfs:label xml:lang="en">has token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#impacts -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#impacts">
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementExecution"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#IndexSpecification"/>
        <rdfs:comment xml:lang="pt">Nome anterior: impacta.</rdfs:comment>
        <rdfs:label xml:lang="en">impacts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#indexes -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#indexes">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Index"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#IndexSpecification"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Column"/>
        <rdfs:comment xml:lang="pt">Na figura, Index indexes Column. Estendido a Index Specification para que índices hipotéticos indiquem suas colunas. Nome anterior: atuaSobre.</rdfs:comment>
        <rdfs:label xml:lang="en">indexes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#indexesTable -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#indexesTable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Index"/>
                    <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#IndexSpecification"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Table"/>
        <rdfs:comment xml:lang="pt">Tabela do índice (não está nas figuras).</rdfs:comment>
        <rdfs:label xml:lang="en">indexes table</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#involvesDBMS -->


    <owl:ObjectProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#involvesDBMS">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatementExecutionPlan"/>
        <rdfs:range rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#DBMS"/>
        <rdfs:label xml:lang="en">participates in (DBMS)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#involvesDMLStatement -->


