        <rdfs:domain rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#HypotheticalIndex"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has hypothetical index name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.owl-ontologies.com/OntologiaTuning.owl#hasLiteralValue -->


    <owl:DatatypeProperty rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#hasLiteralValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
