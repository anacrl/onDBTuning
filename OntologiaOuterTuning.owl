  <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#Parametro">
    <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#OntologiaTarefa"/>
