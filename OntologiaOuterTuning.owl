  <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#ParametroSaida_SGBD4">
    <temDatatype>temCoeficienteCusto_IO_CPU</temDatatype>
    <temTipo>float</temTipo>
    <temConceito>DBMS</temConceito>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#Parametro"/>
