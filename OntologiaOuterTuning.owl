  <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatement_TPCH_Q13_CustomerDistribution">
    <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#QueryStatement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <temDescricao>select c_count, count(*) as custdist from (select c_custkey, count(o_orderkey) as c_count from customer left outer join orders on c_custkey = o_custkey and o_comment not like '%special%requests%' group by c_custkey) as c_orders group by c_count order by custdist desc, c_count desc;</temDescricao>
  </rdf:Description>
