  <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatement_TPCH_Q04_OrderPriorityChecking">
    <temDescricao>select o_orderpriority, count(*) as order_count from orders where o_orderdate &gt;= date '1993-07-01' and o_orderdate &lt; date '1993-07-01' + interval '3' month and exists (select * from lineitem where l_orderkey = o_orderkey and l_commitdate &lt; l_receiptdate) group by o_orderpriority order by o_orderpriority;</temDescricao>
