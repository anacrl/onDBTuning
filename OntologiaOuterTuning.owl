  <rdf:Description rdf:about="http://www.owl-ontologies.com/OntologiaTuning.owl#DMLStatement_TPCH_Q14_PromotionEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.owl-ontologies.com/OntologiaTuning.owl#QueryStatement"/>
    <temDescricao>select 100.00 * sum(case when p_type like 'PROMO%' then l_extendedprice * (1 - l_discount) else 0 end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue from lineitem, part where l_partkey = p_partkey and l_shipdate &gt;= date '1995-09-01' and l_shipdate &lt; date '1995-09-01' + interval '1' month;</temDescricao>
  </rdf:Description>
