}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A rule of a heuristic. When a SHACL rule has the same IRI as a Rule individual, the script runs it only if a heuristic that defines it is enabled and the rule itself is not disabled (isEnabled false)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Rule"
  } ],
