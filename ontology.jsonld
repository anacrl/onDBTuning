  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_RebuildRealIndex",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "alter index % set (fillfactor = %); reindex index %;"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "The accumulated bonus of the index, %, is below its elimination cost, %, but the index is fragmented (GrF %) and was useful in % scans: rebuild it with fill factor % instead of dropping it."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_RebuildRealIndex"
  } ],
