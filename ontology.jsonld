}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBenefit",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Accumulated benefit of a hypothetical index: sum of its records. After its real index is removed it starts again from -hasEstimatedCreationCost and counts only the executions after the removal (Morelli, section 3.3)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has accumulated benefit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasAccumulatedBonus",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Accumulated benefit of a real index (Morelli, section 3.2): hasInitialAccumulatedBonus + the RealIndexBonus and IndexUpdateCost records of the executions after its creation (or after its last rebuild). Below -hasEstimatedCreationCost the index is removed (or rebuilt)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has accumulated bonus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateColumnSize",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Bytes assumed for each aggregate column of a view (sum, avg, count...) in SizeRowVM."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has aggregate column size"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#int"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasAggregateExpression",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SQL text of an aggregate function call of a SELECT or HAVING clause (written by the parser, or by Rule_MV_DefineView for a view)."
  } ],
