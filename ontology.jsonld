    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Source"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : ""
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Clause_Membership",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Links each clause and its statement in both directions (hasClause / isClauseOf)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Clause_Membership"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_InsertedColumns",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "An INSERT INTO clause without a column list references every column of its table."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Column_InsertedColumns"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_QualifiedReference",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Turns each table.column reference of a clause into the Column of that table (referencesColumn, ReferencedColumn), creating the column if the table does not have it."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Column_QualifiedReference"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Column_UnqualifiedReference",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Turns each column reference without table into the column with that name of the only table, among those of the FROM clauses of the statement and of the statements around it, that has it."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Column_UnqualifiedReference"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_ComparisonOperator_Link",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Links each atomic expression to the ComparisonOperator with its symbol, creating the operator if the symbol is new."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "ComparisonOperator_Link"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Classification",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Types each statement by its clauses: UpdateClause -> UpdateStatement, InsertIntoClause -> InsertStatement, DeleteFromClause -> DeleteStatement, otherwise SelectClause -> QueryStatement."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "DMLStatement_Classification"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_DMLStatement_Composition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Links each statement and its subqueries in both directions (hasComponentStatement / isComponentStatementOf) and types it CompositeStatement (it has subqueries) or AtomicStatement."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "DMLStatement_Composition"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ColumnGroups",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Puts the columns of each query block in the groups of Salles (2002, section 4.5.1): EQ (equality with a value), O (ORDER BY, GROUP BY, join predicates), RANGE (between, <, <=, >, >=) and SARG (like, in)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "HypotheticalIndex_ColumnGroups"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_GroupCombination",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "For each query block and table, suggests the hypothetical indexes EQ+O, EQ+O+RANGE, EQ+O+RANGE+SARG, EQ+O+RANGE+REF, O+EQ, O+EQ+RANGE, O+EQ+RANGE+SARG and O+EQ+RANGE+REF (two or more columns, no repeated column, columns of a group in table order), as in Salles (2002), section 4.5.1."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "HypotheticalIndex_GroupCombination"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_ReferencedColumns",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Group REF: the other columns referenced by the query block (SELECT, WHERE, HAVING, GROUP BY, ORDER BY)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "HypotheticalIndex_ReferencedColumns"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_HypotheticalIndex_SingleColumn",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Suggests a single-column hypothetical index for each column of the groups EQ, O, RANGE and SARG."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "HypotheticalIndex_SingleColumn"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Accumulated",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Accumulated benefit of each hypothetical index = sum of its records; after its real index is removed, -CCI plus the records of the later executions (Morelli, section 3.3). Usage count = executions that used it."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "IndexBenefit_Accumulated"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_CreationCost",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Creation cost of each hypothetical index (Salles, 2002, section 4.5.1): CCI = 2P + c R log2 R, P and R the pages and tuples of the table, c the I/O-CPU cost coefficient of the DBMS."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "IndexBenefit_CreationCost"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_ExecutionBenefit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "For each DML statement execution and each hypothetical index the statement originates (while the index is not real), records a HypotheticalPlanBenefit: +(real plan total cost - hypothetical plan total cost) if the hypothetical plan uses the index, the same value negated otherwise."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "IndexBenefit_ExecutionBenefit"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_Timestamp",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Timestamp (hasDate + hasTime) of each DML statement execution and of each executed action, to put them in order."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "IndexBenefit_Timestamp"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexBenefit_UpdateCost",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "For each INSERT, UPDATE or DELETE execution and each index it affects (every index of the table for INSERT and DELETE, the indexes with a SET column for UPDATE), hypothetical or real, records an IndexUpdateCost of -CA, CA = 2 x ceil(r / R x P) + c x r (Salles, 2002, section 4.5.1)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "IndexBenefit_UpdateCost"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_Decision",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_RebuildRealIndex"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "When a real index is about to be removed but is fragmented (GrF, blocks and scans above the thresholds of the heuristic), proposes a REINDEX with fill factor 10 - ((V + 10) div 10) instead of the DROP (Morelli, figures 4.4 and 4.13)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "IndexRebuild_Decision"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_FragmentationDegree",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Fragmentation degree GrF = 100 - (Ra / Ri) x 100 and number of useful scans V of each real index (Morelli, chapter 4)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "IndexRebuild_FragmentationDegree"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Literal_Creation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Creates the Literal with the value on the right of an atomic expression (hasLiteralValue) and makes it the right operand."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Literal_Creation"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_LogicalConnector_Link",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Links each composite expression to the LogicalConnector with its word (and, or), creating it if the word is new."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "LogicalConnector_Link"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_AccumulatedBenefit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "HyGainACVM: sum of the MaterializedViewBenefit records of the view (figure 17, line 7)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_AccumulatedBenefit"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_Compatibility",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "A basic query is compatible with a view when it has the same tables and every field it projects, filters or groups by and every aggregate it computes is in the view (Weberling, section 2.7)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_Compatibility"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByBenefits",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewBenefitsHeuristic"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "When HyGainACVM > CreationCostVM (figure 17, line 8), creates the real MaterializedView (derives), the CreateMaterializedViewStatement and an Action with the justification for the DBA."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_CreationByBenefits"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_CreationByExpectation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewExpectationHeuristic"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "When the view fits in the disk space left for tuning (EDR > CE) and the processing share of the query is above X% (Oliveira, rule 4-2), creates a real MaterializedView (derives), the CreateMaterializedViewStatement and an Action with the justification, whatever the frequency of the query."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_CreationByExpectation"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_DefineView",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewCandidatesHeuristic"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "MountVM and DefineView (Weberling, figures 14 and 15): for each basic query whose tables form an interesting subset, a hypothetical materialized view over the same tables and joins, projecting the fields, filter fields and HAVING aggregates of the query, grouped by its non-aggregated fields; the view is formulated by a RewrittenQueryStatement the query originates. The same definition is the same view (Merge, figure 16)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_DefineView"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_EstimatedCreationCost",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "CreationCostVM = Cost(ClauseVM) + 2 x HyPgVM: computing the definition and writing the pages of the view."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_EstimatedCreationCost"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExecutionBenefit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "For each execution and each of its queries or subqueries compatible with a view, records a MaterializedViewBenefit HyGainVM = Cost(q) - HyCost(q) (Weberling, figure 17, lines 3-5)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_ExecutionBenefit"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExpectedGain",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "For each hypothetical materialized view: CRC, the real cost of the query it was defined from in its most recent execution, QPL, the pages that execution read, and (CRC - QPL) x 100 / CRC, the share of the cost that is processing (Oliveira, rule 4-4)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_ExpectedGain"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_FullScanCost",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "HyCost = HyRowVM x SizeRowVM x fill factor / page size: cost of a full scan of the view (Hose et al.)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_FullScanCost"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_HypotheticalPageCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "HyPgVM = HyRowVM x SizeRowVM / page size (HyRowVM from the plan of the definition of the view)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_HypotheticalPageCount"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_InterestingTableSubset",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "InterestingTableSubsets (Weberling, figure 8): TS-Cost(T) = total cost of the queries and subqueries of the workload whose tables include T; TS-Weight(T) = sum of Cost(Qi) x sizeTables(T) / sizeTablesClause(Qi); T is interesting when both reach C = workload fraction x total cost of the workload."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_InterestingTableSubset"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubset",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Creates the TableSubset of the tables of each query and subquery (TS in Agrawal et al., 2000)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_TableSubset"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TableSubsetSize",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "sizeTables(T): sum of the page counts of the tables of each table subset."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_TableSubsetSize"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_TupleSize",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "SizeRowVM: sum of the maximum sizes of the columns of the view, plus the aggregate column size for each aggregate."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "MV_TupleSize"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Classification",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Types each predicate: with an operator symbol -> AtomicExpression, with a connector word -> CompositeExpression."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Predicate_Classification"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Predicate_Operands",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Links the left and right operands of each atomic expression to the columns of its WHERE clause."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Predicate_Operands"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_AccumulatedBonus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Accumulated bonus of each real index = initial accumulated bonus + its records after the creation or the last rebuild (Morelli, section 3.2)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "RealIndex_AccumulatedBonus"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Creation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealIndex"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "When the accumulated benefit of a hypothetical index exceeds its estimated creation cost, creates the real index (Index, linked by becomes) with bonus = accumulated benefit / executions that used it and initial accumulated bonus = accumulated benefit (Morelli, section 3.2), the CreateIndexStatement that creates it and an Action with the justification for the DBA."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "RealIndex_Creation"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Lifecycle",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Creation, last rebuild and removal timestamps and status (dbaDecision, created, removed) of each real index, from the actions the dispatcher executed."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "RealIndex_Lifecycle"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_Removal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#generatesAction" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_DropRealIndex"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "When the accumulated bonus of an existing real index falls below its elimination cost (-CCI) and no rebuild is pending, creates the DropIndexStatement that removes it and an Action with the justification for the DBA (Morelli, sections 3.3 and 3.4)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "RealIndex_Removal"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UnusedPenalty",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "For each execution of a statement that originated a real index whose real plan does not use it, records a RealIndexBonus of -bonus. Extension to Morelli: switch it off (isEnabled false) to decrement only on updates."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "RealIndex_UnusedPenalty"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isEnabled" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_RealIndex_UsageBonus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "For each execution whose real plan uses a real index, records a RealIndexBonus of +bonus (Morelli, figure 3.4, line 9)."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "RealIndex_UsageBonus"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule_Table_Reference",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "Turns each table reference of a clause into the Table with that name, creating it if missing; FROM, UPDATE and DELETE FROM clauses reference it (referencesTable), which makes it a ReferencedTable."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasName" : [ {
    "@value" : "Table_Reference"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ]
