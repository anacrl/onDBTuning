    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewCandidatesHeuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDBADecision" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "MaterializedViewCandidatesHeuristic"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "The SQL query <Query> was rewritten to make it generic and usable by other queries with the same structure but different parameters. As a consequence, the hypothetical materialized view with the following syntax was suggested: <DDL Create View>"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_HypotheticalMaterializedView"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#wasExecuted" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
