}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#IndexUpdateCost",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Cost of keeping an index up to date in one INSERT, UPDATE or DELETE execution (Salles, 2002, section 4.5.1; Morelli, figure 3.5): CA = 2 x ceil(r / R x P) + c x r, subtracted from hypothetical and real indexes alike."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
