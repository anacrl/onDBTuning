}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#RealIndexBonus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Bonus of a real index for one execution, read from the real plan (from the DBMS): +hasBonus if the real plan uses the index (Morelli, figure 3.4, line 9); -hasBonus if the statement originated the index but the real plan did not use it (Rule_RealIndex_UnusedPenalty, an extension to Morelli)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Real Index Bonus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#IndexBenefit"
  } ]
