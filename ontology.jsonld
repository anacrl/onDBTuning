    "@value" : "Group REF: any other column referenced by the query block (SELECT, WHERE, HAVING, GROUP BY, ORDER BY)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has referenced column (REF)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Column"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasColumnUse"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasResetUpdate",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SPARQL 1.1 Update that removes the values the rule recomputes from scratch (costs, accumulated benefits, benefit records). The tool executes it before the rules whenever the rule is going to run, so that a new run does not count an execution twice. Kept with the SHACL implementation of the rule (rules.ttl)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Rule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has reset update"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasResponsible",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementSubmission"
  } ],
