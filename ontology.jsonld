}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateHypotheticalIndex",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "create hypothetical index % on %(%);"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "As the index is no longer beneficial to the database (Benefit: % x Creation cost: %), it was removed and kept only in the metabase."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_CreateHypotheticalIndex"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealIndex",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "create index % on %(%);"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "The index has an estimated benefit of %, which exceeds its estimated creation cost of %. Statements that generated the benefits: %."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_CreateRealIndex"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_CreateRealMaterializedView",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDBADecision" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "create materialized view %"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "The hypothetical materialized view has an estimated positive benefit of %, which in absolute value exceeds its estimated creation cost of %."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_RealMaterializedView"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#wasExecuted" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_DropHypotheticalIndex",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "drop hypothetical index %;"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "As the index proved beneficial to the database (Benefit: % x Creation cost: %), it was removed as hypothetical and created as a real index in the database."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_DropHypotheticalIndex"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_DropRealIndex",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "drop index %;"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "The index has an estimated negative benefit of %, which in absolute value exceeds its estimated creation cost of %. Statements that caused the losses: %."
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_DropRealIndex"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewBenefitsHeuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDBADecision" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "MaterializedViewBenefitsHeuristic"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "This materialized view has an estimated benefit of <MaterializedView.accumulatedBenefit>, which exceeds its estimated creation cost of <MaterializedView.creationCost>. Statements that generated the benefits: <MaterializedView.benefitedStatements>"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_RealMaterializedView"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#wasExecuted" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
