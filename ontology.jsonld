  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#OntologiaTarefa"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceHipotetico",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_CriarIndiceHipotetico"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "create hypothetical index % on %(%);"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "Como o índice deixou de ser benéfico para o BD (Benefício: % X Custo de criação: %), decidiu-se por removê-lo e criá-lo apenas na metabase."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarIndiceReal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_CriarIndiceReal"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "create index % on %(%);"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "Índice possui o benefício estimado em %, o que supera o seu custo de criação estimado em %. Comandos que geraram os benefícios: %."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_CriarVisaoMaterializadaReal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaReal"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#foiExecutada" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDecisaoDBA" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "create materialized view %"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "A visão materializada hipotética está com benefício positivo estimado de %, o que, em módulo, supera o seu custo de criação estimado em %."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaBeneficios",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaReal"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#foiExecutada" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDecisaoDBA" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "HeuristicaVisaoMaterializadaBeneficios"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "Esta visão materializada possui o benefício estimado em <VisaoMaterializada.beneficioAcumulado>, o que supera o seu custo de criação estimado de <VisaoMaterializada.custoCriacao>. Comandos que geraram os benefícios:  <VisaoMaterializada.comandosBeneficiados>"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaCandidatas",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaHipotetica"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#foiExecutada" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDecisaoDBA" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "HeuristicaVisaoMaterializadaCandidatas"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "A consulta SQL: <Consulta>  foi reescrita para torná-la genérica e passível de uso por outras consultas com a mesma estrutura, mas parâmetros diferentes.   Como consequência, foi sugerida a visão materializada hipotética com a seguinte sintaxe:  <DLL Create View>"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_HeuristicaVisaoMaterializadaExpectativa",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_VisaoMaterializadaReal"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#foiExecutada" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "false"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDecisaoDBA" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "HeuristicaVisaoMaterializadaExpectativa"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "Esta visão materializada possui o custo estimado de execução de <VisaoMaterializada.custoEstimadoExecucao>, enquanto a consulta original possui o custo de <Consulta.custoExecucao>. Logo, a economia estimada a cada utilização da visão materializada poderá ser de <VisaoMaterializada.ganhoExecucao>"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceHipotetico",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_RemoverIndiceHipotetico"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "drop hypothetical index %;"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "Como o índice demonstrou ser benéfico para o BD (Benefício: % X Custo de criação: %), decidiu-se por removê-lo como hipotético e criá-lo como real, fisicamente no BD."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao_RemoverIndiceReal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#eRealizadaPor" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Funcao_RemoverIndiceReal"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temDescricao" : [ {
    "@value" : "drop index %;"
  } ],
  "http://www.owl-ontologies.com/OntologiaTuning.owl#temJustificativa" : [ {
    "@value" : "Índice está com benefício negativo estimado de %, o que, em módulo, supera o seu custo de criação estimado em %. Comandos que geraram os malefícios: %."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.owl-ontologies.com/OntologiaTuning.owl#Acao"
  } ]
