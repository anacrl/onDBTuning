  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Status of a real index, computed by Rule_RealIndex_Lifecycle: dbaDecision (CREATE INDEX proposed, not executed yet), created (exists in the database), removed (DROP INDEX executed)."
  } ],
