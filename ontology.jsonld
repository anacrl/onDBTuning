}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalPlanBenefit",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Benefit of a hypothetical index estimated from the plans of one execution of a statement that originates it: +(real plan total cost - hypothetical plan total cost) if the hypothetical plan uses the index, the same value negated otherwise. Not recorded while the index is real."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hypothetical Plan Benefit"
  } ],
