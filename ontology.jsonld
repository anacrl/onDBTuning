    "@language" : "en",
    "@value" : "has primary key"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Column"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasProcessedTupleCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number of tuples the plan processed. In the real plan of an INSERT, UPDATE or DELETE: the tuples inserted, updated or deleted (r in the update cost of Salles, 2002)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#DMLStatementExecutionPlan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has processed tuple count"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#int"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasProcessingPercentage",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "(CRC - QPL) x 100 / CRC (Oliveira, rule 4-4): share of the cost of the query that is processing (CPU) and not reading pages."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#HypotheticalMaterializedView"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has processing percentage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#hasRangeColumn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Group RANGE: column in a range restriction (between, <, <=, >, >=)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#DMLStatement"
