  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Hypothetical index: number of counted executions whose hypothetical plan used it (divides the accumulated benefit to give the bonus). Real index: number of executions since its creation (or its last rebuild) whose real plan used it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
