  } ]
}, {
  "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Action_MaterializedViewExpectationHeuristic",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDBADecision" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasDescription" : [ {
    "@value" : "MaterializedViewExpectationHeuristic"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#hasJustification" : [ {
    "@value" : "This materialized view has an estimated execution cost of <MaterializedView.estimatedExecutionCost>, while the original query costs <Query.executionCost>. Therefore, the estimated saving each time the materialized view is used may be <MaterializedView.executionGain>"
  } ],
  "http://www.owl-ontologies.com/onDBTuning.owl#isPerformedBy" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Function_RealMaterializedView"
  } ],
