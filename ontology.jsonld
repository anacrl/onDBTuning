    "@language" : "en",
    "@value" : "Date of a DML statement execution, or date on which the dispatcher executed an action."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid48"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has date"
  } ],
