    "@language" : "en",
    "@value" : "Column on the right of an atomic expression, when the right operand is a column (join)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.owl-ontologies.com/onDBTuning.owl#Predicate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has right operand reference"
  } ],
