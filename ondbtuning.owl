  <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasEstimatedCreationCost">
    <rdfs:label xml:lang="en">has estimated creation cost</rdfs:label>
    <rdfs:domain rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#AccessStructure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment xml:lang="en">CCI = 2P + c R log2 R (Salles, 2002, section 4.5.1): read the P pages of the table and write the same number of index pages, plus sorting the R tuples. In plan cost units (one page I/O = 1). Copied to the real index when it is created; -CCI is its elimination threshold.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
