  <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#IndexRebuildHeuristic">
    <hasVersion>1.0</hasVersion>
    <definesRule rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_FragmentationDegree"/>
    <definesRule rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule_IndexRebuild_Decision"/>
    <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Heuristic"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <hasMinimumBlockCount rdf:datatype="http://www.w3.org/2001/XMLSchema#int">800</hasMinimumBlockCount>
    <rdfs:label xml:lang="en">Index Rebuild Heuristic</rdfs:label>
    <hasClassification>Index Reindexing</hasClassification>
    <hasName>IndexRebuildHeuristic</hasName>
    <hasMinimumFragmentationDegree rdf:datatype="http://www.w3.org/2001/XMLSchema#float">50.0</hasMinimumFragmentationDegree>
    <hasAuthor>Morelli</hasAuthor>
    <isEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isEnabled>
    <hasMinimumScanCount rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</hasMinimumScanCount>
  </rdf:Description>
