  <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl">
    <owl:versionInfo>1.0</owl:versionInfo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">onDBTuning Ontology</rdfs:label>
    <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    <dcterms:title xml:lang="en">onDBTuning Ontology</dcterms:title>
    <dcterms:description xml:lang="en">Ontology for automatic database tuning: workload, DBMS metadata, access structures (indexes and materialized views), tuning heuristics and their SHACL rules.</dcterms:description>
    <vann:preferredNamespacePrefix>ot</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://www.owl-ontologies.com/onDBTuning.owl#</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl/1.0"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-25</dcterms:modified>
    <dcterms:creator>Ana Carolina Almeida</dcterms:creator>
    <dcterms:creator>Fernanda Baião</dcterms:creator>
    <dcterms:creator>Maria Luiza Machado Campos</dcterms:creator>
    <dcterms:creator>Daniel Schwabe</dcterms:creator>
    <dcterms:creator>Sérgio Lifschitz</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
  </rdf:Description>
