  <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasBonus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">has bonus</rdfs:label>
    <rdfs:comment xml:lang="en">On a real index (Morelli, section 3.2): accumulated benefit of the hypothetical index divided by the number of executions that used it, fixed when the real index is created. Added to the accumulated bonus each time a real plan uses the index.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#hasMaximumCreationCost">
