  <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Rule_MV_ExpectedGain">
    <hasDescription>For each hypothetical materialized view: CRC, the real cost of the query it was defined from in its most recent execution, QPL, the pages that execution read, and (CRC - QPL) x 100 / CRC, the share of the cost that is processing (Oliveira, rule 4-4).</hasDescription>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Rule"/>
    <hasName>MV_ExpectedGain</hasName>
  </rdf:Description>
