  <rdf:Description rdf:about="http://www.owl-ontologies.com/onDBTuning.owl#Action_RebuildRealIndex">
    <hasJustification>The accumulated bonus of the index, %, is below its elimination cost, %, but the index is fragmented (GrF %) and was useful in % scans: rebuild it with fill factor % instead of dropping it.</hasJustification>
    <rdf:type rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Action"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <hasDescription>alter index % set (fillfactor = %); reindex index %;</hasDescription>
    <isPerformedBy rdf:resource="http://www.owl-ontologies.com/onDBTuning.owl#Function_RebuildRealIndex"/>
  </rdf:Description>
